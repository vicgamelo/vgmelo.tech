---
import Base from '../layouts/Base.astro';
import { ROUTES, route, type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const pt = lang === 'pt';

const L = pt
  ? {
      title: 'Agenda',
      lead: 'Marque uma conversa comigo: vaga, recrutamento ou consultoria. Você escolhe o horário e confirma pelo link que chega no seu e-mail.',
      rules:
        'Seg a sáb, 8h–10h, 12h–14h e 18h–20h (horário de Brasília), de 12 horas a 14 dias de antecedência.',
      tzNote: 'Horários no seu fuso:',
      kind: 'Tipo de conversa',
      job: 'Vaga / recrutamento',
      consulting: 'Consultoria',
      duration: 'Duração',
      minutes: 'min',
      day: 'Dia',
      time: 'Horário',
      noSlots: 'Nenhum horário livre para essa duração nos próximos dias. Tente uma duração menor ou use o contato.',
      picked: 'Horário escolhido:',
      name: 'Nome',
      email: 'Seu e-mail',
      company: 'Empresa (opcional)',
      topic: 'Assunto',
      topicHint: 'O que você quer conversar? Vaga, contexto do projeto, dúvidas.',
      submit: 'Pedir horário',
      sending: 'Enviando…',
      sent: 'Pronto! Mandei um link para {email}. Abra em até {min} minutos para confirmar; sem isso o horário é liberado.',
      error: 'Não deu para marcar agora. Tente de novo em alguns minutos ou use o contato.',
      loading: 'Carregando horários…',
      down: 'A agenda está indisponível agora. Você pode falar comigo pelo contato.',
      privacy: 'Uso seus dados só para esta conversa. Veja a',
      privacyLink: 'privacidade',
      agentTitle: 'Prefere conversar?',
      agentLead: 'Um assistente com IA ajuda a achar um horário e marcar. Ele só fala de agendamento.',
      agentPlaceholder: 'Ex.: quero 30 min sobre uma vaga na terça à tarde',
      agentSend: 'Enviar',
      agentYou: 'Você',
      agentBot: 'Assistente',
      agentOff: 'O assistente está fora do ar agora. Use o formulário ao lado.',
      agentLimit: 'Muitas mensagens em pouco tempo. Use o formulário ao lado.',
      mcpTitle: 'Para agentes (MCP)',
      mcpLead: 'Seu agente pode ler os horários livres e pedir uma conversa pelo servidor MCP público. A reserva também só vale depois do clique no e-mail.',
      contactLink: 'contato',
      morning: 'Manhã',
      afternoon: 'Tarde',
      evening: 'Noite',
      prevMonth: 'Mês anterior',
      nextMonth: 'Próximo mês',
      pickDay: 'Escolha um dia no calendário.',
      free: '{n} horários livres',
      free1: '1 horário livre',
      change: 'Trocar',
      step1: 'Escolha dia e horário',
      step2: 'Seus dados',
      online: 'IA · só agendamento',
      chatEmpty: 'Diga o que precisa, em uma frase. Exemplos:',
      sug1: '30 min sobre uma vaga amanhã de manhã',
      sug2: 'Consultoria de 1 hora na semana que vem, à noite',
      sug3: 'Quais horários livres na sexta?',
      thinking: 'Pensando…',
    }
  : {
      title: 'Book a call',
      lead: 'Book a call with me: a job opening, recruiting or consulting. Pick a time and confirm it with the link sent to your email.',
      rules: 'Mon to Sat, 8–10am, 12–2pm and 6–8pm (Brasília time), from 12 hours to 14 days ahead.',
      tzNote: 'Times in your timezone:',
      kind: 'Type of call',
      job: 'Job / recruiting',
      consulting: 'Consulting',
      duration: 'Length',
      minutes: 'min',
      day: 'Day',
      time: 'Time',
      noSlots: 'No free time for this length in the coming days. Try a shorter call or use the contact form.',
      picked: 'Selected time:',
      name: 'Name',
      email: 'Your email',
      company: 'Company (optional)',
      topic: 'Topic',
      topicHint: 'What would you like to talk about? The role, project context, questions.',
      submit: 'Request this time',
      sending: 'Sending…',
      sent: 'Done! I sent a link to {email}. Open it within {min} minutes to confirm; otherwise the slot is released.',
      error: "Couldn't book right now. Try again in a few minutes or use the contact form.",
      loading: 'Loading times…',
      down: 'The calendar is unavailable right now. You can reach me through the contact form.',
      privacy: 'I only use your data for this call. See the',
      privacyLink: 'privacy policy',
      agentTitle: 'Rather chat?',
      agentLead: 'An AI assistant helps you find a time and book it. It only talks about scheduling.',
      agentPlaceholder: 'E.g. 30 min about a job opening on Tuesday afternoon',
      agentSend: 'Send',
      agentYou: 'You',
      agentBot: 'Assistant',
      agentOff: 'The assistant is offline right now. Please use the form.',
      agentLimit: 'Too many messages in a short time. Please use the form.',
      mcpTitle: 'For agents (MCP)',
      mcpLead: 'Your agent can read free times and request a call through the public MCP server. The booking still needs the click in the email.',
      contactLink: 'contact form',
      morning: 'Morning',
      afternoon: 'Afternoon',
      evening: 'Evening',
      prevMonth: 'Previous month',
      nextMonth: 'Next month',
      pickDay: 'Pick a day on the calendar.',
      free: '{n} free times',
      free1: '1 free time',
      change: 'Change',
      step1: 'Pick a day and time',
      step2: 'Your details',
      online: 'AI · scheduling only',
      chatEmpty: 'Say what you need in one sentence. For example:',
      sug1: '30 min about a job opening tomorrow morning',
      sug2: 'A 1-hour consulting call next week, in the evening',
      sug3: 'What times are free on Friday?',
      thinking: 'Thinking…',
    };

const errors = pt
  ? {
      slot_unavailable: 'Esse horário acabou de ser ocupado. Escolha outro.',
      slot_taken: 'Esse horário acabou de ser ocupado. Escolha outro.',
      day_full: 'Esse dia já está cheio. Escolha outro dia.',
      pending_exists: 'Já existe um pedido esperando confirmação para esse e-mail. Confira sua caixa de entrada.',
      too_many_bookings: 'Esse e-mail já tem o máximo de conversas marcadas.',
      agenda_busy: 'Muitos pedidos esperando confirmação agora. Tente em alguns minutos.',
      calendar_unavailable: 'A agenda está indisponível agora. Tente mais tarde.',
      rate_limited: 'Muitas tentativas em pouco tempo. Tente mais tarde.',
      email_limit: 'Limite de e-mails de confirmação de hoje atingido. Tente amanhã.',
      invalid: 'Confira os campos: nome, e-mail válido e assunto (3+ caracteres).',
    }
  : {
      slot_unavailable: 'That time was just taken. Please pick another.',
      slot_taken: 'That time was just taken. Please pick another.',
      day_full: 'That day is full. Please pick another day.',
      pending_exists: 'There is already a request waiting for confirmation for this email. Check your inbox.',
      too_many_bookings: 'This email already has the maximum number of calls booked.',
      agenda_busy: 'Too many requests waiting for confirmation right now. Try again in a few minutes.',
      calendar_unavailable: 'The calendar is unavailable right now. Try again later.',
      rate_limited: 'Too many attempts in a short time. Please try again later.',
      email_limit: "Today's confirmation email limit was reached. Please try tomorrow.",
      invalid: 'Check the fields: name, a valid email and a topic (3+ characters).',
    };
const mcpUrl = 'https://vgmelo.tech/api/agenda/mcp';
---

<Base lang={lang} title={L.title} description={L.lead} alt={ROUTES.agenda}>
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">{pt ? 'agenda · confirmação por e-mail' : 'calendar · email confirmation'}</p>
      <h1>{L.title}</h1>
      <p>{L.lead}</p>
      <p class="muted small">{L.rules}</p>
    </header>

    <div id="agenda" data-lang={lang} data-l={JSON.stringify(L)} data-errors={JSON.stringify(errors)}>
      <section class="booker">
        <p class="notice" data-loading>{L.loading}</p>
        <p class="notice error" data-down hidden>
          {L.down} <a href={route('contact', lang)}>{L.contactLink}</a>
        </p>
        <form data-form hidden novalidate>
          <div class="bar">
            <fieldset class="seg" aria-label={L.kind}>
              <label><input type="radio" name="kind" value="job" checked /><span>{L.job}</span></label>
              <label><input type="radio" name="kind" value="consulting" /><span>{L.consulting}</span></label>
            </fieldset>
            <fieldset class="seg dur" aria-label={L.duration} data-durations></fieldset>
          </div>

          <div class="body">
            <div class="cal">
              <div class="cal-head">
                <button type="button" class="nav" data-prev aria-label={L.prevMonth}>‹</button>
                <strong data-month aria-live="polite"></strong>
                <button type="button" class="nav" data-next aria-label={L.nextMonth}>›</button>
              </div>
              <div class="grid" role="grid" data-grid></div>
              <p class="tz muted">{L.tzNote} <strong data-tz>…</strong></p>
            </div>

            <div class="slots">
              <div class="slots-head">
                <strong data-dayname>{L.pickDay}</strong>
                <span class="muted" data-count></span>
              </div>
              <div data-periods></div>
              <p class="notice" data-noslots hidden>{L.noSlots}</p>
            </div>
          </div>

          <div class="details" data-details hidden>
            <div class="summary">
              <span class="ico" aria-hidden="true">◷</span>
              <div>
                <strong data-picked></strong>
                <span class="muted" data-pickedsub></span>
              </div>
              <button type="button" class="link" data-change>{L.change}</button>
            </div>
            <div class="fields">
              <div class="field">
                <label for="a-name">{L.name}</label>
                <input id="a-name" name="name" autocomplete="name" required maxlength="100" />
              </div>
              <div class="field">
                <label for="a-email">{L.email}</label>
                <input id="a-email" name="email" type="email" autocomplete="email" required maxlength="254" />
              </div>
              <div class="field">
                <label for="a-company">{L.company}</label>
                <input id="a-company" name="company" autocomplete="organization" maxlength="100" />
              </div>
              <div class="field full">
                <label for="a-topic">{L.topic}</label>
                <textarea id="a-topic" name="topic" required minlength="3" maxlength="1000" placeholder={L.topicHint}></textarea>
              </div>
            </div>
            <div class="hp" aria-hidden="true">
              <label for="a-website">Website</label>
              <input id="a-website" name="website" tabindex="-1" autocomplete="off" />
            </div>
            <div class="send">
              <p class="muted small">{L.privacy} <a href={route('privacy', lang)}>{L.privacyLink}</a>.</p>
              <button class="btn primary" type="submit">{L.submit}</button>
            </div>
          </div>
          <p class="notice" role="status" aria-live="polite" data-status hidden></p>
        </form>
      </section>

      <div class="below">
        <aside class="chat" data-chat hidden>
          <header class="chat-head">
            <span class="avatar" aria-hidden="true">✦</span>
            <div>
              <h2>{L.agentTitle}</h2>
              <span class="muted small"><span class="dot" aria-hidden="true"></span>{L.online}</span>
            </div>
          </header>
          <p class="muted small">{L.agentLead}</p>
          <div class="empty" data-empty>
            <p class="muted small">{L.chatEmpty}</p>
            <div class="sugs">
              <button type="button" class="sug" data-sug>{L.sug1}</button>
              <button type="button" class="sug" data-sug>{L.sug2}</button>
              <button type="button" class="sug" data-sug>{L.sug3}</button>
            </div>
          </div>
          <ol class="messages" data-messages aria-live="polite"></ol>
          <form class="ask" data-ask>
            <label class="sr" for="a-ask">{L.agentPlaceholder}</label>
            <input id="a-ask" name="message" maxlength="500" placeholder={L.agentPlaceholder} autocomplete="off" required />
            <button class="send-btn" type="submit" aria-label={L.agentSend}>↑</button>
          </form>
        </aside>

        <section class="mcp">
          <h2>{L.mcpTitle}</h2>
          <p class="muted small">{L.mcpLead}</p>
          <pre>claude mcp add --transport http agenda-victor {mcpUrl}</pre>
          <p class="muted small mono">horarios_livres · marcar</p>
        </section>
      </div>
    </div>
  </div>
</Base>

<script>
  import {
    addMonths,
    agendaApi,
    bookingBody,
    browserTz,
    byPeriod,
    chatBody,
    errorText,
    groupByLocalDay,
    kindFromQuery,
    localDate,
    longDayLabel,
    monthGrid,
    monthLabel,
    monthOf,
    monthsWithSlots,
    timeLabel,
    weekdayLabels,
    whenLabel,
    type AgendaConfig,
    type BookingForm,
    type ChatReply,
    type Day,
    type Kind,
    type SlotsResponse,
  } from '../lib/agenda';
  import type { Lang } from '../i18n/routes';

  const root = document.getElementById('agenda');
  if (root) {
    const lang = root.dataset.lang as Lang;
    const L = JSON.parse(root.dataset.l!) as Record<string, string>;
    const E = JSON.parse(root.dataset.errors!) as Record<string, string>;
    const tz = browserTz();
    const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    q('[data-tz]').textContent = tz.replace(/_/g, ' ');

    const form = q<HTMLFormElement>('[data-form]');
    const durSet = q<HTMLElement>('[data-durations]');
    const gridEl = q<HTMLElement>('[data-grid]');
    const monthEl = q<HTMLElement>('[data-month]');
    const prevBtn = q<HTMLButtonElement>('[data-prev]');
    const nextBtn = q<HTMLButtonElement>('[data-next]');
    const periodsEl = q<HTMLElement>('[data-periods]');
    const details = q<HTMLElement>('[data-details]');
    const status = q<HTMLElement>('[data-status]');
    const submit = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const startedAt = Date.now();
    const today = localDate(new Date().toISOString(), tz);
    const weekdays = weekdayLabels(lang);
    let config: AgendaConfig;
    let days: Day[] = [];
    let day: string | null = null;
    let start: string | null = null;
    let month = monthOf(today);

    // ?tipo=consultoria (ou vaga) vem do convite das demos: já abre com o tipo escolhido.
    const wanted = kindFromQuery(location.search);
    if (wanted) form.querySelector<HTMLInputElement>(`input[name=kind][value=${wanted}]`)!.checked = true;
    const kind = () => (form.querySelector<HTMLInputElement>('input[name=kind]:checked')?.value ?? 'job') as Kind;
    const duration = () => Number(form.querySelector<HTMLInputElement>('input[name=duration]:checked')?.value ?? 30);

    const show = (el: HTMLElement, text: string, cls: '' | 'ok' | 'error') => {
      el.hidden = false;
      el.className = `notice ${cls}`;
      el.textContent = text;
    };

    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls: string, text?: string) => {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text !== undefined) e.textContent = text;
      return e;
    };

    const pickedText = () => {
      if (!start) return;
      const end = new Date(new Date(start).getTime() + duration() * 60_000).toISOString();
      q('[data-picked]').textContent = `${whenLabel(start, tz, lang)} – ${timeLabel(end, tz, lang)}`;
      q('[data-pickedsub]').textContent = `${duration()} ${L.minutes} · ${kind() === 'job' ? L.job : L.consulting}`;
    };

    const renderTimes = () => {
      const d = days.find((x) => x.date === day);
      q('[data-dayname]').textContent = d ? longDayLabel(d.date, lang) : L.pickDay;
      q('[data-count]').textContent = d ? (d.times.length === 1 ? L.free1 : L.free.replace('{n}', String(d.times.length))) : '';
      periodsEl.replaceChildren(
        ...(d ? byPeriod(d, tz) : []).map((g) => {
          const box = el('div', 'period');
          box.append(el('span', 'plabel', L[g.period]));
          const times = el('div', 'times');
          for (const t of g.times) {
            const b = el('button', 'time', t.label);
            b.type = 'button';
            b.setAttribute('aria-pressed', String(t.iso === start));
            b.addEventListener('click', () => {
              start = t.iso;
              pickedText();
              details.hidden = false;
              status.hidden = true;
              renderTimes();
              details.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            });
            times.append(b);
          }
          box.append(times);
          return box;
        }),
      );
    };

    const renderCalendar = () => {
      const months = monthsWithSlots(days);
      const free = new Map(days.map((d) => [d.date, d.times.length]));
      monthEl.textContent = monthLabel(month, lang);
      prevBtn.disabled = !months.length || month <= months[0];
      nextBtn.disabled = !months.length || month >= months[months.length - 1];
      const cells: HTMLElement[] = weekdays.map((w) => el('span', 'wd', w));
      for (const date of monthGrid(month).flat()) {
        if (!date) {
          cells.push(el('span', 'blank'));
          continue;
        }
        const n = free.get(date) ?? 0;
        const b = el('button', 'day', String(Number(date.slice(8))));
        b.type = 'button';
        b.disabled = n === 0;
        if (date === today) b.classList.add('today');
        if (n) b.classList.add('open');
        b.setAttribute('aria-pressed', String(date === day));
        b.setAttribute('aria-label', `${longDayLabel(date, lang)}${n ? ` · ${n === 1 ? L.free1 : L.free.replace('{n}', String(n))}` : ''}`);
        b.addEventListener('click', () => {
          day = date;
          start = null;
          details.hidden = true;
          renderCalendar();
          renderTimes();
        });
        cells.push(b);
      }
      gridEl.replaceChildren(...cells);
      q('[data-noslots]').hidden = days.length > 0;
    };

    const loadSlots = async () => {
      const slots = await agendaApi<SlotsResponse>(`/slots?kind=${kind()}&duration=${duration()}`);
      if (!slots.calendar_ok) throw { status: 503, code: 'calendar_unavailable' };
      days = groupByLocalDay(slots, tz, lang);
      if (!days.some((d) => d.date === day)) day = days[0]?.date ?? null;
      if (!days.some((d) => d.times.some((t) => t.iso === start))) {
        start = null;
        details.hidden = true;
      } else pickedText();
      if (day) month = monthOf(day);
      renderCalendar();
      renderTimes();
    };

    const fillDurations = () => {
      const current = duration();
      const ds = config.kinds[kind()].durations;
      const pick = ds.includes(current) ? current : ds.includes(30) ? 30 : ds[0];
      durSet.replaceChildren(
        ...ds.map((m) => {
          const label = el('label', '');
          const input = el('input', '');
          input.type = 'radio';
          input.name = 'duration';
          input.value = String(m);
          input.checked = m === pick;
          label.append(input, el('span', '', `${m} ${L.minutes}`));
          return label;
        }),
      );
    };

    const down = () => {
      q('[data-loading]').hidden = true;
      q('[data-down]').hidden = false;
      form.hidden = true;
    };

    prevBtn.addEventListener('click', () => {
      month = addMonths(month, -1);
      renderCalendar();
    });
    nextBtn.addEventListener('click', () => {
      month = addMonths(month, 1);
      renderCalendar();
    });
    q('[data-change]').addEventListener('click', () => {
      start = null;
      details.hidden = true;
      renderTimes();
      q('.slots').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
    form.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'kind') fillDurations();
      if (t.name === 'kind' || t.name === 'duration') void loadSlots().catch(down);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!start || !form.reportValidity()) return;
      const values = Object.fromEntries(new FormData(form)) as unknown as BookingForm;
      submit.disabled = true;
      show(status, L.sending, '');
      try {
        await agendaApi('/bookings', bookingBody({ ...values, start }, lang, tz, startedAt));
        show(status, L.sent.replace('{email}', values.email).replace('{min}', String(config.hold_minutes)), 'ok');
        details.hidden = true;
        start = null;
        await loadSlots();
      } catch (err) {
        show(status, errorText(err, E, L.error), 'error');
        if ((err as { status?: number }).status === 409) await loadSlots().catch(() => undefined);
      } finally {
        submit.disabled = false;
      }
    });

    // ---- assistente ----
    const chat = q<HTMLElement>('[data-chat]');
    const list = q<HTMLOListElement>('[data-messages]');
    const ask = q<HTMLFormElement>('[data-ask]');
    const input = ask.querySelector<HTMLInputElement>('input')!;
    const empty = q<HTMLElement>('[data-empty]');
    let conversation: string | null = null;
    let chatOver = false; // fim de conversa, orçamento ou assistente fora do ar

    const say = (who: string, text: string, cls: string) => {
      const li = el('li', cls);
      li.append(el('span', 'who', who), el('p', '', text)); // texto puro: nada do modelo vira HTML
      list.append(li);
      list.scrollTop = list.scrollHeight;
      return li;
    };

    const send = async (message: string) => {
      empty.hidden = true;
      list.hidden = false;
      say(L.agentYou, message, 'me');
      const typing = say(L.agentBot, L.thinking, 'bot typing');
      const btn = ask.querySelector<HTMLButtonElement>('button')!;
      btn.disabled = input.disabled = true;
      try {
        const r = await agendaApi<ChatReply>('/chat', chatBody(message, conversation, lang, tz));
        conversation = r.conversation;
        typing.remove();
        say(L.agentBot, r.reply, 'bot');
        if (r.remaining <= 0) chatOver = true;
        await loadSlots().catch(() => undefined); // o assistente pode ter segurado um horário
      } catch (err) {
        typing.remove();
        const st = (err as { status?: number }).status;
        say(L.agentBot, st === 429 ? L.agentLimit : L.agentOff, 'bot error');
        if (st === 503) chatOver = true;
      } finally {
        btn.disabled = input.disabled = chatOver;
        if (!chatOver) input.focus();
      }
    };

    ask.addEventListener('submit', (e) => {
      e.preventDefault();
      const message = input.value.trim();
      if (!message) return;
      input.value = '';
      void send(message);
    });
    root.querySelectorAll<HTMLButtonElement>('[data-sug]').forEach((b) =>
      b.addEventListener('click', () => !chatOver && void send(b.textContent ?? '')),
    );

    (async () => {
      try {
        config = await agendaApi<AgendaConfig>('/config');
        if (!config.calendar_ok) return down();
        input.maxLength = config.agent_max_chars;
        chat.hidden = !config.agent;
        list.hidden = true;
        fillDurations();
        await loadSlots();
        q('[data-loading]').hidden = true;
        form.hidden = false;
      } catch {
        down();
      }
    })();
  }
</script>

<style>
  .small {
    font-size: 14px;
  }
  .booker {
    background: linear-gradient(180deg, var(--panel-2), var(--panel));
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .booker > .notice {
    margin: 20px;
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }

  /* barra: tipo e duração */
  .bar {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid var(--line);
  }
  .seg {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 4px;
