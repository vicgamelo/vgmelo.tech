      tabTools: 'Tools',
      filterTools: 'Filter tools',
      noMatch: 'No tool with that name.',
      outTitle: 'Output',
      tabAnswer: 'Answer',
      tabTrace: 'Trace · genai-lens',
      emptyTitle: 'Nothing ran yet',
      emptyText: 'Write a question in the playground and click Run. The answer, the steps and the genai-lens trace show up here.',
