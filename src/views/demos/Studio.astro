---

<DemoShell lang={lang} demo="demoStudio" wide>
  <div class="wb studio is-anon" id="studio" data-s={JSON.stringify(s)} data-l={JSON.stringify(L)} data-lang={lang} data-view="a">
    <header class="wb-bar">
      <span class="wb-ico" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"></path><path d="M12 12l8-4.5M12 12v9M12 12L4 7.5"></path></svg>
      </span>
      <div class="wb-title anon-only">
        <strong>{L.studio}</strong>
        <span>{L.studioHint}</span>
      </div>
      <div class="s-ident signed-only">
        <label class="wb-sr" for="s-name">{L.name}</label>
        <input id="s-name" class="s-name" type="text" maxlength="60" autocomplete="off" />
        <span class="wb-pill muted" id="s-state"></span>
      </div>
      <span class="wb-spacer"></span>
      <span class="wb-pill" id="s-remaining"></span>
      <div class="s-save signed-only">
        <input id="s-note" type="text" maxlength="200" placeholder={L.note} aria-label={L.note} autocomplete="off" />
        <button type="button" class="btn sm primary" id="s-save">{L.save}</button>
      </div>
      <p class="wb-hint s-saved" id="s-saved" aria-live="polite"></p>
    </header>

    <nav class="wb-views signed-only" aria-label={L.studio}>
      <button data-view-btn="a">{L.viewAgent}</button>
      <button data-view-btn="b">{L.viewRun}</button>
      <button data-view-btn="c">{L.viewVersions} <span class="n" id="s-vcount"></span></button>
    </nav>

    <div class="wb-grid s-grid">
      <aside class="wb-pane s-side signed-only" id="s-side" data-view-of="c">
        <div class="wb-head"><h2>{L.explorer}</h2></div>
        <div class="wb-body s-explorer">
          <button type="button" class="x-item x-new" id="s-new">
            <span class="x-plus" aria-hidden="true">+</span>{L.newBlank}
          </button>
          <div class="x-group">
            <p class="x-title">{L.templates}</p>
            <div id="s-templates" class="x-list"></div>
          </div>
          <div class="x-group">
            <p class="x-title">{L.mine} <span class="wb-count" id="s-vtotal"></span></p>
            <div id="s-versions" class="x-list"></div>
          </div>
          <p class="wb-hint small">{L.versionsHint}</p>
        </div>
      </aside>

      <section class="wb-pane s-edit signed-only" id="s-editor" data-view-of="a">
        <div class="s-settings">
          <label class="wb-field s-model">
            <span class="wb-label">{L.model}</span>
            <select id="s-model"></select>
          </label>
          <label class="wb-field">
            <span class="wb-label">{L.temperature} <output id="s-temp-out" class="wb-count"></output></span>
            <input id="s-temp" type="range" min="0" max="1.5" step="0.1" />
          </label>
          <label class="wb-field s-steps">
            <span class="wb-label">{L.steps}</span>
            <input id="s-steps" type="number" min="1" step="1" inputmode="numeric" />
          </label>
        </div>
        <div class="wb-tabs" id="s-edit-tabs">
          <button class="wb-tab" data-tab="instr" aria-controls="s-p-instr">{L.tabInstr} <span class="wb-count" id="s-count"></span></button>
          <button class="wb-tab" data-tab="tools" aria-controls="s-p-tools">{L.tabTools} <span class="n" id="s-tools-count"></span></button>
        </div>
        <div class="wb-body s-instr-pane" id="s-p-instr" data-pane>
          <label class="wb-sr" for="s-instr">{L.instructions}</label>
          <textarea id="s-instr" spellcheck="false"></textarea>
          <ul class="s-problems" id="s-problems" hidden></ul>
        </div>
        <div class="wb-body" id="s-p-tools" data-pane hidden>
          <p class="wb-hint">{L.toolsHint}</p>
          <input id="s-tool-filter" type="search" placeholder={L.filterTools} aria-label={L.filterTools} autocomplete="off" />
          <div id="s-tools" class="tool-groups"></div>
          <p class="wb-hint" id="s-tools-none" hidden>{L.noMatch}</p>
        </div>
      </section>

      <section class="wb-pane s-play" id="s-play" data-login={route('login', lang)} data-view-of="b">
        <div class="wb-head"><h2>{L.playTitle}</h2></div>
        <div class="wb-body">
          <p class="notice" data-gate>…</p>
          <span data-remaining hidden></span>
          <form class="s-form" id="s-run" data-live hidden>
            <label class="wb-sr" for="s-q">{L.question}</label>
            <textarea id="s-q" maxlength="500" required placeholder={L.placeholder}></textarea>
            <div class="wb-chips">
              {L.examples.map((e) => <button type="button" class="wb-chip" data-example={e}>{e}</button>)}
            </div>
            <label class="wb-field">
              <span class="wb-label">{L.compare}</span>
              <select id="s-compare"></select>
            </label>
            <div class="s-go-row">
              <button class="btn primary" type="submit" id="s-go">{L.run}</button>
              <p class="wb-hint">{L.cost}</p>
            </div>
            <p class="wb-hint">{L.privacy}</p>
          </form>
          <p class="notice error" id="s-error" hidden></p>
        </div>
      </section>

      <section class="wb-pane s-out signed-only" id="s-out" data-view-of="b">
        <div class="wb-head"><h2>{L.outTitle}</h2></div>
        <div class="wb-runs" id="s-runs"></div>
        <div class="wb-tabs" id="s-out-tabs">
          <button class="wb-tab" data-tab="answer" aria-controls="s-p-answer">{L.tabAnswer}</button>
          <button class="wb-tab" data-tab="steps" aria-controls="s-p-steps">{L.steps2}</button>
          <button class="wb-tab" data-tab="trace" aria-controls="s-p-trace">{L.tabTrace} <span class="dot" id="s-trace-dot" hidden></span></button>
          <button class="wb-tab" data-tab="diff" aria-controls="s-p-diff" hidden>{L.diffTitle}</button>
        </div>
        <div class="wb-body" id="s-p-answer" data-pane>
          <div class="wb-empty" id="s-empty">
            <svg viewBox="0 0 120 70" aria-hidden="true">
              <line x1="60" y1="18" x2="24" y2="52"></line>
              <line x1="60" y1="18" x2="96" y2="52"></line>
              <circle cx="60" cy="16" r="10"></circle>
              <circle cx="24" cy="54" r="9"></circle>
              <circle cx="96" cy="54" r="9"></circle>
            </svg>
            <strong>{L.emptyTitle}</strong>
            <span>{L.emptyText}</span>
          </div>
          <div class="wb-cols" id="s-c-answer"></div>
          <div id="s-consult"></div>
        </div>
        <div class="wb-body" id="s-p-steps" data-pane hidden>
          <div class="wb-cols" id="s-c-steps"></div>
        </div>
        <div class="wb-body" id="s-p-trace" data-pane hidden>
          <div class="wb-cols stack" id="s-c-trace"></div>
        </div>
        <div class="wb-body" id="s-p-diff" data-pane hidden>
          <p class="wb-hint">{L.diffHint}</p>
          <div id="s-diff-body"></div>
        </div>
      </section>
    </div>
  </div>
</DemoShell>

<script>
  import { applyEvent, agentLabel, AGENT_LABEL, newRun, runCounts, toolLabel, type RunState } from '../../lib/agentRun';
  import { api, errorFrom, fetchTrace, liveError, readSse, type ApiError } from '../../lib/api';
  import { consultCta, gate } from '../../lib/live';
  import { renderMarkdown } from '../../lib/markdown';
  import { el, runTree } from '../../lib/runTree';
  import {
    blankAgent,
    byAgent,
    diffAgents,
    fromTemplate,
    noDifference,
    parseDraft,
    problems,
    sameAgent,
    toolGroups,
    versionLabel,
    type Catalog,
    type Draft,
    type StudioAgent,
    type Version,
  } from '../../lib/studio';
  import { tabs, views } from '../../lib/tabs';
  import { fmtMs, renderLensTrace, type Span } from '../../lib/waterfall';

  type Texts = Record<string, string> & { groups: Record<string, string>; problems: Record<string, string> };

  const root = document.getElementById('studio');
  if (root) {
    const s = JSON.parse(root.dataset.s!) as Record<string, string>;
    const L = JSON.parse(root.dataset.l!) as Texts;
    const lang = root.dataset.lang === 'en' ? 'en' : 'pt';
    const nf = new Intl.NumberFormat(lang === 'pt' ? 'pt-BR' : 'en-US');
    const df = new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : 'en-US', { dateStyle: 'short', timeStyle: 'short' });
    const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
    const nameIn = $<HTMLInputElement>('s-name');
    const modelSel = $<HTMLSelectElement>('s-model');
    const tempIn = $<HTMLInputElement>('s-temp');
    const stepsIn = $<HTMLInputElement>('s-steps');
    const instrIn = $<HTMLTextAreaElement>('s-instr');
    const noteIn = $<HTMLInputElement>('s-note');
    const saveBtn = $<HTMLButtonElement>('s-save');
    const compareSel = $<HTMLSelectElement>('s-compare');
    const runForm = $<HTMLFormElement>('s-run');
    const goBtn = $<HTMLButtonElement>('s-go');
    const question = $<HTMLTextAreaElement>('s-q');
    const filterIn = $<HTMLInputElement>('s-tool-filter');

    const editTabs = tabs($('s-edit-tabs'));
    const outTabs = tabs($('s-out-tabs'));
    const setView = views(root);
    const isPhone = () => window.matchMedia('(max-width: 1079px)').matches;

    const DRAFT_KEY = 'studio.draft';
    let catalog: Catalog | null = null;
    let versions: Version[] = [];
    let draft: Draft = { name: '', agent: { instructions: '', model: '', tools: [], temperature: 0.2, max_steps: 4 }, base: null };
    let running = false;

    const versionById = (id: string | null) => versions.find((v) => v.id === id) ?? null;
    const templateLabel = (name: string) => AGENT_LABEL[name]?.[lang] ?? agentLabel(name, lang);
    const modelLabel = (id: string) => catalog?.models.find((m) => m.id === id)?.label ?? id;

    // ------------------------------------------------------------ editor <-> rascunho
    const storeDraft = () => {
      try {
        localStorage.setItem(DRAFT_KEY, JSON.stringify(draft));
      } catch {
        /* sem localStorage: o rascunho vale só nesta visita */
      }
    };
    const readFields = () => {
      const checked = [...root.querySelectorAll<HTMLInputElement>('[data-tool]:checked')].map((c) => c.dataset.tool!);
      draft = {
        ...draft,
        name: nameIn.value,
        agent: {
          instructions: instrIn.value,
          model: modelSel.value,
          tools: checked,
          temperature: Math.round(Number(tempIn.value) * 10) / 10,
          max_steps: Number(stepsIn.value),
        },
      };
    };
    const paintState = () => {
      if (!catalog) return;
      const a = draft.agent;
      $('s-temp-out').textContent = a.temperature.toFixed(1);
      $('s-count').textContent = `${nf.format(a.instructions.length)}/${nf.format(catalog.limits.instructions_max_chars)}`;
      $('s-count').classList.toggle('over', a.instructions.length > catalog.limits.instructions_max_chars);
      $('s-tools-count').textContent = a.tools.length ? String(a.tools.length) : '';
      const base = versionById(draft.base);
      const tag = $('s-state');
      if (base) tag.textContent = `v${base.version}${sameAgent(base.agent, a) && base.name === draft.name.trim() ? '' : ` · ${L.edited}`}`;
      else tag.textContent = L.draft;
      const list = $('s-problems');
      const found = problems(a, catalog);
      list.replaceChildren(...found.map((p) => el('li', '', L.problems[p])));
      list.hidden = found.length === 0;
      paintExplorer();
      paintDiff();
    };
    const onEdit = () => {
      readFields();
      storeDraft();
      $('s-saved').textContent = '';
      paintState();
    };

    const fillEditor = (d: Draft) => {
      draft = d;
      nameIn.value = d.name;
      modelSel.value = d.agent.model;
      tempIn.value = String(d.agent.temperature);
      stepsIn.value = String(d.agent.max_steps);
      instrIn.value = d.agent.instructions;
      const on = new Set(d.agent.tools);
      root.querySelectorAll<HTMLInputElement>('[data-tool]').forEach((c) => (c.checked = on.has(c.dataset.tool!)));
      storeDraft();
      paintState();
    };

    const isDirty = () => {
      const base = versionById(draft.base);
      return base ? !sameAgent(base.agent, draft.agent) : draft.agent.instructions.trim() !== '';
    };

    // ------------------------------------------------------------ catálogo
    const buildCatalogFields = (c: Catalog) => {
      modelSel.replaceChildren(
        ...c.models.map((m) => {
          const o = el('option', '', m.available ? m.label : `${m.label} — ${L.unavailable}`);
          o.value = m.id;
          o.disabled = !m.available;
          return o;
        }),
      );
      stepsIn.max = String(c.limits.max_steps);
      const box = $('s-tools');
      box.replaceChildren(
        ...toolGroups(c.tools).map(([group, list]) => {
          const g = el('div', 'tool-group');
          g.append(el('p', 'tool-group-title', L.groups[group] ?? group));
          for (const t of list) {
            const label = el('label', 'tool');
            const input = el('input');
            input.type = 'checkbox';
            input.dataset.tool = t.name;
            input.addEventListener('change', onEdit);
            const text = el('span', 'tool-text');
            text.append(el('code', '', toolLabel(t.name)), el('span', 'tool-desc', t.description.split('\n')[0].slice(0, 160)));
            label.dataset.search = `${t.name} ${t.description}`.toLowerCase();
            label.append(input, text);
            g.append(label);
          }
          return g;
        }),
      );
      const tpl = $('s-templates');
      tpl.replaceChildren(
        ...c.templates.map((t) => {
          const b = el('button', 'x-item');
          b.type = 'button';
          b.dataset.load = `tpl:${t.name}`;
          b.append(el('span', 'x-avatar', templateLabel(t.name)[0]), el('span', 'x-name', templateLabel(t.name)), el('span', 'x-meta mono', modelLabel(t.model).split(' · ')[0]));
          b.addEventListener('click', () => load(`tpl:${t.name}`));
          return b;
        }),
      );
    };

    filterIn.addEventListener('input', () => {
      const q = filterIn.value.trim().toLowerCase();
      let shown = 0;
      root.querySelectorAll<HTMLElement>('.tool-group').forEach((g) => {
        let any = false;
        g.querySelectorAll<HTMLElement>('.tool').forEach((row) => {
          const hit = !q || (row.dataset.search ?? '').includes(q);
          row.hidden = !hit;
          any ||= hit;
          if (hit) shown++;
        });
        g.hidden = !any;
      });
      $('s-tools-none').hidden = shown > 0;
    });

    const buildCompareOptions = () => {
      const keep = compareSel.value;
      const none = el('option', '', L.noCompare);
      none.value = '';
      compareSel.replaceChildren(
        none,
        ...versions.map((v) => {
          const o = el('option', '', versionLabel(v));
          o.value = v.id;
          return o;
        }),
      );
      compareSel.value = versionById(keep) ? keep : '';
      paintRunButton();
    };

    const load = (value: string) => {
      if (!catalog || !value) return;
      if (isDirty() && !window.confirm(L.discard)) return;
      if (value === 'blank') {
        fillEditor({ name: L.newAgent, agent: blankAgent(catalog, L.blankInstructions), base: null });
      } else if (value.startsWith('tpl:')) {
        const t = catalog.templates.find((x) => x.name === value.slice(4));
        if (t) fillEditor({ name: templateLabel(t.name), agent: fromTemplate(t, catalog), base: null });
      } else if (value.startsWith('ver:')) {
        const v = versionById(value.slice(4));
        if (v) fillEditor({ name: v.name, agent: fromTemplate(v.agent, catalog), base: v.id });
      }
      $('s-saved').textContent = '';
      if (isPhone()) setView('a');
    };
    $('s-new').addEventListener('click', () => load('blank'));

    for (const input of [nameIn, modelSel, tempIn, stepsIn, instrIn]) input.addEventListener('input', onEdit);

    // ------------------------------------------------------------ versões (explorador)
    const loadVersions = async () => {
      try {
        versions = await api<Version[]>('/api/studio/versions');
      } catch {
        versions = [];
      }
      if (draft.base && !versionById(draft.base)) draft.base = null;
      buildCompareOptions();
      paintVersions();
      paintState();
    };

    const iconBtn = (cls: string, label: string, text: string, onClick: () => void) => {
      const b = el('button', `x-act ${cls}`, text);
      b.type = 'button';
      b.title = label;
      b.setAttribute('aria-label', label);
      b.addEventListener('click', (e) => {
        e.stopPropagation();
        onClick();
      });
      return b;
    };

    const paintVersions = () => {
      $('s-vcount').textContent = versions.length ? String(versions.length) : '';
      $('s-vtotal').textContent = versions.length ? String(versions.length) : '';
      const box = $('s-versions');
      if (!versions.length) {
        box.replaceChildren(el('p', 'wb-hint', L.noVersions));
        return;
      }
      box.replaceChildren(
        ...byAgent(versions).map(([name, list]) => {
          const g = el('div', 'x-agent');
          g.append(el('p', 'x-agent-name', name));
          for (const v of list) {
            const row = el('div', 'x-ver');
            row.dataset.id = v.id;
            const open = el('button', 'x-ver-open');
            open.type = 'button';
            open.title = L.openHint;
            const line = el('span', 'x-ver-line');
            line.append(el('strong', 'mono', `v${v.version}`), el('span', 'x-meta', df.format(new Date(v.created_at))));
            open.append(line);
            if (v.note) open.append(el('span', 'x-note', v.note));
            open.addEventListener('click', () => load(`ver:${v.id}`));
            const acts = el('span', 'x-acts');
            acts.append(
              iconBtn('cmp', `${L.compareBtn} ${versionLabel(v)}`, '⇄', () => {
                compareSel.value = v.id;
                paintRunButton();
                paintDiff();
                outTabs.select('diff');
                if (isPhone()) setView('b');
              }),
              iconBtn('del', `${L.delete} ${versionLabel(v)}`, '×', async () => {
                if (!window.confirm(L.confirmDelete)) return;
                try {
                  await api(`/api/studio/versions/${encodeURIComponent(v.id)}`, { method: 'DELETE' });
                } catch {
                  /* já não existe: a lista recarregada mostra o estado real */
                }
                await loadVersions();
              }),
            );
            row.append(open, acts);
            g.append(row);
          }
          return g;
        }),
      );
      paintExplorer();
    };

    /** Marca no explorador o que está aberto no editor e o que está na comparação. */
    const paintExplorer = () => {
      root.querySelectorAll<HTMLElement>('.x-ver').forEach((r) => {
        r.classList.toggle('on', r.dataset.id === draft.base);
        r.classList.toggle('cmp', r.dataset.id === compareSel.value);
      });
    };

    saveBtn.addEventListener('click', async () => {
      if (!catalog) return;
      readFields();
      const found = problems(draft.agent, catalog);
      if (found.length) {
        paintState();
        editTabs.select('instr');
        return;
      }
      if (!draft.name.trim()) nameIn.value = draft.name = L.newAgent;
      saveBtn.disabled = true;
      saveBtn.textContent = L.saving;
      try {
        const v = await api<Version>('/api/studio/versions', {
          method: 'POST',
          body: JSON.stringify({ name: draft.name.trim(), note: noteIn.value.trim() || null, agent: draft.agent }),
        });
        noteIn.value = '';
        draft = { ...draft, name: v.name, base: v.id };
        storeDraft();
        await loadVersions();
        $('s-saved').textContent = `${L.savedAs} ${versionLabel(v)}.`;
      } catch (err) {
        const e = err as ApiError;
        $('s-saved').textContent =
          e?.status === 409 ? L.tooMany : e?.status === 429 ? L.slowDown : e?.status === 422 ? s['live.invalid'] : liveError(err, s);
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = L.save;
      }
    });

    // ------------------------------------------------------------ comparação
    const paintRunButton = () => {
      goBtn.textContent = running ? L.running : compareSel.value ? L.runCompare : L.run;
    };
    const paintDiff = () => {
      const other = versionById(compareSel.value);
      outTabs.toggle('diff', !!other);
      if (!other) return;
      const d = diffAgents(other.agent, draft.agent);
      const body = $('s-diff-body');
      if (noDifference(d)) {
        body.replaceChildren(el('p', 'wb-hint', L.same));
        return;
      }
      const rows: HTMLElement[] = [];
      const row = (label: string, from: string, to: string) => {
        const r = el('div', 'd-row');
        r.append(el('span', 'd-key', label), el('span', 'd-from mono', from), el('span', 'd-arrow', '→'), el('span', 'd-to mono', to));
        rows.push(r);
      };
      if (d.model) row(L.model, modelLabel(d.model[0]), modelLabel(d.model[1]));
      if (d.temperature) row(L.temperature, d.temperature[0].toFixed(1), d.temperature[1].toFixed(1));
      if (d.max_steps) row(L.steps, String(d.max_steps[0]), String(d.max_steps[1]));
      if (d.toolsAdded.length || d.toolsRemoved.length) {
        const r = el('div', 'd-row');
        r.append(el('span', 'd-key', L.tools));
        const chips = el('span', 'd-tools');
        for (const t of d.toolsAdded) chips.append(el('code', 'd-add', `+ ${toolLabel(t)}`));
        for (const t of d.toolsRemoved) chips.append(el('code', 'd-del', `− ${toolLabel(t)}`));
        r.append(chips);
        rows.push(r);
      }
      if (d.instructions) {
        const pre = el('pre', 'd-lines');
        for (const line of d.instructions) {
          pre.append(el('span', `d-line d-${line.op}`, `${line.op === 'add' ? '+ ' : line.op === 'del' ? '− ' : '  '}${line.text}`));
        }
        const wrap = el('div', 'd-row d-block');
        wrap.append(el('span', 'd-key', L.instructions), pre);
        rows.push(wrap);
      }
      body.replaceChildren(...rows);
    };
    compareSel.addEventListener('change', () => {
      paintRunButton();
      paintDiff();
      paintExplorer();
      if (compareSel.value) outTabs.select('diff');
    });

    // ------------------------------------------------------------ execução
    interface Column {
      label: string;
      agent: StudioAgent;
      state: RunState;
      tree: ReturnType<typeof runTree>;
      t0: number;
      timer?: number;
      frame: number;
      row: HTMLElement;
      answer: HTMLElement;
      steps: HTMLElement;
      trace: HTMLElement;
    }

    const colBox = (label: string, sub: string) => {
      const box = el('div', 'wb-col');
      box.append(el('div', 'wb-col-head', `${label} · ${sub}`));
      return box;
    };

    const column = (label: string, sub: string, agent: StudioAgent): Column => {
      const row = el('div', 'wb-run');
      const name = el('div', 'wb-run-name');
      name.append(el('strong', '', label), el('span', '', sub));
      const status = el('span', 'wb-status');
      status.dataset.state = 'idle';
      status.append(el('span', 'st-dot'), el('span', 'r-status', L.queued));
      const kpis = el('div', 'wb-kpis');
      kpis.hidden = true;
      row.append(name, status, kpis);
      const answer = colBox(label, sub);
      answer.append(el('p', 'notice error r-error'), el('div', 'md r-answer'));
      (answer.querySelector('.r-error') as HTMLElement).hidden = true;
      const steps = colBox(label, sub);
      steps.append(el('div', 'run-tree r-tree'));
      const trace = colBox(label, sub);
      trace.append(el('div', 'r-lens'));
      const tree = runTree(L, lang, (n) => (n === 'studio' ? label : agentLabel(n, lang)));
      return { label, agent, state: newRun(), tree, t0: 0, frame: 0, row, answer, steps, trace };
    };

    const setStatus = (c: Column, state: 'idle' | 'live' | 'ready' | 'failed', extra = '') => {
      (c.row.querySelector('.wb-status') as HTMLElement).dataset.state = state;
      c.row.querySelector('.r-status')!.textContent = `${L[state]}${extra ? ` · ${extra}` : ''}`;
    };
    const renderTreeNow = (c: Column) => {
      c.frame = 0;
      c.steps.querySelector('.r-tree')!.replaceChildren(...(c.state.root ? [c.tree.card(c.state.root)] : []));
    };
    const scheduleTree = (c: Column) => {
      if (!c.frame) c.frame = requestAnimationFrame(() => renderTreeNow(c));
    };

    const loadTrace = async (c: Column, traceId: string) => {
      const box = c.trace.querySelector<HTMLElement>('.r-lens')!;
      box.replaceChildren(el('p', 'wb-hint', L.lensWait));
      try {
        const spans = await fetchTrace<Span[]>(traceId);
        renderLensTrace(box, traceId, spans, lang);
        $('s-trace-dot').hidden = outTabs.current() === 'trace';
      } catch {
        box.replaceChildren(el('p', 'wb-hint', L.traceMissing));
      }
    };

    const showDone = (c: Column) => {
      const d = c.state.done;
      if (!d) return;
      const counts = runCounts(c.state);
      const kpis = c.row.querySelector<HTMLElement>('.wb-kpis')!;
      const kpi = (value: string, label: string) => {
        const k = el('span', 'wb-kpi');
        k.append(el('strong', '', value), document.createTextNode(label));
        return k;
      };
      kpis.replaceChildren(
        kpi(fmtMs(d.durationMs), L.kTime),
        kpi(nf.format(d.inputTokens + d.outputTokens), L.kTokens),
        kpi(String(counts.llm), L.kLlm),
        kpi(String(counts.tools), L.kTools),
      );
      kpis.hidden = false;
      const answer = c.answer.querySelector<HTMLElement>('.r-answer')!;
      if (d.output) renderMarkdown(answer, d.output);
      else answer.replaceChildren(el('p', 'wb-hint', L.noAnswer));
      const ok = d.status === 'completed' || d.status === 'ok';
      setStatus(c, ok ? 'ready' : 'failed', fmtMs(d.durationMs));
      if (d.traceId) void loadTrace(c, d.traceId);
      else c.trace.querySelector('.r-lens')!.replaceChildren(el('p', 'wb-hint', L.traceMissing));
    };
    const fail = (c: Column, err: unknown) => {
      const e = err as ApiError;
      const box = c.answer.querySelector<HTMLElement>('.r-error')!;
      box.hidden = false;
      box.textContent = e?.status === 422 && e.reason === 'invalid_agent' ? `${L.invalidAgent} ${e.message ?? ''}`.trim() : liveError(err, s);
      setStatus(c, 'failed');
    };

    /** Roda uma coluna; devolve false quando não vale tentar a próxima (cota, orçamento, login). */
    const runColumn = async (c: Column, text: string): Promise<boolean> => {
      c.state = newRun();
      c.tree.reset();
      c.t0 = performance.now();
      setStatus(c, 'live');
      c.timer = window.setInterval(() => setStatus(c, 'live', fmtMs(performance.now() - c.t0)), 100);
      try {
        const res = await fetch('/api/studio/run/stream', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'content-type': 'application/json', accept: 'text/event-stream' },
          body: JSON.stringify({ question: text, agent: c.agent }),
        });
        if (!res.ok) throw await errorFrom(res);
        await readSse(res, (event, raw) => {
          applyEvent(c.state, event, raw, performance.now() - c.t0);
          scheduleTree(c);
        });
        if (!c.state.done) throw { status: 502 };
        window.clearInterval(c.timer);
        renderTreeNow(c);
        showDone(c);
        return true;
      } catch (err) {
        window.clearInterval(c.timer);
        renderTreeNow(c);
        fail(c, err);
        const e = err as ApiError;
        return !(e?.status === 401 || e?.status === 429);
      }
    };

    root.querySelectorAll<HTMLButtonElement>('[data-example]').forEach((b) =>
      b.addEventListener('click', () => {
        question.value = b.dataset.example!;
        question.focus();
      }),
    );

    $('s-out-tabs')
      .querySelector('[data-tab="trace"]')!
      .addEventListener('click', () => ($('s-trace-dot').hidden = true));

    runForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!catalog || running) return;
      readFields();
      const text = question.value.trim();
      if (!text) return;
      const found = problems(draft.agent, catalog);
      if (found.length) {
        paintState();
        editTabs.select('instr');
        if (isPhone()) setView('a');
        $('s-problems').scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      const other = versionById(compareSel.value);
      const base = versionById(draft.base);
      const sub =
        base && sameAgent(base.agent, draft.agent) ? `v${base.version}` : base ? `v${base.version} · ${L.edited}` : L.unsaved;
      const cols = [column(draft.name.trim() || L.newAgent, `${L.editorCol} · ${sub}`, { ...draft.agent })];
      if (other) cols.push(column(other.name, `v${other.version}`, fromTemplate(other.agent, catalog)));

      running = true;
      goBtn.disabled = true;
      saveBtn.disabled = true;
      paintRunButton();
      $('s-error').hidden = true;
      $('s-empty').hidden = true;
      $('s-trace-dot').hidden = true;
      $('s-consult').replaceChildren();
      $('s-runs').replaceChildren(...cols.map((c) => c.row));
      for (const [id, key] of [
        ['s-c-answer', 'answer'],
        ['s-c-steps', 'steps'],
        ['s-c-trace', 'trace'],
      ] as const) {
        const box = $(id);
        box.classList.toggle('two', cols.length === 2 && key !== 'trace');
        box.classList.toggle('many', cols.length === 2);
        box.replaceChildren(...cols.map((c) => c[key]));
      }
      outTabs.select('steps');
      if (isPhone()) setView('b');
      $('s-out').scrollIntoView({ behavior: 'smooth', block: 'start' });
      try {
        for (const c of cols) {
          const ok = await runColumn(c, text);
          if (c === cols[0] && c.state.done) outTabs.select('answer');
          if (!ok) break;
        }
        if (!cols[0].state.done) outTabs.select('answer');
      } finally {
        running = false;
        goBtn.disabled = false;
        saveBtn.disabled = false;
        paintRunButton();
        const g = await refreshGate();
        if (g.ready) $('s-consult').replaceChildren(consultCta(s, lang));
      }
    });

    // ------------------------------------------------------------ início
    // O portão (login, cota, orçamento) vale só para rodar: editar e salvar versões não gastam cota.
    const play = $('s-play');
    const refreshGate = async () => {
      const g = await gate(play, 'studio', s);
      // o portão escreve no playground; a pílula fica na barra do topo
      const r = play.querySelector<HTMLElement>('[data-remaining]');
      $('s-remaining').textContent = (r?.textContent ?? '').replace(/^·\s*/, '');
      return g;
    };
    const start = async () => {
      const g = await refreshGate();
      if (!g.me?.user || catalog) return;
      try {
        catalog = await api<Catalog>('/api/studio/catalog');
      } catch (err) {
        const box = play.querySelector<HTMLElement>('[data-gate]')!;
        box.hidden = false;
        box.textContent = liveError(err, s);
        runForm.hidden = true;
        return;
      }
      root.classList.remove('is-anon');
      buildCatalogFields(catalog);
      await loadVersions();
      let saved: Draft | null = null;
      try {
        saved = parseDraft(localStorage.getItem(DRAFT_KEY));
      } catch {
        saved = null;
      }
      if (saved) fillEditor({ ...saved, agent: { ...saved.agent, tools: saved.agent.tools.filter((t) => catalog!.tools.some((x) => x.name === t)) } });
      else {
        const first = catalog.templates[0];
        fillEditor(
          first
            ? { name: templateLabel(first.name), agent: fromTemplate(first, catalog), base: null }
            : { name: L.newAgent, agent: blankAgent(catalog, L.blankInstructions), base: null },
        );
      }
    };
    void start();
  }
</script>

<style>
  .s-grid {
    grid-template-columns: 236px minmax(0, 1.3fr) minmax(0, 1fr);
    grid-template-rows: var(--wb-h) auto;
    grid-template-areas:
      'side edit play'
      'out out out';
  }
  .s-side {
    grid-area: side;
  }
  .s-edit {
    grid-area: edit;
  }
  .s-play {
    grid-area: play;
  }
  .s-out {
    grid-area: out;
    min-height: 360px;
  }
  .studio.is-anon .signed-only {
    display: none !important;
  }
  .studio:not(.is-anon) .anon-only {
    display: none;
  }
  .studio.is-anon .s-grid {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto;
    grid-template-areas: 'play';
  }

  /* Barra */
  .s-ident {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1 1 260px;
  }
  .s-name {
    font-size: 16px;
    font-weight: 650;
    letter-spacing: -0.01em;
    border-color: transparent;
    background: transparent;
    padding: 6px 8px;
    min-height: 38px;
    flex: 1 1 auto;
    width: auto;
    max-width: 340px;
  }
  .s-ident .wb-pill {
    flex: none;
  }
  .s-save .btn {
    white-space: nowrap;
  }
  .s-name:hover {
    border-color: var(--line);
  }
  .s-save {
    display: flex;
    gap: 8px;
    flex: 0 1 420px;
  }
  .s-save input {
    flex: 1 1 200px;
    min-height: 34px;
    padding: 5px 10px;
