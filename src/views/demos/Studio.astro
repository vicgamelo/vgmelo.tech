    text-align: right;
  }

  /* Editor */
  .s-settings {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) 92px;
    gap: 12px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
    align-items: end;
  }
  .s-settings select,
  .s-settings input[type='number'] {
    min-height: 38px;
    padding: 6px 10px;
  }
  input[type='range'] {
    padding: 0;
    min-height: 38px;
