      outTitle: 'Saída',
      tabAnswer: 'Resposta',
      tabTrace: 'Trace · genai-lens',
      emptyTitle: 'Nada rodou ainda',
      emptyText: 'Escreva uma pergunta no playground e clique em Rodar. A resposta, o passo a passo e o trace do genai-lens aparecem aqui.',
      noAnswer: 'Sem resposta.',
      lensWait: 'Buscando o trace no genai-lens…',
