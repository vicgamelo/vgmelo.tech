---
import DemoShell from '../../components/DemoShell.astro';
import { route, type Lang } from '../../i18n/routes';
import { uiStrings } from '../../i18n/ui';
import { LIVE_KEYS } from '../../lib/live';
import { AGENT_LABEL } from '../../lib/agentRun';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = uiStrings(lang, [...LIVE_KEYS]);
const L =
  lang === 'pt'
    ? {
        askTitle: 'Pergunte ao time',
        askHint: 'Um coordenador divide a pergunta e manda cada parte para um especialista.',
        question: 'Sua pergunta',
        placeholder: 'Ex.: Qual a Selic hoje e o que os jornais estão dizendo sobre ela?',
        examples: [
          'Qual a Selic hoje e o que as notícias dizem sobre o próximo Copom?',
          'O que o IBGE divulgou sobre desemprego e o que tramita no Senado sobre emprego?',
          'Qual o limite do Pix à noite, segundo as normas do Banco Central?',
          'O que a empresa de CNPJ 00.000.000/0001-91 faz e onde fica?',
          'Tem horário para uma consultoria com o Victor nesta semana?',
        ],
        run: 'Perguntar',
        running: 'Rodando…',
        note: 'Não envie dados pessoais: a pergunta vai para um provedor de LLM gratuito.',
        sample: 'Ver um exemplo',
        sampleHint: 'Reproduz uma execução gravada, sem login e sem gastar cota.',
        teamTitle: 'O time',
        teamHint: 'Um coordenador e cinco especialistas. Cada especialista usa as ferramentas de um servidor MCP.',
        tools: 'ferramentas',
        mcpHint: 'Desligue um MCP e o especialista dele sai do time nesta pergunta: o coordenador nem fica sabendo que ele existe.',
        on: 'ligado',
        off: 'desligado',
        down: 'fora do ar',
        allOff: 'Com todos os MCPs desligados, o coordenador fica sem ninguém para consultar e só consegue dizer que não tem como responder.',
        otel: 'Cada passo vira um span OpenTelemetry no genai-lens: é o trace que aparece no fim.',
        answer: 'Resposta',
        emptyTitle: 'Nenhuma pergunta ainda',
        emptyText: 'Faça uma pergunta ou veja o exemplo para acompanhar os agentes trabalhando.',
        working: 'Os agentes estão trabalhando…',
        idle: 'aguardando',
        live: 'rodando',
        ready: 'pronto',
        failed: 'falhou',
        sampleTag: 'exemplo',
        copy: 'Copiar',
        copied: 'Copiado',
        kTime: 'tempo total',
        kTokens: 'tokens',
        kLlm: 'chamadas ao LLM',
        kTools: 'ferramentas',
        kAgents: 'agentes',
        steps: 'Passo a passo',
        stepsHint: 'Ao vivo: quem decidiu o quê, com quais argumentos e o que voltou.',
        decided: 'decidiu chamar',
        wrote: 'escreveu a resposta',
        cutoff: 'parou por limite de tokens',
        thinking: 'pensando…',
        delegated: 'delegou para',
        result: 'resultado',
        answerOf: 'resposta de',
        error: 'erro',
        trace: 'Trace no genai-lens',
        traceHint: 'Cada barra é um span: agente, chamada ao LLM ou ferramenta. Clique numa linha para ver os detalhes.',
        traceWait: 'Buscando o trace…',
        traceMissing: 'O trace desta execução não ficou disponível.',
      }
    : {
        askTitle: 'Ask the team',
        askHint: 'A coordinator splits the question and sends each part to a specialist.',
        question: 'Your question',
        placeholder: "E.g. What's the Selic rate today and what is the press saying about it?",
        examples: [
          "What's the Selic rate today and what does the news say about the next Copom meeting?",
          'What did IBGE release about unemployment, and what employment bills are in the Senate?',
          "What's the Pix limit at night under the Banco Central rules?",
          'What does the company with CNPJ 00.000.000/0001-91 do and where is it?',
          'Does Victor have time for a consulting call this week?',
        ],
        run: 'Ask',
        running: 'Running…',
        note: "Don't send personal data: the question goes to a free LLM provider.",
        sample: 'See an example',
        sampleHint: 'Replays a recorded run, no sign-in and no quota used.',
        teamTitle: 'The team',
        teamHint: 'A coordinator and five specialists. Each specialist uses the tools of one MCP server.',
        tools: 'tools',
        mcpHint: "Turn an MCP off and its specialist leaves the team for this question: the coordinator doesn't even know it exists.",
        on: 'on',
        off: 'off',
        down: 'down',
        allOff: 'With every MCP off, the coordinator has nobody to ask and can only say it has no way to answer.',
        otel: 'Every step becomes an OpenTelemetry span in genai-lens: that is the trace shown at the end.',
        answer: 'Answer',
        emptyTitle: 'No question yet',
        emptyText: 'Ask something or watch the example to follow the agents at work.',
        working: 'The agents are working…',
        idle: 'waiting',
        live: 'running',
        ready: 'done',
        failed: 'failed',
        sampleTag: 'example',
        copy: 'Copy',
        copied: 'Copied',
        kTime: 'total time',
        kTokens: 'tokens',
        kLlm: 'LLM calls',
        kTools: 'tools',
        kAgents: 'agents',
        steps: 'Step by step',
        stepsHint: 'Live: who decided what, with which arguments and what came back.',
        decided: 'decided to call',
        wrote: 'wrote the answer',
        cutoff: 'stopped at the token limit',
        thinking: 'thinking…',
        delegated: 'delegated to',
        result: 'result',
        answerOf: 'answer from',
        error: 'error',
        trace: 'Trace in genai-lens',
        traceHint: 'Each bar is a span: agent, LLM call or tool. Click a row for the details.',
        traceWait: 'Fetching the trace…',
        traceMissing: "This run's trace isn't available.",
      };

const AGENT = (name: string, model: string, tools: string[]) => ({
  name,
  model,
  tools,
  label: AGENT_LABEL[name][lang],
  role: AGENT_LABEL[name].role[lang],
});
const lead = AGENT('coordinator', 'gpt-oss-120b', ['current_datetime']);
const pt = lang === 'pt';
// Nomes dos servidores iguais aos do orquestrador e do portal (brasil, noticias, normas, agenda).
const SERVERS = [
  {
    name: 'brasil',
    label: pt ? 'Dados do Brasil' : 'Brazilian data',
    source: 'BrasilAPI · Banco Central · IBGE',
    agents: [
      AGENT('economist', 'gpt-oss-20b', ['indicador_economico', 'calculator']),
      AGENT('company_researcher', 'gpt-oss-20b', ['consultar_cnpj', 'consultar_cep', 'validar_documento', 'dias_uteis']),
    ],
  },
  {
    name: 'noticias',
    label: pt ? 'Notícias e informação pública' : 'News and public information',
    source: 'Google Notícias · Agência Brasil · g1 · InfoMoney · Poder360 · IBGE · Senado · Câmara',
    agents: [
      AGENT('news_researcher', 'gpt-oss-20b', ['buscar_noticias', 'ultimas_noticias', 'ler_noticia', 'noticias_ibge', 'senado_materias', 'camara_proposicoes']),
    ],
  },
  {
    name: 'normas',
    label: pt ? 'Normas do Pix' : 'Pix regulations',
    source: pt ? 'RAG sobre as normas do Banco Central' : 'RAG over the Banco Central rules',
    agents: [AGENT('pix_specialist', 'gpt-oss-20b', ['buscar_normas'])],
  },
  {
    name: 'agenda',
    label: pt ? 'Agenda do Victor' : "Victor's calendar",
    source: pt ? 'Só consulta horários; quem marca é você' : 'Only reads free times; you book it',
    agents: [AGENT('scheduler', 'gpt-oss-20b', ['horarios_livres'])],
  },
];
---

<DemoShell lang={lang} demo="demoAgents">
  <div class="agents" id="agents" data-s={JSON.stringify(s)} data-l={JSON.stringify(L)} data-lang={lang} data-login={route('login', lang)}>
    <section class="panel ask">
      <div class="panel-head">
        <div>
          <h2>{L.askTitle}</h2>
          <p class="hint">{L.askHint}</p>
        </div>
        <span class="quota mono" data-remaining></span>
      </div>
      <p class="notice" data-gate>…</p>
      <form class="ask-form" data-live hidden>
        <label class="sr-only" for="q">{L.question}</label>
        <textarea id="q" name="question" maxlength="600" required placeholder={L.placeholder}></textarea>
        <div class="chips">
          {L.examples.map((e) => <button type="button" class="chip" data-example={e}>{e}</button>)}
        </div>
        <div class="ask-actions">
          <button class="btn primary" type="submit">{L.run}</button>
          <p class="hint small">{L.note}</p>
        </div>
      </form>
      <div class="sample-row">
        <button type="button" class="btn" id="a-sample">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"></path></svg>
          {L.sample}
        </button>
        <span class="hint small">{L.sampleHint}</span>
      </div>
    </section>

    <aside class="panel team">
      <h2>{L.teamTitle}</h2>
      <p class="hint">{L.teamHint}</p>
      <div class="org">
        <div class="member m-lead">
          <div class="m-head">
            <span class="avatar a-coordinator">{lead.label[0]}</span>
            <div>
              <strong>{lead.label}</strong>
              <span class="m-role">{lead.role}</span>
            </div>
          </div>
          <div class="m-meta"><span class="pill model">{lead.model}</span>{lead.tools.map((t) => <span class="pill">{t}</span>)}</div>
        </div>
        <p class="mcp-hint hint">{L.mcpHint}</p>
        <div class="servers">
          {
            SERVERS.map((srv) => (
              <div class="server" data-server={srv.name}>
                <div class="srv-head">
                  <button type="button" class="switch" role="switch" aria-checked="true" data-switch={srv.name} aria-label={srv.label}>
                    <span class="knob" />
                  </button>
                  <div class="srv-title">
                    <strong>{srv.label}</strong>
                    <span class="srv-src">MCP <code>{srv.name}</code> · {srv.source}</span>
                  </div>
                  <span class="srv-state" data-state-of={srv.name}>{L.on}</span>
                </div>
                {srv.agents.map((w) => (
                  <div class="member">
                    <div class="m-head">
                      <span class={`avatar a-${w.name}`}>{w.label[0]}</span>
                      <div>
                        <strong>{w.label}</strong>
                        <span class="m-role">{w.role}</span>
                      </div>
                    </div>
                    <div class="m-meta">
                      <span class="pill model">{w.model}</span>
                      {w.tools.map((t) => <span class="pill">{t}</span>)}
                    </div>
                  </div>
                ))}
              </div>
            ))
          }
        </div>
        <p class="notice small" data-alloff hidden>{L.allOff}</p>
      </div>
      <p class="otel">{L.otel}</p>
    </aside>

    <section class="panel full answer-panel">
      <div class="panel-head">
        <div class="grow">
          <h2>{L.answer}</h2>
          <p class="hint q-echo" id="a-question" hidden></p>
        </div>
        <div class="head-actions">
          <span class="status" id="a-status" data-state="idle"><span class="st-dot"></span><span id="a-status-text">{L.idle}</span></span>
          <button type="button" class="btn copy" id="a-copy" hidden>{L.copy}</button>
        </div>
      </div>
      <div class="kpis" id="a-kpis" hidden>
        <div class="kpi"><strong id="k-time"></strong><span>{L.kTime}</span></div>
        <div class="kpi"><strong id="k-tokens"></strong><span>{L.kTokens}</span></div>
        <div class="kpi"><strong id="k-llm"></strong><span>{L.kLlm}</span></div>
        <div class="kpi"><strong id="k-tools"></strong><span>{L.kTools}</span></div>
        <div class="kpi"><strong id="k-agents"></strong><span>{L.kAgents}</span></div>
      </div>
      <p class="notice error" id="a-error" hidden></p>
      <div class="empty" id="a-empty">
        <svg viewBox="0 0 120 70" aria-hidden="true">
          <line x1="60" y1="18" x2="24" y2="52"></line>
          <line x1="60" y1="18" x2="96" y2="52"></line>
          <circle class="n1" cx="60" cy="16" r="10"></circle>
          <circle class="n2" cx="24" cy="54" r="9"></circle>
          <circle class="n3" cx="96" cy="54" r="9"></circle>
        </svg>
        <strong>{L.emptyTitle}</strong>
        <span>{L.emptyText}</span>
      </div>
      <div class="working" id="a-working" hidden><span class="spinner"></span>{L.working}</div>
      <div class="md" id="a-text" hidden></div>
      <div id="a-consult" hidden></div>
    </section>

    <section class="panel full" id="a-run" hidden>
      <div class="panel-head">
        <div>
          <h2>{L.steps}</h2>
          <p class="hint">{L.stepsHint}</p>
        </div>
      </div>
      <div class="run-tree" id="a-tree"></div>
    </section>

    <section class="panel full" id="a-trace" hidden>
      <div class="panel-head">
        <div>
          <h2>{L.trace}</h2>
          <p class="hint">{L.traceHint}</p>
        </div>
      </div>
      <p class="hint" id="a-trace-wait" hidden></p>
      <div class="waterfall" id="a-waterfall"></div>
    </section>
  </div>
</DemoShell>

<script>
  import { sampleRun } from '../../data/agentsSample';
  import {
    agentLabel,
    applyEvent,
    argsLine,
    DELEGATE_PREFIX,
    newRun,
    prettyResult,
    runCounts,
    toolLabel,
    type AgentNode,
    type RunState,
    type Step,
  } from '../../lib/agentRun';
  import { errorFrom, fetchTrace, liveError, readSse } from '../../lib/api';
  import { consultCta, gate } from '../../lib/live';
  import { renderMarkdown } from '../../lib/markdown';
  import { fmtMs, renderWaterfall, type Span } from '../../lib/waterfall';

  const root = document.getElementById('agents');
  if (root) {
    const s = JSON.parse(root.dataset.s!) as Record<string, string>;
    const L = JSON.parse(root.dataset.l!) as Record<string, string>;
    const lang = root.dataset.lang === 'en' ? 'en' : 'pt';
    const nf = new Intl.NumberFormat(lang === 'pt' ? 'pt-BR' : 'en-US');
    const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
    const form = root.querySelector<HTMLFormElement>('form')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const textarea = form.querySelector<HTMLTextAreaElement>('textarea')!;
    const sampleBtn = $<HTMLButtonElement>('a-sample');
    const copyBtn = $<HTMLButtonElement>('a-copy');

    // ------------------------------------------------------------ MCPs ligados e desligados
    const switches = [...root.querySelectorAll<HTMLButtonElement>('[data-switch]')];
    const OFF_KEY = 'agents.mcpOff';
    const readOff = (): string[] => {
      try {
        const v = JSON.parse(localStorage.getItem(OFF_KEY) ?? '[]');
        return Array.isArray(v) ? v.filter((x) => typeof x === 'string') : [];
      } catch {
        return [];
      }
    };
    const paintServer = (b: HTMLButtonElement) => {
      const name = b.dataset.switch!;
      const on = b.getAttribute('aria-checked') === 'true';
      const box = root.querySelector<HTMLElement>(`[data-server="${name}"]`)!;
      box.classList.toggle('is-off', !on);
      box.classList.toggle('is-down', b.disabled);
      root.querySelector<HTMLElement>(`[data-state-of="${name}"]`)!.textContent = b.disabled ? L.down : on ? L.on : L.off;
    };
    const enabledServers = () =>
      switches.filter((b) => !b.disabled && b.getAttribute('aria-checked') === 'true').map((b) => b.dataset.switch!);
    const paintAll = () => {
      switches.forEach(paintServer);
      root.querySelector<HTMLElement>('[data-alloff]')!.hidden = enabledServers().length > 0;
    };
    const off = new Set(readOff());
    switches.forEach((b) => {
      b.setAttribute('aria-checked', String(!off.has(b.dataset.switch!)));
      b.addEventListener('click', () => {
        b.setAttribute('aria-checked', String(b.getAttribute('aria-checked') !== 'true'));
        try {
          const now = switches.filter((x) => x.getAttribute('aria-checked') !== 'true').map((x) => x.dataset.switch!);
          localStorage.setItem(OFF_KEY, JSON.stringify(now));
        } catch {
          /* sem localStorage: a escolha vale só nesta visita */
        }
        paintAll();
      });
    });
    paintAll();

    // Servidor fora do ar no momento: chave travada e desligada.
    const loadServerStatus = async () => {
      try {
        const res = await fetch('/api/demo/agents/servers', { credentials: 'same-origin' });
        if (!res.ok) return;
        const list = (await res.json()) as { name: string; up: boolean }[];
        for (const srv of list) {
          const b = switches.find((x) => x.dataset.switch === srv.name);
          if (!b) continue;
          b.disabled = !srv.up;
          if (!srv.up) b.setAttribute('aria-checked', 'false');
        }
        paintAll();
      } catch {
        /* sem status: as chaves ficam como estão */
      }
    };

    // O texto de "restam hoje" vem com "· " na frente (feito para ir depois de um rótulo); aqui é uma pílula.
    let statusLoaded = false;
    const refreshGate = async () => {
      const g = await gate(root, 'agents', s);
      const r = root.querySelector<HTMLElement>('[data-remaining]');
      if (r) r.textContent = (r.textContent ?? '').replace(/^·\s*/, '');
      if (g.me?.user && !statusLoaded) {
        statusLoaded = true;
        void loadServerStatus();
      }
    };

    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) => {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text !== undefined) e.textContent = text;
      return e;
    };

    root.querySelectorAll<HTMLButtonElement>('[data-example]').forEach((b) =>
      b.addEventListener('click', () => {
        textarea.value = b.dataset.example!;
        textarea.focus();
      }),
    );

    // ------------------------------------------------------------ status e cronômetro
    let timer: number | undefined;
    let t0 = 0;
    const setStatus = (state: 'idle' | 'live' | 'ready' | 'failed', extra = '') => {
      $('a-status').dataset.state = state;
      $('a-status-text').textContent = `${L[state]}${extra ? ` · ${extra}` : ''}`;
    };
    const startClock = () => {
      t0 = performance.now();
      window.clearInterval(timer);
      timer = window.setInterval(() => setStatus('live', fmtMs(performance.now() - t0)), 100);
    };
    const stopClock = () => window.clearInterval(timer);

    // ------------------------------------------------------------ árvore ao vivo
    const open = new Set<string>(); // <details> abertos sobrevivem aos re-renders
    const details = (key: string, summary: string, body: HTMLElement) => {
      const d = el('details', 'st-details');
      d.open = open.has(key);
      d.addEventListener('toggle', () => (d.open ? open.add(key) : open.delete(key)));
      d.append(el('summary', '', summary), body);
      return d;
    };
    const dur = (from: number, to?: number) => (to === undefined ? '' : fmtMs(to - from));

    function stepNode(step: Step, node: AgentNode): HTMLElement {
      if (step.kind === 'llm') {
        const li = el('li', 'st st-llm');
        li.append(el('span', 'st-icon'));
        const body = el('div', 'st-body');
        const line = el('div', 'st-line');
        line.append(el('span', 'st-kind', 'LLM'));
        if (step.calls.length) {
          line.append(document.createTextNode(`${L.decided} `));
          step.calls.forEach((c, k) => {
            if (k) line.append(document.createTextNode(', '));
            line.append(
              el('code', '', c.startsWith(DELEGATE_PREFIX) ? agentLabel(c.slice(DELEGATE_PREFIX.length), lang) : toolLabel(c)),
            );
          });
        } else {
          line.append(document.createTextNode(step.stop === 'max_tokens' ? L.cutoff : L.wrote));
        }
        body.append(line);
        if (step.calls.length && step.text.trim()) body.append(el('p', 'st-thought', step.text.trim().slice(0, 400)));
        li.append(body);
        return li;
      }
      if (step.kind === 'error') {
        const li = el('li', 'st st-err');
        li.append(el('span', 'st-icon'), el('div', 'st-body', `${L.error}: ${step.message}`));
        return li;
      }
      if (step.child) {
        const li = el('li', 'st st-deleg');
        li.append(el('span', 'st-icon'));
        const body = el('div', 'st-body');
        const line = el('div', 'st-line');
        line.append(el('span', 'st-kind', L.delegated), el('strong', '', agentLabel(step.child.name, lang)));
        body.append(line, agentCard(step.child));
        li.append(body);
        return li;
      }
      const li = el('li', `st st-tool${step.failed ? ' is-failed' : ''}${step.result === undefined ? ' is-running' : ''}`);
      li.append(el('span', 'st-icon'));
      const body = el('div', 'st-body');
      const line = el('div', 'st-line');
      line.append(el('code', 'st-tool-name', toolLabel(step.tool)));
      const args = argsLine(step.args);
      if (args) line.append(el('span', 'st-args', args));
      const meta = el('span', 'st-meta');
      if (step.result === undefined) meta.append(el('span', 'spinner'));
      else meta.textContent = step.failed ? L.error : dur(step.startedAt, step.endedAt);
      line.append(meta);
      body.append(line);
      if (step.result !== undefined) body.append(details(`r${node.id}-${step.id}`, L.result, el('pre', 'st-pre', prettyResult(step.result))));
      li.append(body);
      return li;
    }

    function agentCard(n: AgentNode): HTMLElement {
      const card = el('div', `ag ag-${n.name}`);
      card.dataset.status = n.status;
      const head = el('div', 'ag-head');
      const who = el('div', 'ag-who');
      who.append(el('span', `avatar a-${n.name}`, agentLabel(n.name, lang)[0]), el('strong', '', agentLabel(n.name, lang)));
      const right = el('span', 'ag-state');
      if (n.status === 'running') right.append(el('span', 'spinner'), document.createTextNode(L.thinking));
      else right.textContent = dur(n.startedAt, n.endedAt);
      head.append(who, right);
      card.append(head);
      if (n.depth > 0 && n.task) card.append(el('p', 'ag-task', n.task));
      const ol = el('ol', 'ag-steps');
      for (const st of n.steps) ol.append(stepNode(st, n));
      if (ol.childElementCount) card.append(ol);
      if (n.depth > 0 && n.output) {
        const md = el('div', 'md md-small');
        renderMarkdown(md, n.output);
        card.append(details(`o${n.id}`, `${L.answerOf} ${agentLabel(n.name, lang)}`, md));
      }
      return card;
    }

    let state: RunState = newRun();
    let frame = 0;
    const renderTree = () => {
      frame = 0;
      $('a-tree').replaceChildren(...(state.root ? [agentCard(state.root)] : []));
    };
    const scheduleTree = () => {
      if (!frame) frame = requestAnimationFrame(renderTree);
    };

    // ------------------------------------------------------------ início e fim de uma execução
    let lastOutput = '';
    const begin = (question: string) => {
      state = newRun();
      open.clear();
      lastOutput = '';
      submit.disabled = true;
      sampleBtn.disabled = true;
      submit.textContent = L.running;
      for (const id of ['a-error', 'a-kpis', 'a-text', 'a-empty', 'a-trace', 'a-trace-wait', 'a-consult']) $(id).hidden = true;
      copyBtn.hidden = true;
      $('a-working').hidden = false;
      $('a-question').hidden = false;
      $('a-question').textContent = `“${question}”`;
      $('a-run').hidden = false;
      $('a-waterfall').replaceChildren();
      renderTree();
      startClock();
    };
    const finish = () => {
      stopClock();
      submit.disabled = false;
      sampleBtn.disabled = false;
      submit.textContent = L.run;
      $('a-working').hidden = true;
      renderTree();
    };
    const showDone = (sample: boolean) => {
      const d = state.done;
      if (!d) return;
      const c = runCounts(state);
      $('k-time').textContent = fmtMs(d.durationMs);
      $('k-tokens').textContent = nf.format(d.inputTokens + d.outputTokens);
      $('k-llm').textContent = String(c.llm);
      $('k-tools').textContent = String(c.tools);
      $('k-agents').textContent = String(c.agents);
      $('a-kpis').hidden = false;
      lastOutput = d.output;
      renderMarkdown($('a-text'), d.output);
      $('a-text').hidden = !d.output;
      copyBtn.hidden = !d.output;
      $('a-working').hidden = true;
      const ok = d.status === 'ok' || d.status === 'completed';
      setStatus(ok ? 'ready' : 'failed', sample ? L.sampleTag : fmtMs(d.durationMs));
      $('a-consult').replaceChildren(consultCta(s, lang));
      $('a-consult').hidden = false;
    };
    const onEvent = (event: string, data: unknown, at: number) => {
      applyEvent(state, event, data, at);
      if (event === 'done') {
        stopClock();
        showDone(false);
      }
      scheduleTree();
    };

    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(lastOutput);
        copyBtn.textContent = L.copied;
        window.setTimeout(() => (copyBtn.textContent = L.copy), 1500);
      } catch {
        /* sem permissão de clipboard: nada a fazer */
      }
    });

    // ------------------------------------------------------------ exemplo gravado
    sampleBtn.addEventListener('click', async () => {
      const run = sampleRun(lang);
      begin(run.question);
      const SLOW = 1.6; // um pouco mais devagar que a execução real, para dar para acompanhar
      let prev = 0;
      for (const e of run.events) {
        await new Promise((r) => setTimeout(r, (e.at - prev) * SLOW));
        prev = e.at;
        applyEvent(state, e.event, e.data, e.at);
        scheduleTree();
      }
      finish();
      showDone(true);
      $('a-trace').hidden = false;
      renderWaterfall($('a-waterfall'), run.spans, lang);
    });

    // ------------------------------------------------------------ execução de verdade
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const question = textarea.value.trim();
      if (!question) return;
      begin(question);
      let failed = false;
      try {
        const res = await fetch('/api/demo/agents/stream', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'content-type': 'application/json', accept: 'text/event-stream' },
          body: JSON.stringify({ question, servers: enabledServers() }),
        });
        if (!res.ok) throw await errorFrom(res);
        await readSse(res, (event, raw) => onEvent(event, raw, performance.now() - t0));
        if (!state.done) throw { status: 502 };
      } catch (err) {
        failed = true;
        $('a-error').hidden = false;
        $('a-error').textContent = liveError(err, s);
        setStatus('failed');
      } finally {
        finish();
        if (!failed && state.done) showDone(false);
      }
      const traceId = state.done?.traceId;
      if (!failed && traceId) {
        $('a-trace').hidden = false;
        $('a-trace-wait').hidden = false;
        $('a-trace-wait').textContent = L.traceWait;
        try {
          const spans = await fetchTrace<Span[]>(traceId);
          $('a-trace-wait').hidden = true;
          renderWaterfall($('a-waterfall'), spans, lang);
        } catch {
          $('a-trace-wait').textContent = L.traceMissing;
        }
      }
      await refreshGate();
    });

    void refreshGate();
  }
</script>

