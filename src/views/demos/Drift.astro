---
import DemoShell from '../../components/DemoShell.astro';
import type { Lang } from '../../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const pt = lang === 'pt';
const L = pt
  ? {
      scenario: 'Cenário de produção',
      scenarioHint: 'Escolha um caso ou ajuste à mão.',
      presets: ['Sem mudança', 'Clientes mais jovens', 'Público mais velho', 'Mais espalhado', 'Mudança forte'],
      mean: 'Média da idade',
      sd: 'Desvio padrão',
      reference: 'Treino: 4.000 clientes, média 35, desvio 11.',
      stable: 'Estável',
      moderate: 'Moderado',
      major: 'Grande',
      act_stable: 'Nada a fazer: o modelo vê clientes parecidos com os do treino.',
      act_moderate: 'Investigar: a população mudou um pouco. Vale olhar as métricas do modelo.',
      act_major: 'Retreinar: o modelo está vendo clientes diferentes dos que ele aprendeu.',
      chartTitle: 'Idade dos clientes: treino × produção',
      chartHint: 'No treino, cada faixa tem 10% dos clientes (a linha tracejada). As barras são a produção: quanto mais quente a cor, mais a faixa pesa no PSI.',
      curvesHint: 'A curva tracejada é o treino e a cheia, a produção. As faixas sombreadas são as que mais pesam no PSI.',
      viewBars: 'Faixas',
      viewCurves: 'Curvas',
      ofPsi: 'do PSI',
      tipRef: 'treino',
      tipCur: 'produção',
      tipContrib: 'contribuição',
      timeTitle: 'Semana a semana em produção',
      timeHint: 'Se o público mudar aos poucos até o cenário escolhido, é assim que o monitoramento vê o PSI subir.',
      week: 'semana',
      wk: 'S',
      firstWarn: 'Primeiro aviso',
      retrainAt: 'Retreino aberto',
      never: 'não acontece',
      finalPsi: 'PSI na semana 12',
      investigate: 'investigar',
      retrain: 'retreinar',
      tableSummary: 'Ver a tabela com os números de cada faixa',
      ref: 'Treino',
      cur: 'Produção',
      years: 'anos',
      tableTitle: 'De onde vem o PSI',
      tableHint: 'O PSI é a soma da coluna da direita.',
      bin: 'Faixa de idade',
      binShort: 'Idade',
      refPct: 'Treino',
      curPct: 'Produção',
      curShort: 'Prod.',
      contrib: 'Contribuição',
      contribShort: 'Contrib.',
      to: 'a',
      howTitle: 'Como o PSI funciona',
      train: 'treino',
      steps: [
        ['Fatiar o treino', 'A idade dos clientes do treino é dividida em 10 faixas com 10% dos clientes cada (os decis).'],
        ['Contar a produção', 'Os clientes que chegaram em produção são distribuídos nessas mesmas faixas.'],
        ['Somar a diferença', 'Cada faixa soma (produção − treino) × ln(produção ÷ treino). Faixa igual soma zero.'],
      ],
      rule: 'Regra usada no mercado e no mlops-platform',
      rules: [
        ['< 0,1', 'estável'],
        ['0,1 a 0,25', 'investigar'],
        ['> 0,25', 'retreinar'],
      ],
      inPlatform:
        'No mlops-platform essa conta roda para cada feature do modelo de crédito. Passou de 0,25, ele abre um retreino, e o modelo novo só substitui o campeão se ganhar nos critérios de qualidade e de justiça.',
    }
  : {
      scenario: 'Production scenario',
      scenarioHint: 'Pick a case or tune it by hand.',
      presets: ['No change', 'Younger customers', 'Older audience', 'More spread', 'Strong shift'],
      mean: 'Mean age',
      sd: 'Standard deviation',
      reference: 'Training: 4,000 customers, mean 35, sd 11.',
      stable: 'Stable',
      moderate: 'Moderate',
      major: 'Major',
      act_stable: 'Nothing to do: the model sees customers like the ones it was trained on.',
      act_moderate: 'Investigate: the population moved a bit. Check the model metrics.',
      act_major: "Retrain: the model is seeing customers unlike the ones it learned from.",
      chartTitle: 'Customer age: training × production',
      chartHint: 'In training every bin holds 10% of customers (the dashed line). Bars are production: the warmer the colour, the more the bin weighs in the PSI.',
      curvesHint: 'The dashed curve is training and the solid one, production. Shaded bins weigh most in the PSI.',
      viewBars: 'Bins',
      viewCurves: 'Curves',
      ofPsi: 'of the PSI',
      tipRef: 'training',
      tipCur: 'production',
      tipContrib: 'contribution',
      timeTitle: 'Week by week in production',
      timeHint: 'If the audience drifts gradually toward the chosen scenario, this is how monitoring sees the PSI climb.',
      week: 'week',
      wk: 'W',
      firstWarn: 'First warning',
      retrainAt: 'Retrain opened',
      never: "doesn't happen",
      finalPsi: 'PSI in week 12',
      investigate: 'investigate',
      retrain: 'retrain',
      tableSummary: 'See the table with each bin’s numbers',
      ref: 'Training',
      cur: 'Production',
      years: 'years',
      tableTitle: 'Where the PSI comes from',
      tableHint: 'The PSI is the sum of the right-hand column.',
      bin: 'Age bin',
      binShort: 'Age',
      refPct: 'Training',
      curPct: 'Production',
      curShort: 'Prod.',
      contrib: 'Contribution',
      contribShort: 'Contrib.',
      to: 'to',
      howTitle: 'How PSI works',
      train: 'train',
      steps: [
        ['Slice the training data', 'Training customer ages are split into 10 bins holding 10% of customers each (deciles).'],
        ['Count production', 'Customers arriving in production are placed into those same bins.'],
        ['Add up the gap', 'Each bin adds (production − training) × ln(production ÷ training). An unchanged bin adds zero.'],
      ],
      rule: 'Rule of thumb used in industry and in mlops-platform',
      rules: [
        ['< 0.1', 'stable'],
        ['0.1 to 0.25', 'investigate'],
        ['> 0.25', 'retrain'],
      ],
      inPlatform:
        'In mlops-platform this runs for every feature of the credit model. Above 0.25 it opens a retrain, and the new model only replaces the champion if it wins on quality and fairness criteria.',
    };
const presets: [number, number][] = [
  [35, 11],
  [29, 9],
  [44, 11],
  [35, 17],
  [50, 8],
];

// Medidor: meio círculo de 0 a 0,5, com as zonas da regra.
const cx = 110;
const cy = 104;
const r = 86;
const MAX = 0.5;
const pt2 = (v: number, rad = r) => {
  const a = Math.PI * (1 - Math.min(v, MAX) / MAX);
  return [cx + rad * Math.cos(a), cy - rad * Math.sin(a)];
};
const arc = (a: number, b: number) => {
  const [x1, y1] = pt2(a);
  const [x2, y2] = pt2(b);
  return `M ${x1.toFixed(2)} ${y1.toFixed(2)} A ${r} ${r} 0 0 1 ${x2.toFixed(2)} ${y2.toFixed(2)}`;
};
const zones = [
  { cls: 'z-stable', d: arc(0, 0.1) },
  { cls: 'z-moderate', d: arc(0.1, 0.25) },
  { cls: 'z-major', d: arc(0.25, MAX) },
];
const ticks = [0, 0.1, 0.25, 0.5].map((v) => {
  const [x, y] = pt2(v, r + 16);
  return { x: x.toFixed(1), y: y.toFixed(1), label: pt ? String(v).replace('.', ',') : String(v) };
});
---

<DemoShell lang={lang} demo="demoDrift">
  <div class="drift" id="drift" data-l={JSON.stringify(L)} data-lang={lang} data-presets={JSON.stringify(presets)}>
    <section class="panel controls">
      <h2>{L.scenario}</h2>
      <p class="hint">{L.scenarioHint}</p>
      <div class="chips" role="group" aria-label={L.scenario}>
        {
          L.presets.map((p, i) => (
            <button type="button" class="chip" data-preset={i} aria-pressed={i === 0 ? 'true' : 'false'}>
              {p}
            </button>
          ))
        }
      </div>
      <div class="field">
        <label for="mean"><span>{L.mean}</span><output id="mean-out" class="mono">35</output></label>
        <input id="mean" type="range" min="20" max="60" step="0.5" value="35" />
      </div>
      <div class="field">
        <label for="sd"><span>{L.sd}</span><output id="sd-out" class="mono">11</output></label>
        <input id="sd" type="range" min="4" max="25" step="0.5" value="11" />
      </div>
      <p class="hint ref-note"><span class="sw ref"></span>{L.reference}</p>
    </section>

    <section class="panel gauge-panel" aria-live="polite">
      <svg class="gauge" viewBox="0 0 220 128" role="img" aria-labelledby="psi-value">
        {zones.map((z) => <path class={`zone ${z.cls}`} d={z.d} />)}
        {
          ticks.map((tk) => (
            <text x={tk.x} y={tk.y} class="tick" text-anchor="middle">
              {tk.label}
            </text>
          ))
        }
        <line id="needle" class="needle" x1={cx} y1={cy} x2={cx - r + 12} y2={cy}></line>
        <circle class="hub" cx={cx} cy={cy} r="6"></circle>
      </svg>
      <div class="psi-num">
        <span class="psi-label mono">PSI</span>
        <span id="psi-value" class="psi-value mono">0,000</span>
      </div>
      <span id="sev" class="sev stable">{L.stable}</span>
      <p id="action" class="action">{L.act_stable}</p>
    </section>

    <section class="panel chart-panel">
      <div class="panel-head">
        <div>
          <h2>{L.chartTitle}</h2>
          <p class="hint" id="chart-hint">{L.chartHint}</p>
        </div>
        <div class="head-right">
          <div class="legend">
            <span><span class="sw ref"></span>{L.ref}</span>
            <span><span class="sw cur"></span>{L.cur}</span>
          </div>
          <div class="seg" role="group" aria-label={L.chartTitle}>
            <button type="button" data-view="bars" aria-pressed="true">{L.viewBars}</button>
            <button type="button" data-view="curves" aria-pressed="false">{L.viewCurves}</button>
          </div>
        </div>
      </div>
      <div id="view-bars" class="bars-wrap">
        <div id="bars" class="bars"></div>
        <div id="btip" class="btip" hidden></div>
      </div>
      <div id="view-curves" hidden>
        <svg id="chart" class="chart" viewBox="0 0 800 260" preserveAspectRatio="none" role="img" aria-label={L.chartTitle}>
          <g id="bands"></g>
          <path id="area-ref" class="area ref"></path>
          <path id="area-cur" class="area cur"></path>
          <path id="line-ref" class="line ref"></path>
          <path id="line-cur" class="line cur"></path>
        </svg>
        <div id="axis" class="axis mono"></div>
      </div>
    </section>

    <section class="panel time-panel">
      <div class="panel-head">
        <div>
          <h2>{L.timeTitle}</h2>
          <p class="hint">{L.timeHint}</p>
        </div>
      </div>
      <div class="kpis">
        <div class="kpi"><span class="kpi-label">{L.firstWarn}</span><span class="kpi-value mono" id="k-warn"></span></div>
        <div class="kpi"><span class="kpi-label">{L.retrainAt}</span><span class="kpi-value mono" id="k-retrain"></span></div>
        <div class="kpi"><span class="kpi-label">{L.finalPsi}</span><span class="kpi-value mono" id="k-final"></span></div>
      </div>
      <svg id="timeline" class="timeline" viewBox="0 0 800 230" role="img" aria-label={L.timeTitle}></svg>
    </section>

    <details class="panel table-panel">
      <summary>{L.tableSummary}</summary>
      <p class="hint">{L.tableHint}</p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th><span class="long">{L.bin}</span><span class="short">{L.binShort}</span></th><th class="num">{L.refPct}</th><th class="num"><span class="long">{L.curPct}</span><span class="short">{L.curShort}</span></th><th><span class="long">{L.contrib}</span><span class="short">{L.contribShort}</span></th></tr>
          </thead>
          <tbody id="rows"></tbody>
          <tfoot>
            <tr><td colspan="3">PSI</td><td class="mono" id="sum"></td></tr>
          </tfoot>
        </table>
      </div>
    </details>

    <section class="how">
      <h2>{L.howTitle}</h2>
      <ol class="steps">
        {
          L.steps.map(([title, text], i) => (
            <li class="panel step">
              <span class="step-n mono">{i + 1}</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </li>
          ))
        }
      </ol>
      <div class="panel formula-panel">
        <p class="formula mono">PSI = Σ (p<sub>prod</sub> − p<sub>{L.train}</sub>) · ln(p<sub>prod</sub> / p<sub>{L.train}</sub>)</p>
        <div class="rules">
          <span class="rules-title">{L.rule}</span>
          {
            L.rules.map(([v, label], i) => (
              <span class={`rule r${i}`}>
                <b class="mono">{v}</b> {label}
              </span>
            ))
          }
        </div>
        <p class="platform">{L.inPlatform}</p>
      </div>
    </section>
  </div>
</DemoShell>

<script>
  import { density, normal, psiNumeric, severity, type Binned } from '../../lib/psi';

  const root = document.getElementById('drift');
  if (root) {
    const L = JSON.parse(root.dataset.l!) as Record<string, string>;
    const presets = JSON.parse(root.dataset.presets!) as [number, number][];
    const pt = root.dataset.lang === 'pt';
    const fmt = (v: number, d = 3) =>
      new Intl.NumberFormat(pt ? 'pt-BR' : 'en', { minimumFractionDigits: d, maximumFractionDigits: d }).format(v);
    const pct = (v: number) => new Intl.NumberFormat(pt ? 'pt-BR' : 'en', { style: 'percent', maximumFractionDigits: 1 }).format(v);
    const reference = normal(4000, 35, 11, 7);
    const refSample = reference.slice(0, 1500); // a curva só precisa de uma amostra
    const mean = document.getElementById('mean') as HTMLInputElement;
    const sd = document.getElementById('sd') as HTMLInputElement;
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-preset]')];
    const NS = 'http://www.w3.org/2000/svg';
    const W = 800;
    const H = 260;
    const PAD = 10;
    let frame = 0;

    function path(xs: number[], ys: number[], sx: (x: number) => number, sy: (y: number) => number, close: boolean) {
      let d = xs.map((x, i) => `${i ? 'L' : 'M'}${sx(x).toFixed(1)} ${sy(ys[i]).toFixed(1)}`).join(' ');
      if (close) d += ` L${sx(xs[xs.length - 1]).toFixed(1)} ${H} L${sx(xs[0]).toFixed(1)} ${H} Z`;
      return d;
    }

    function draw() {
      const m = Number(mean.value);
      const s = Number(sd.value);
      document.getElementById('mean-out')!.textContent = `${fmt(m, 1)} ${L.years}`;
      document.getElementById('sd-out')!.textContent = fmt(s, 1);
      chips.forEach((c, i) => c.setAttribute('aria-pressed', String(presets[i][0] === m && presets[i][1] === s)));

      const current = normal(4000, m, s, 11);
      const b = psiNumeric(reference, current);
      const sev = severity(b.psi);

      // Medidor
      // O ponteiro nasce apontando para o 0 e gira (em CSS, com transição) até o valor.
      const v = Math.min(b.psi, 0.5);
      document.getElementById('needle')!.style.transform = `rotate(${((v / 0.5) * 180).toFixed(2)}deg)`;
      document.getElementById('psi-value')!.textContent = fmt(b.psi);
      const sevEl = document.getElementById('sev')!;
      sevEl.textContent = L[sev];
      sevEl.className = `sev ${sev}`;
      root!.dataset.sev = sev;
      document.getElementById('action')!.textContent = L[`act_${sev}`];

      // Curvas
      const lo = Math.max(0, Math.min(35 - 3.2 * 11, m - 3.2 * s));
      const hi = Math.max(35 + 3.2 * 11, m + 3.2 * s);
      const xs = Array.from({ length: 140 }, (_, i) => lo + ((hi - lo) * i) / 139);
      const dRef = density(refSample, xs);
      const dCur = density(current.slice(0, 1500), xs);
      const top = Math.max(...dRef, ...dCur) * 1.08;
      const sx = (x: number) => ((x - lo) / (hi - lo)) * W;
      const sy = (y: number) => H - (y / top) * (H - PAD);
      document.getElementById('area-ref')!.setAttribute('d', path(xs, dRef, sx, sy, true));
      document.getElementById('area-cur')!.setAttribute('d', path(xs, dCur, sx, sy, true));
      document.getElementById('line-ref')!.setAttribute('d', path(xs, dRef, sx, sy, false));
      document.getElementById('line-cur')!.setAttribute('d', path(xs, dCur, sx, sy, false));

      // Faixas do PSI, pintadas pela contribuição
      const maxC = Math.max(...b.contrib, 1e-9);
      const bands = document.getElementById('bands')!;
      bands.replaceChildren(
        ...b.contrib.map((c, i) => {
          const x0 = sx(Math.max(b.edges[i], lo));
          const x1 = sx(Math.min(b.edges[i + 1], hi));
          const g = document.createElementNS(NS, 'g');
          const rect = document.createElementNS(NS, 'rect');
          rect.setAttribute('x', x0.toFixed(1));
          rect.setAttribute('y', '0');
          rect.setAttribute('width', Math.max(0, x1 - x0).toFixed(1));
          rect.setAttribute('height', String(H));
          rect.setAttribute('class', 'band');
          rect.setAttribute('fill-opacity', (b.psi < 0.02 || c / maxC < 0.3 ? 0 : (c / maxC) * 0.18).toFixed(3));
          const sep = document.createElementNS(NS, 'line');
          sep.setAttribute('x1', x1.toFixed(1));
          sep.setAttribute('x2', x1.toFixed(1));
          sep.setAttribute('y1', '0');
          sep.setAttribute('y2', String(H));
          sep.setAttribute('class', 'sep');
          g.append(rect, sep);
          return g;
        }),
      );

      // Eixo em HTML (texto não deforma com o SVG esticado)
      const axis = document.getElementById('axis')!;
      const step = hi - lo > 60 ? 20 : 10;
      const labels = [];
      for (let t = Math.ceil(lo / step) * step; t <= hi; t += step) {
        const span = document.createElement('span');
        span.textContent = String(t);
        span.style.left = `${(sx(t) / W) * 100}%`;
        labels.push(span);
      }
      axis.replaceChildren(...labels);

      // Tabela
      const rows = document.getElementById('rows')!;
      rows.replaceChildren(
        ...b.contrib.map((c, i) => {
          const tr = document.createElement('tr');
          const from = b.edges[i] === -Infinity ? '' : fmt(b.edges[i], 0);
          const to = b.edges[i + 1] === Infinity ? '' : fmt(b.edges[i + 1], 0);
          const label = !from ? `< ${to}` : !to ? `≥ ${from}` : `${from} ${L.to} ${to}`;
          const cells = [label, pct(b.reference[i]), pct(b.current[i])];
          cells.forEach((text, k) => {
            const td = document.createElement('td');
            td.textContent = text;
            if (k > 0) td.className = 'num mono';
            tr.append(td);
          });
          const td = document.createElement('td');
          td.className = 'contrib';
          const bar = document.createElement('span');
          bar.className = 'cbar';
          bar.style.width = `${(c / maxC) * 100}%`;
          const val = document.createElement('span');
          val.className = 'mono';
          val.textContent = fmt(c);
          td.append(bar, val);
          tr.append(td);
          if (b.psi >= 0.02 && c === maxC) tr.className = 'top';
          return tr;
        }),
      );
      document.getElementById('sum')!.textContent = fmt(b.psi);

      drawBars(b);
      drawTimeline(m, s);
    }

    // ---------------------------------------------------------------- barras por faixa
    const binLabel = (b: Binned, i: number, short = false) => {
      const from = b.edges[i] === -Infinity ? '' : fmt(b.edges[i], 0);
      const to = b.edges[i + 1] === Infinity ? '' : fmt(b.edges[i + 1], 0);
      if (!from) return `< ${to}`;
      if (!to) return `≥ ${from}`;
      return short ? from : `${from}–${to}`;
    };
    const level = (c: number) => (c < 0.002 ? 0 : c < 0.01 ? 1 : c < 0.03 ? 2 : 3);
    const barsEl = document.getElementById('bars')!;
    const btip = document.getElementById('btip')!;
    let cols: { col: HTMLElement; pval: HTMLElement; bar: HTMLElement; ref: HTMLElement; clabel: HTMLElement; label: HTMLElement }[] = [];
    let lastBins: Binned | null = null;

    function showTip(i: number) {
      const b = lastBins;
      if (!b || i < 0) {
        btip.hidden = true;
        cols.forEach((c) => c.col.classList.remove('hot'));
        return;
      }
      cols.forEach((c, k) => c.col.classList.toggle('hot', k === i));
      const share = b.psi > 0 ? b.contrib[i] / b.psi : 0;
      const title = document.createElement('strong');
      title.textContent = `${binLabel(b, i)} ${L.years}`;
      const lines = [
        `${L.tipRef}: ${pct(b.reference[i])}`,
        `${L.tipCur}: ${pct(b.current[i])}`,
        `${L.tipContrib}: ${fmt(b.contrib[i])} (${pct(share)} ${L.ofPsi})`,
      ].map((t) => {
        const span = document.createElement('span');
        span.textContent = t;
        return span;
      });
      btip.replaceChildren(title, ...lines);
      btip.hidden = false;
      const col = cols[i].col;
      const left = col.offsetLeft + col.offsetWidth / 2;
      btip.style.left = `${left}px`;
      btip.classList.toggle('flip', left > barsEl.clientWidth * 0.6);
      btip.classList.toggle('flip-l', left < barsEl.clientWidth * 0.2);
    }

    function drawBars(b: Binned) {
      lastBins = b;
      if (cols.length !== b.contrib.length) {
        cols = b.contrib.map((_, i) => {
          const col = document.createElement('button');
          col.type = 'button';
          col.className = 'col';
          const pval = document.createElement('span');
          pval.className = 'pval mono';
          const well = document.createElement('span');
          well.className = 'well';
          const ref = document.createElement('span');
          ref.className = 'refline';
          const bar = document.createElement('span');
          bar.className = 'bar';
          well.append(bar, ref);
          const clabel = document.createElement('span');
          clabel.className = 'clabel mono';
          const label = document.createElement('span');
          label.className = 'blabel mono';
          col.append(pval, well, clabel, label);
          col.addEventListener('mouseenter', () => showTip(i));
          col.addEventListener('focus', () => showTip(i));
          col.addEventListener('click', () => showTip(i));
          return { col, pval, bar, ref, clabel, label };
        });
        barsEl.replaceChildren(...cols.map((c) => c.col));
        barsEl.addEventListener('mouseleave', () => showTip(-1));
      }
      const top = Math.max(...b.current, ...b.reference) * 1.12;
      const narrow = barsEl.clientWidth < 520;
      b.contrib.forEach((c, i) => {
        const k = cols[i];
        k.pval.textContent = pct(b.current[i]);
        k.bar.style.height = `${(b.current[i] / top) * 100}%`;
        k.ref.style.bottom = `${(b.reference[i] / top) * 100}%`;
        k.col.dataset.lv = String(level(c));
        k.clabel.textContent = c >= 0.001 ? `+${fmt(c)}` : '·';
        k.label.textContent = binLabel(b, i, narrow);
        k.col.setAttribute('aria-label', `${binLabel(b, i)}: ${L.tipRef} ${pct(b.reference[i])}, ${L.tipCur} ${pct(b.current[i])}, ${L.tipContrib} ${fmt(c)}`);
      });
      if (!btip.hidden) showTip(cols.findIndex((c) => c.col.classList.contains('hot')));
    }

    // ---------------------------------------------------------------- semana a semana
    const WEEKS = 12;
    const timeline = document.getElementById('timeline') as unknown as SVGSVGElement;
    const weeklyCache = new Map<string, number[]>();
    function weekly(m: number, s: number): number[] {
      const key = `${m}|${s}`;
      let out = weeklyCache.get(key);
      if (!out) {
        // O público anda em linha reta do treino (35, 11) até o cenário escolhido.
        out = Array.from({ length: WEEKS }, (_, w) => {
          const t = (w + 1) / WEEKS;
          return psiNumeric(reference, normal(2000, 35 + (m - 35) * t, 11 + (s - 11) * t, 100 + w)).psi;
        });
        if (weeklyCache.size > 40) weeklyCache.clear();
        weeklyCache.set(key, out);
      }
      return out;
    }
    const svgEl = (tag: string, attrs: Record<string, string | number>, text?: string) => {
      const e = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
      if (text !== undefined) e.textContent = text;
      return e;
    };
    let lastTimeline: [number, number] = [35, 11];

    function drawTimeline(m: number, s: number) {
      lastTimeline = [m, s];
      const psis = weekly(m, s);
      const Wt = Math.max(timeline.clientWidth, 280);
      const Ht = 230;
      timeline.setAttribute('viewBox', `0 0 ${Wt} ${Ht}`);
      const pl = 44;
      const pr = Wt < 480 ? 12 : 92;
      const ptop = 12;
      const pb = 28;
      // Eixo até 0,6 no máximo: acima disso o ponto fica no topo, vazado (o valor está no card e na dica).
      const top = Math.min(0.6, Math.max(0.32, Math.max(...psis) * 1.15));
      const x = (w: number) => pl + (w / (WEEKS - 1)) * (Wt - pl - pr);
      const y = (v: number) => ptop + (1 - Math.min(v, top) / top) * (Ht - ptop - pb);
      const nodes: Element[] = [];
      // Zonas da regra
      [
        [0, 0.1, 'zs'],
        [0.1, 0.25, 'zm'],
        [0.25, top, 'zj'],
      ].forEach(([a, b2, cls]) =>
        nodes.push(svgEl('rect', { x: pl, y: y(b2 as number), width: Wt - pl - pr, height: y(a as number) - y(b2 as number), class: `tz ${cls}` })),
      );
      for (const [v, label] of [
        [0.1, L.investigate],
        [0.25, L.retrain],
      ] as const) {
        nodes.push(svgEl('line', { x1: pl, x2: Wt - pr, y1: y(v), y2: y(v), class: `tline t${v === 0.1 ? 'm' : 'j'}` }));
        nodes.push(svgEl('text', { x: pl - 6, y: y(v) + 4, class: 'tick-l', 'text-anchor': 'end' }, fmt(v, v === 0.1 ? 1 : 2)));
        if (pr > 40) nodes.push(svgEl('text', { x: Wt - pr + 8, y: y(v) + 4, class: `tlabel t${v === 0.1 ? 'm' : 'j'}` }, label));
      }
      nodes.push(svgEl('text', { x: pl - 6, y: y(0) + 4, class: 'tick-l', 'text-anchor': 'end' }, '0'));
      // Semanas
      psis.forEach((_, w) => {
        if (Wt < 480 && w % 2 === 1) return;
        nodes.push(svgEl('text', { x: x(w), y: Ht - 8, class: 'tick-l', 'text-anchor': 'middle' }, `${L.wk}${w + 1}`));
      });
      // Área e linha
      const line = psis.map((v, w) => `${w ? 'L' : 'M'}${x(w).toFixed(1)} ${y(v).toFixed(1)}`).join(' ');
      nodes.push(svgEl('path', { d: `${line} L${x(WEEKS - 1).toFixed(1)} ${y(0)} L${x(0).toFixed(1)} ${y(0)} Z`, class: 'tarea' }));
      nodes.push(svgEl('path', { d: line, class: 'tpath' }));
      // Marcos: primeiro aviso e retreino
      const warn = psis.findIndex((v) => v >= 0.1);
      const retrain = psis.findIndex((v) => v >= 0.25);
      if (retrain >= 0) nodes.push(svgEl('line', { x1: x(retrain), x2: x(retrain), y1: ptop, y2: Ht - pb, class: 'tmark' }));
      psis.forEach((v, w) => {
        const c = svgEl('circle', { cx: x(w).toFixed(1), cy: y(v).toFixed(1), r: w === retrain || w === warn ? 6 : 4, class: `tdot ${severity(v)}${v > top ? ' clip' : ''}` });
        c.append(svgEl('title', {}, `${L.week} ${w + 1}: PSI ${fmt(v)}`));
        nodes.push(c);
      });
      timeline.replaceChildren(...nodes);
      document.getElementById('k-warn')!.textContent = warn >= 0 ? `${L.week} ${warn + 1}` : L.never;
      document.getElementById('k-retrain')!.textContent = retrain >= 0 ? `${L.week} ${retrain + 1}` : L.never;
      const fin = document.getElementById('k-final')!;
      fin.textContent = fmt(psis[WEEKS - 1]);
      fin.className = `kpi-value mono ${severity(psis[WEEKS - 1])}`;
    }
    new ResizeObserver(() => {
      drawTimeline(...lastTimeline);
      if (lastBins) drawBars(lastBins);
    }).observe(timeline);

    // Alternar barras × curvas
    const views = [...root.querySelectorAll<HTMLButtonElement>('[data-view]')];
    views.forEach((btn) =>
      btn.addEventListener('click', () => {
        const curves = btn.dataset.view === 'curves';
        views.forEach((v) => v.setAttribute('aria-pressed', String(v === btn)));
        document.getElementById('view-bars')!.hidden = curves;
        document.getElementById('view-curves')!.hidden = !curves;
        document.getElementById('chart-hint')!.textContent = curves ? L.curvesHint : L.chartHint;
      }),
    );

    const schedule = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(draw);
    };
    mean.addEventListener('input', schedule);
    sd.addEventListener('input', schedule);
    chips.forEach((c, i) =>
      c.addEventListener('click', () => {
        mean.value = String(presets[i][0]);
        sd.value = String(presets[i][1]);
        schedule();
      }),
    );
    draw();
  }
</script>

