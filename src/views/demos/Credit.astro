const groups = [
  { key: 'loan', title: pt ? 'O pedido' : 'The request' },
  { key: 'money', title: pt ? 'Situação financeira' : 'Finances' },
  { key: 'person', title: pt ? 'Sobre a pessoa' : 'About the person' },
];
const { kpis, how, ...plain } = L;
const client = { ...plain, groups };
---

<DemoShell lang={lang} demo="demoCredit">
  <div class="credit" id="credit" data-lang={lang} data-s={JSON.stringify(s)} data-l={JSON.stringify(client)} data-login={route('login', lang)}>
    <section class="panel intro">
      <div>
        <h2>{L.introTitle}</h2>
        <p class="hint">{L.introText}</p>
      </div>
      <div class="kpis">
        {
          kpis.map(([v, label]) => (
            <div class="kpi">
              <span class="kpi-v mono">{v}</span>
              <span class="kpi-l">{label}</span>
            </div>
          ))
        }
      </div>
    </section>

    <p class="notice" data-gate>…</p>

    <div class="live" data-live hidden>
      <div class="topbar">
        <div class="tabs" role="tablist">
          <button type="button" role="tab" class="tab" id="tab-live" aria-selected="true" aria-controls="panel-live">{L.tabLive}</button>
          <button type="button" role="tab" class="tab" id="tab-batch" aria-selected="false" aria-controls="panel-batch">{L.tabBatch}</button>
        </div>
        <span class="quota mono" data-remaining></span>
      </div>

      <div id="panel-live" role="tabpanel" aria-labelledby="tab-live" class="mode">
        <div class="collect-grid">
          <section class="panel collect">
            <div class="panel-head">
              <div>
                <h2>{L.collectTitle}</h2>
                <p class="hint">{L.collectHint}</p>
              </div>
              <div class="seg" role="group" aria-label={L.collectTitle}>
                <button type="button" class="seg-btn" data-mode="chat" aria-pressed="true">{L.chat}</button>
                <button type="button" class="seg-btn" data-mode="form" aria-pressed="false">{L.form}</button>
              </div>
            </div>
            <div class="presets">
              <span class="hint small">{L.presets}</span>
              <button type="button" class="chip" data-preset="low">{L.presetLow}</button>
              <button type="button" class="chip" data-preset="high">{L.presetHigh}</button>
              <button type="button" class="chip ghost" id="clear">{L.clear}</button>
            </div>

            <div class="chat" id="chat">
              <div class="chat-head">
                <span class="avatar" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><rect x="4" y="7" width="16" height="12" rx="4"></rect><path d="M12 3v4M9 13h.01M15 13h.01"></path></svg>
                </span>
                <div class="chat-id">
                  <strong>{L.agentName}</strong>
                  <span class="agent-status on" id="agent-status"><span class="status-dot"></span><span id="agent-status-text">{L.agentOn}</span></span>
                </div>
                <div class="chat-progress">
                  <span class="mono small" id="chat-step"></span>
                  <span class="chat-bar"><span id="chat-bar"></span></span>
                </div>
              </div>
              <ol class="msgs" id="msgs" aria-live="polite"></ol>
              <div class="chips" id="chips"></div>
              <form class="chat-input" id="chat-form" autocomplete="off">
                <input id="chat-text" maxlength="120" placeholder={L.placeholder} aria-label={L.placeholder} />
                <button class="send" type="submit" aria-label={L.send} title={L.send}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg>
                </button>
              </form>
            </div>
            <details class="fx-note">
              <summary><span class="fx-badge mono">{L.fxBadge}</span> {L.fxTitle}</summary>
              <p>{L.fxText}</p>
            </details>

            <form class="guided" id="guided" hidden>
              {
                groups.map((g) => (
                  <fieldset>
                    <legend>{g.title}</legend>
                    <div class="grid-form">
                      {FIELDS.filter((f) => f.group === g.key).map((f) => (
                        <div class="field">
                          <label for={`f-${f.name}`}>{f.currency ? `${f.label[lang]} (${L.formCurrency})` : f.label[lang]}</label>
                          {f.kind === 'cat' ? (
                            <select id={`f-${f.name}`} name={f.name}>
                              <option value="">— {L.dontKnow} —</option>
                              {f.options!.map((op) => (
                                <option value={op.value}>{op.label[lang]}</option>
                              ))}
                            </select>
                          ) : (
                            <input
                              id={`f-${f.name}`}
                              name={f.name}
                              type="number"
                              inputmode={f.kind === 'int' ? 'numeric' : 'decimal'}
                              step={f.kind === 'int' ? '1' : 'any'}
                              min={f.minExclusive ? undefined : f.min}
                              max={f.max}
                              placeholder={L.dontKnow}
                            />
                          )}
                        </div>
                      ))}
                    </div>
                  </fieldset>
                ))
              }
            </form>
          </section>

          <aside class="panel profile" id="profile">
            <div class="profile-head">
              <svg class="ring" viewBox="0 0 44 44" aria-hidden="true">
                <circle class="ring-track" cx="22" cy="22" r="18"></circle>
                <circle class="ring-fill" id="ring" cx="22" cy="22" r="18" stroke-dasharray="0 113.1" transform="rotate(-90 22 22)"></circle>
              </svg>
              <div>
                <h2>{L.profile}</h2>
                <p class="hint small mono" id="count"></p>
              </div>
            </div>
            <div id="summary" class="summary"></div>
            <div class="run">
              <button class="btn primary" type="button" id="run">{L.run}</button>
              <span class="hint small" id="imputed"></span>
            </div>
            <p class="hint small">{L.agentNote}</p>
          </aside>
        </div>

        <p class="notice error" id="live-error" hidden></p>

        <section class="panel pipe" id="pipe" hidden>
          <div class="panel-head">
            <div>
              <h2>{L.pipeTitle}</h2>
              <p class="hint">{L.pipeHint}</p>
            </div>
            <div class="kpi compact">
              <span class="kpi-v mono" id="total-ms">0 ms</span>
              <span class="kpi-l">{L.onServer}</span>
            </div>
          </div>
          <ol class="rail" id="rail">
            {
              STAGES.map((id, i) => (
                <li class="rail-step" data-stage={id}>
                  <span class="rail-dot mono">{i + 1}</span>
                  <span class="rail-label">{L.stages[id]}</span>
                </li>
              ))
            }
          </ol>
          <ol class="stages" id="stages"></ol>
        </section>

        <section class="panel result" id="result" hidden>
          <div class="gauge-box">
            <svg id="gauge" class="gauge" viewBox="0 0 220 134" role="img" aria-labelledby="prob-value"></svg>
            <span class="kpi-l">{L.prob}</span>
            <span class="prob mono" id="prob-value"></span>
            <span class="badge-dec" id="decision"></span>
          </div>
          <div class="result-side">
            <div class="panel-head">
              <div>
                <h2>{L.resultTitle}</h2>
                <p class="hint">{L.resultHint}</p>
              </div>
            </div>
            <div class="kpis" id="result-kpis"></div>
            <h3 class="sub">{L.top}</h3>
            <div id="result-top"></div>
          </div>
        </section>
      </div>

      <div id="panel-batch" role="tabpanel" aria-labelledby="tab-batch" class="mode" hidden>
        <section class="panel bstep">
          <span class="step-n mono">1</span>
          <div class="bstep-body">
            <h2>{L.step1}</h2>
            <p class="hint">{L.step1Hint}</p>
            <div class="actions">
              <button class="btn" type="button" data-sample="valid">{L.valid}</button>
              <button class="btn" type="button" data-sample="errors">{L.withErrors}</button>
            </div>
            <details>
              <summary>{L.schema}</summary>
              <p class="hint small">{L.schemaNote}</p>
              <div class="table-wrap">
                <table class="schema">
                  <tbody>
                    {
                      FIELDS.map((f) => (
                        <tr>
                          <td class="mono">{f.name}</td>
                          <td>
                            {f.kind === 'cat'
                              ? f.options!.map((op) => op.value).join(' · ')
                              : `${f.kind === 'int' ? (pt ? 'inteiro' : 'integer') : pt ? 'número' : 'number'} ${f.minExclusive ? '>' : ''}${f.min}–${f.max}`}
                          </td>
                        </tr>
                      ))
                    }
                  </tbody>
                </table>
              </div>
            </details>
          </div>
        </section>

        <section class="panel bstep">
          <span class="step-n mono">2</span>
          <div class="bstep-body">
            <h2>{L.step2}</h2>
            <p class="hint">{L.batchNote}</p>
            <div class="upload">
              <div class="field">
                <label for="file">{L.choose}</label>
                <input id="file" type="file" accept=".csv,text/csv" />
              </div>
              <button class="btn primary" type="button" id="validate">{L.validate}</button>
            </div>
            <p class="notice error" id="batch-error" hidden></p>
            <div id="report" class="report" hidden></div>
          </div>
        </section>

        <section class="panel bstep" id="score-step" hidden>
          <span class="step-n mono">3</span>
          <div class="bstep-body">
            <h2>{L.step3}</h2>
            <p class="hint">{L.step3Hint}</p>
            <div class="actions">
              <button class="btn primary" type="button" id="score"></button>
            </div>
            <div id="scored" class="report" hidden></div>
          </div>
        </section>
      </div>
    </div>

    <section class="how">
      <h2>{L.howTitle}</h2>
      <ol class="steps">
        {
          how.map(([title, text], i) => (
            <li class="panel step">
              <span class="step-n mono">{i + 1}</span>
              <div>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="hint small note">{L.note}</p>
    </section>
  </div>
</DemoShell>

<script>
  import { errorFrom, liveError, readSse, type ApiError } from '../../lib/api';
  import {
    FIELD,
    FIELDS,
    MAX_FILE_BYTES,
    PRESETS,
    STAGES,
    afterGate,
    askBetween,
    brl,
    label,
    narrow,
    nextField,
    num,
    parseAnswer,
    pct,
    pipelineBody,
    pp,
    readAgent,
    sampleCsv,
    show,
    type AgentRead,
    type AgentReply,
    type Draft,
    type Field,
    type Lang,
    type StageId,
    type Value,
  } from '../../lib/credit';
  import { arcPath, diverging, histogram, logOddsDomain, polar, sigmoidPath, sigmoidScale, zPos } from '../../lib/creditCharts';
  import { gate } from '../../lib/live';

  type Dict = Record<string, unknown>;
  type Strings = Record<string, string> & {
    stages: Record<StageId, string>;
    stageHints: Record<StageId, string>;
    types: Record<string, string>;
    groups: { key: string; title: string }[];
  };

  const root = document.getElementById('credit');
  if (root) {
    const lang = root.dataset.lang as Lang;
    const s = JSON.parse(root.dataset.s!) as Record<string, string>;
    const L = JSON.parse(root.dataset.l!) as Strings;
    const $ = <E extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as E;
    const NS = 'http://www.w3.org/2000/svg';

    function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', text?: string | number): HTMLElementTagNameMap[K] {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text !== undefined) e.textContent = String(text);
      return e;
    }
    function svg(tag: string, attrs: Record<string, string | number>, text?: string): SVGElement {
      const e = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
      if (text !== undefined) e.textContent = text;
      return e;
    }
    function table(head: string[], rows: (string | number | Node)[][], cls = ''): HTMLElement {
      const wrap = el('div', 'table-wrap');
      const t = el('table', cls);
      const tr = el('tr');
      head.forEach((h) => tr.append(el('th', '', h)));
      t.append(el('thead'));
      t.tHead!.append(tr);
      const body = el('tbody');
      for (const r of rows) {
        const row = el('tr');
        for (const c of r) {
          const td = el('td');
          if (c instanceof Node) td.append(c);
          else td.textContent = String(c);
          row.append(td);
        }
        body.append(row);
      }
      t.append(body);
      wrap.append(t);
      return wrap;
    }
    const code = (text: string) => el('code', '', text);
    /** Faixa de KPIs: [valor, rótulo, classe opcional]. */
    function kpis(items: [string | number, string, string?][]): HTMLElement {
      const box = el('div', 'kpis');
      for (const [v, l, cls] of items) {
        const k = el('div', `kpi ${cls ?? ''}`.trim());
        k.append(el('span', 'kpi-v mono', v), el('span', 'kpi-l', l));
        box.append(k);
      }
      return box;
    }
    const sub = (text: string) => el('h3', 'sub', text);
    /** Barras divergentes de impacto (p.p.): direita aumenta o risco, esquerda reduz. */
    function impactChart(items: { name: string; value: Value; reference?: Value; impact: number }[]): HTMLElement {
      const max = Math.max(...items.map((f) => Math.abs(f.impact)), 1e-9);
      const box = el('div', 'impacts');
      const legend = el('div', 'legend');
      const l1 = el('span');
      l1.append(el('span', 'sw down'), L.lowered);
      const l2 = el('span');
      l2.append(el('span', 'sw up'), L.raised);
      legend.append(l1, l2);
      box.append(legend);
      for (const f of items) {
        const row = el('div', 'imp');
        const name = el('div', 'imp-name');
        name.append(el('strong', '', label(f.name, lang)), el('span', 'hint small', ` ${show(f.name, f.value, lang)}${f.reference !== undefined ? ` · ${L.typical}: ${show(f.name, f.reference, lang)}` : ''}`));
        const track = el('div', 'imp-track');
        const bar = el('span', f.impact > 0 ? 'imp-bar up' : 'imp-bar down');
        const g = diverging(f.impact, max);
        bar.style.left = `${g.left}%`;
        bar.style.width = `${Math.max(g.width, 0.6)}%`;
        track.append(el('span', 'imp-zero'), bar);
        row.append(name, el('span', `imp-val mono ${f.impact > 0 ? 'up' : 'down'}`, pp(f.impact, lang)), track);
        box.append(row);
      }
      return box;
    }

    let canSpend = false;
    const spendButtons = () => [$<HTMLButtonElement>('run'), $<HTMLButtonElement>('score')];
    async function refreshGate() {
      const g = await gate(root!, 'score', s);
      const after = afterGate(Boolean(g.me?.user), g.ready);
      root!.querySelector<HTMLElement>('[data-live]')!.hidden = !after.showLive;
      canSpend = after.canSpend;
      spendButtons().forEach((b) => (b.disabled = !canSpend));
    }

    // ------------------------------------------------------------ abas
    const tabs = { live: $('tab-live'), batch: $('tab-batch') };
    const panels = { live: $('panel-live'), batch: $('panel-batch') };
    (Object.keys(tabs) as (keyof typeof tabs)[]).forEach((k) =>
      tabs[k].addEventListener('click', () => {
        for (const other of Object.keys(tabs) as (keyof typeof tabs)[]) {
          tabs[other].setAttribute('aria-selected', String(other === k));
          panels[other].hidden = other !== k;
        }
      }),
    );

    // ------------------------------------------------------------ perfil (compartilhado por conversa e formulário)
    let draft: Draft = {};
    let mode: 'chat' | 'form' = 'chat';
    const msgs = $('msgs');
    const chips = $('chips');
    const chatText = $<HTMLInputElement>('chat-text');
    const sendBtn = root.querySelector<HTMLButtonElement>('#chat-form .send')!;
    const guided = $<HTMLFormElement>('guided');

    // ------------------------------------------------------------ conversa
    /** De onde veio cada leitura: chip, regras do navegador ou o microagente (LLM pequeno no portal). */
    type Source = 'option' | 'rules' | 'llm';
    const SOURCE: Record<Source, string> = { option: L.srcOption, rules: L.srcRules, llm: L.srcLlm };
    /** Opções da pergunta de volta ("Carro novo ou carro usado?"); null fora dela. */
    let pendingAsk: string[] | null = null;
    let agentOn = true;
    let busy = false;
    /** Muda a cada recomeço/correção: resposta do agente que chega depois disso é descartada. */
    let convo = 0;

    const scrollDown = () => (msgs.scrollTop = msgs.scrollHeight);

    function say(who: 'agent' | 'user', text: string, cls = '', src?: Source) {
      const li = el('li', `msg ${who} ${cls}`.trim());
      li.append(el('span', 'msg-text', text));
      if (src) li.append(el('span', `src src-${src} mono`, SOURCE[src]));
      msgs.append(li);
      scrollDown();
    }

    function setAgent(on: boolean) {
      agentOn = on;
      const st = $('agent-status');
      st.className = `agent-status ${on ? 'on' : 'off'}`;
      st.title = on ? '' : L.agentOffTitle;
      $('agent-status-text').textContent = on ? L.agentOn : L.agentOff;
    }

    function setBusy(on: boolean) {
      busy = on;
      chatText.disabled = on || !nextField(draft);
      sendBtn.disabled = chatText.disabled;
      chips.querySelectorAll('button').forEach((b) => (b.disabled = on));
      msgs.querySelector('.typing')?.remove();
      if (on) {
        const li = el('li', 'msg agent typing');
        li.setAttribute('aria-label', L.thinking);
        li.append(el('span', 'dot'), el('span', 'dot'), el('span', 'dot'));
        msgs.append(li);
        scrollDown();
      }
    }

    function trainWarning(f: Field, v: Value): string {
      if (f.kind === 'cat' || v === null || !f.train) return '';
      const n = Number(v);
      const fmt = (x: number) => (f.currency ? brl(x, lang) : String(x));
      return n < f.train[0] || n > f.train[1] ? ` (${L.outside}: ${fmt(f.train[0])}–${fmt(f.train[1])})` : '';
    }

    function renderSummary() {
      const box = $('summary');
      box.replaceChildren();
      let answered = 0;
      for (const g of L.groups) {
        box.append(el('h3', 'sub', g.title));
        const dl = el('dl');
        for (const f of FIELDS.filter((x) => x.group === g.key)) {
          const has = f.name in draft;
          const v = draft[f.name];
          if (has && v !== null && v !== '') answered++;
          const dt = el('dt', '', f.label[lang]);
          const dd = el('dd', has ? '' : 'empty', has ? show(f.name, v, lang) : '—');
          if (has) {
            const b = el('button', 'link', L.edit);
            b.type = 'button';
            b.addEventListener('click', () => edit(f.name));
            dd.append(' ', b);
          }
          dl.append(dt, dd);
        }
        box.append(dl);
      }
      $('count').textContent = `${answered}/${FIELDS.length} ${L.answered}`;
      const C = 2 * Math.PI * 18;
      $('ring').setAttribute('stroke-dasharray', `${((answered / FIELDS.length) * C).toFixed(2)} ${C.toFixed(2)}`);
      const missing = FIELDS.length - answered;
      $('imputed').textContent = missing ? `${missing} ${L.imputed}` : '';
    }

    function progress(f: Field | null) {
      const done = FIELDS.filter((x) => x.name in draft).length;
      const step = $('chat-step');
      step.textContent = `${f ? FIELDS.indexOf(f) + 1 : FIELDS.length}/${FIELDS.length}`;
      step.title = L.question;
      $('chat-bar').style.width = `${((done / FIELDS.length) * 100).toFixed(1)}%`;
    }

    /** Chips da pergunta; na pergunta de volta, só as opções citadas e um atalho para ver todas. */
    function setChips(f: Field | null, base?: Field) {
      chips.replaceChildren();
      if (!f) return;
      const add = (text: string, onClick: () => void, cls = 'chip') => {
        const b = el('button', cls, text);
        b.type = 'button';
        b.addEventListener('click', onClick);
        chips.append(b);
      };
      if (f.kind === 'cat') f.options!.forEach((op) => add(op.label[lang], () => choose(op.value, op.label[lang])));
      add(L.dontKnow, () => choose(null, L.dontKnow), 'chip ghost');
      if (f.narrowed && base)
        add(L.allOptions, () => {
          pendingAsk = null;
          setChips(base);
        }, 'chip ghost');
    }

    function ask() {
      const f = nextField(draft);
      pendingAsk = null;
      setChips(f);
      progress(f);
      if (f) say('agent', f.ask[lang], 'question');
      else say('agent', L.doneChat, 'done');
      chatText.disabled = !f;
      sendBtn.disabled = !f;
    }

    function accept(f: Field, value: Value, src: Source) {
      draft[f.name] = value;
      const li = el('li', 'msg ack');
      const text = el('span', 'msg-text');
      text.append(el('strong', '', f.label[lang]), ` ${show(f.name, value, lang)}${trainWarning(f, value)}`);
      li.append(el('span', 'ack-check', '✓'), text, el('span', `src src-${src} mono`, SOURCE[src]));
      msgs.append(li);
      renderSummary();
      ask();
    }

    function clarify(f: Field, options: string[], src: Source) {
      pendingAsk = options;
      say('agent', askBetween(f, options, lang), 'clarify', src);
      setChips(narrow(f, options), f);
    }

    /** Chip: o valor vai direto, sem regra nem LLM. */
    function choose(value: Value, text: string) {
      const f = nextField(draft);
      if (!f || busy) return;
      say('user', text);
      accept(f, value, 'option');
    }

    /** Pergunta ao microagente. null = sem leitura (desligado, limite, erro, tempo esgotado): valem as regras. */
    async function askAgent(f: Field, answer: string): Promise<AgentRead | null> {
      if (!agentOn) return null;
      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), 8000);
      try {
        const res = await fetch('/api/demo/score/agent', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ field: f.name, answer: answer.slice(0, 120) }),
          signal: ctrl.signal,
        });
        // 503: portal sem chave do Groq; 429: limite por hora ou teto do dia. Segue só com regras.
        if (res.status === 503 || res.status === 429) {
          setAgent(false);
          return null;
        }
        if (!res.ok) return null;
        return readAgent(f, (await res.json()) as AgentReply);
      } catch {
        return null;
      } finally {
        clearTimeout(timer);
      }
    }

    async function respond(answer: string) {
      const base = nextField(draft);
      if (!base || busy) return;
      say('user', answer);
      const f = pendingAsk ? narrow(base, pendingAsk) : base;
      const r = parseAnswer(f, answer, lang);
      // Opção exata, número limpo, "não sei" ou a palavra que decide a pergunta de volta: as regras bastam.
      if (r.ok && (r.how !== 'keyword' || pendingAsk)) return accept(base, r.value, 'rules');
      const turn = convo;
      setBusy(true);
      const a = await askAgent(base, answer);
      if (turn !== convo) return;
      setBusy(false);
      if (a?.kind === 'value') accept(base, a.value, 'llm');
      else if (a?.kind === 'ask') clarify(base, a.options, 'llm');
      else if (r.ok) accept(base, r.value, 'rules');
      else if (r.options) clarify(base, r.options, 'rules');
      else say('agent', r.hint, 'hint', 'rules');
      chatText.focus();
    }

    function edit(name: string) {
      delete draft[name];
      renderSummary();
      if (mode === 'chat') {
        convo++;
        setBusy(false);
        say('agent', `${L.editing}: ${label(name, lang)}.`, 'quiet');
        ask();
      } else {
        writeForm();
        guided.querySelector<HTMLElement>(`[name="${name}"]`)?.focus();
      }
    }

    function writeForm() {
      for (const f of FIELDS) {
        const input = guided.elements.namedItem(f.name) as HTMLInputElement | HTMLSelectElement | null;
        if (!input) continue;
        const v = draft[f.name];
        input.value = v === null || v === undefined ? '' : String(v);
      }
    }

    guided.addEventListener('input', (e) => {
      const input = e.target as HTMLInputElement | HTMLSelectElement;
      // O formulário devolve texto, inclusive nos números: o pipeline mostra a conversão de tipo.
      draft[input.name] = input.value === '' ? null : input.value;
      renderSummary();
    });

    $<HTMLFormElement>('chat-form').addEventListener('submit', (e) => {
      e.preventDefault();
      const text = chatText.value.trim();
      if (!text || busy) return;
      chatText.value = '';
      void respond(text);
    });

    function setMode(m: 'chat' | 'form') {
      mode = m;
      convo++;
      root!.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === m)));
      $('chat').hidden = m !== 'chat';
      guided.hidden = m !== 'form';
      if (m === 'form') writeForm();
      else {
        msgs.replaceChildren();
        setBusy(false);
        say('agent', L.intro, 'intro');
        ask();
      }
    }
    root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) =>
      b.addEventListener('click', () => setMode(b.dataset.mode as 'chat' | 'form')),
    );
    root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) =>
      b.addEventListener('click', () => {
        draft = { ...PRESETS[b.dataset.preset as 'low' | 'high'] };
        renderSummary();
        setMode(mode);
      }),
    );
    $('clear').addEventListener('click', () => {
      draft = {};
      renderSummary();
      setMode(mode);
    });

    // ------------------------------------------------------------ pipeline ao vivo
    const stagesEl = $('stages');
    const rail = new Map<StageId, HTMLElement>();
    root.querySelectorAll<HTMLElement>('.rail-step').forEach((li) => rail.set(li.dataset.stage as StageId, li));
    const stageNodes = new Map<StageId, { li: HTMLElement; body: HTMLElement; state: HTMLElement }>();
    let totalMs = 0;

    function setState(id: StageId, state: 'pending' | 'active' | 'done') {
      const node = stageNodes.get(id);
      if (node) {
        node.li.className = `stage ${state}`;
        if (state === 'active') node.state.textContent = L.running;
      }
      const r = rail.get(id);
      if (r) r.className = `rail-step ${state}`;
    }

    function resetStages() {
      stagesEl.replaceChildren();
      stageNodes.clear();
      totalMs = 0;
      $('total-ms').textContent = '0 ms';
      STAGES.forEach((id, i) => {
        const li = el('li', 'stage pending');
        const head = el('div', 'stage-head');
        const title = el('div', 'stage-title');
        title.append(el('h3', '', L.stages[id]), el('p', 'hint small', L.stageHints[id]));
        const state = el('span', 'stage-state mono', L.pending);
        head.append(el('span', 'step-n mono', i + 1), title, state);
        const body = el('div', 'stage-body');
        li.append(head, body);
        stagesEl.append(li);
        stageNodes.set(id, { li, body, state });
        setState(id, 'pending');
      });
    }

    function rawValue(f: { name: string; value: unknown; type: string }): HTMLElement {
      if (f.value === null || f.value === undefined) return el('span', 'tile-v empty mono', '∅');
      return el('span', 'tile-v mono', typeof f.value === 'string' && FIELD[f.name]?.kind !== 'cat' ? `"${f.value}"` : String(f.value));
    }

    function sigmoidChart(logOdds: number, p: number, threshold: number | null): SVGElement {
      const frame = { w: 320, h: 190, pad: 28 };
      const lim = logOddsDomain(logOdds);
      const sc = sigmoidScale(frame, lim);
      const root2 = svg('svg', { viewBox: `0 0 ${frame.w} ${frame.h}`, class: 'sig', role: 'img', 'aria-label': `${L.sigmoid}: ${L.logOdds} ${num(logOdds, lang, 2)} → ${pct(p, lang)}` });
      for (const v of [0, 0.5, 1]) root2.append(svg('line', { x1: frame.pad, x2: frame.w - frame.pad, y1: sc.y(v), y2: sc.y(v), class: 'grid' }));
      root2.append(svg('line', { x1: sc.x(0), x2: sc.x(0), y1: sc.y(0), y2: sc.y(1), class: 'grid' }));
      if (threshold !== null) {
        root2.append(svg('line', { x1: frame.pad, x2: frame.w - frame.pad, y1: sc.y(threshold), y2: sc.y(threshold), class: 'cut' }));
        root2.append(svg('text', { x: frame.w - frame.pad, y: sc.y(threshold) - 5, class: 'cut-label', 'text-anchor': 'end' }, `${L.cutoff} ${pct(threshold, lang, 0)}`));
      }
      root2.append(svg('path', { d: sigmoidPath(frame, lim), class: 'curve' }));
      const x = sc.x(logOdds);
      const y = sc.y(p);
      root2.append(svg('line', { x1: x, x2: x, y1: y, y2: sc.y(0), class: 'guide' }));
      root2.append(svg('line', { x1: frame.pad, x2: x, y1: y, y2: y, class: 'guide' }));
      const high = threshold !== null && p >= threshold;
      root2.append(svg('circle', { cx: x, cy: y, r: 6, class: high ? 'dot up' : 'dot down' }));
      const ty = frame.h - 8;
      root2.append(svg('text', { x: frame.pad, y: ty, class: 'tick', 'text-anchor': 'middle' }, `−${lim}`));
      root2.append(svg('text', { x: sc.x(0), y: ty, class: 'tick', 'text-anchor': 'middle' }, '0'));
      root2.append(svg('text', { x: frame.w - frame.pad, y: ty, class: 'tick', 'text-anchor': 'middle' }, `+${lim}`));
      root2.append(svg('text', { x: 4, y: sc.y(1) + 4, class: 'tick' }, '1'));
      root2.append(svg('text', { x: 4, y: sc.y(0) + 4, class: 'tick' }, '0'));
      root2.append(svg('text', { x: x + (logOdds > lim * 0.4 ? -10 : 10), y: y - 10, class: 'dot-label', 'text-anchor': logOdds > lim * 0.4 ? 'end' : 'start' }, pct(p, lang)));
      return root2;
    }

    const render: Record<StageId, (d: Dict) => Node[]> = {
      raw(d) {
        const fields = d.fields as { name: string; value: unknown; type: string }[];
        const count = (t: string) => fields.filter((f) => f.type === t).length;
        const m = d.model as { name: string; alias: string; version: string };
        const tiles = el('div', 'tiles');
        for (const f of fields) {
          const t = el('div', `tile t-${f.type}`);
          const head = el('span', 'tile-l');
          const dot = el('span', `type-dot t-${f.type}`);
          dot.title = L.types[f.type] ?? f.type;
          head.append(dot, el('span', 'tile-name', label(f.name, lang)));
          t.title = `${f.name} · ${L.types[f.type] ?? f.type}`;
          t.append(head, rawValue(f));
          tiles.append(t);
        }
        const meta = el('p', 'hint small');
        meta.append(`${L.model}: `, code(`${m.name}@${m.alias}`), ` v${m.version}. ${L.excluded} `, ...(d.excluded as string[]).flatMap((x, i) => [i ? ', ' : '', code(x)]));
        return [
          kpis([
            [fields.length, L.kFields],
            [count('number'), L.types.number, 'accent'],
            [count('string'), L.types.string, 'accent2'],
            [count('null'), L.types.null, 'warn'],
          ]),
          tiles,
          meta,
        ];
      },
      transform(d) {
        const casts = (d.casts as { name: string; from: string; to: string; raw: unknown; value: unknown; coerced: boolean }[]).filter((c) => c.coerced);
        const imputed = d.imputed as { name: string; value: Value; strategy: string }[];
        const enc = d.encoding as { name: string; value: string; column: string | null; infrequent: boolean; seen_in_training: boolean; n_columns: number; active_index?: number | null }[];
        const shape = d.shape as number[] | null;
        const out: Node[] = [
          kpis([
            [casts.length, L.kCasts, casts.length ? 'accent2' : ''],
            [imputed.length, L.kImputed, imputed.length ? 'warn' : ''],
            [enc.length, L.kOnehot],
            [shape ? `${shape[0]}×${shape[1]}` : '—', L.kMatrix, 'accent'],
          ]),
        ];
        if (casts.length) {
          out.push(sub(L.casts));
          const list = el('div', 'pills');
          for (const c of casts) {
            const p = el('span', 'pill');
            p.append(el('strong', '', label(c.name, lang)), ' ', code(JSON.stringify(c.raw)), el('span', 'arrow', '→'), code(String(c.value)), el('span', 'hint small', ` ${c.to}`));
            list.append(p);
          }
          out.push(list);
        }
        if (imputed.length) {
          out.push(sub(L.missing));
          const list = el('div', 'pills');
          for (const i of imputed) {
            const p = el('span', 'pill warnish');
            p.append(el('strong', '', label(i.name, lang)), el('span', 'arrow', '←'), show(i.name, i.value, lang), el('span', 'hint small', ` ${i.strategy === 'median' ? L.median : L.mode}`));
            list.append(p);
          }
          out.push(list);
        }
        if (enc.length) {
          out.push(sub(L.encoding));
          const box = el('div', 'onehot');
          for (const e of enc) {
            const row = el('div', 'oh-row');
            const name = el('div', 'oh-name');
            name.append(el('strong', '', label(e.name, lang)), ' ', el('code', '', e.value));
            if (!e.seen_in_training) name.append(el('span', 'tag warn', L.unseen));
            else if (e.infrequent) name.append(el('span', 'tag warn', L.infrequent));
            const cells = el('div', 'oh-cells');
            cells.setAttribute('aria-label', e.column ?? L.unseen);
            for (let k = 0; k < e.n_columns; k++) cells.append(el('span', k === e.active_index ? 'oh-cell on' : 'oh-cell', k === e.active_index ? 1 : 0));
            row.append(name, cells);
            box.append(row);
          }
          out.push(box);
        }
        const warnings = d.warnings as { column: string; message: string }[];
        if (warnings.length) {
          out.push(sub(L.warnings));
          const list = el('ul', 'plain small warn');
          warnings.forEach((w) => {
            const li = el('li');
            li.append(code(w.column), `: ${w.message}`);
            list.append(li);
          });
          out.push(list);
        }
        return out;
      },
      normalize(d) {
        const rows = d.rows as { name: string; before: number; mean: number; std: number; after: number; percentile: number }[];
        if (!rows.length) return [el('p', 'hint small', '—')];
        const box = el('div', 'zplot');
        const axis = el('div', 'zrow zaxis');
        const ticks = el('div', 'ztrack ticks');
        for (const t of [-3, -2, -1, 0, 1, 2, 3]) {
          const tk = el('span', 'ztick mono', t > 0 ? `+${t}` : t === 0 ? '0' : `−${-t}`);
          tk.style.left = `${zPos(t)}%`;
          ticks.append(tk);
        }
        axis.append(el('span'), ticks, el('span', 'zval mono', 'z'));
        box.append(axis);
        for (const r of rows) {
          const row = el('div', 'zrow');
          const name = el('div', 'zname');
          name.append(el('strong', '', label(r.name, lang)), el('span', 'hint small', ` ${num(r.before, lang)} · ${L.mean} ${num(r.mean, lang, 1)} ± ${num(r.std, lang, 1)}`));
          const track = el('div', 'ztrack');
          const seg = el('span', r.after >= 0 ? 'zseg pos' : 'zseg neg');
          const a = zPos(Math.min(0, r.after));
          const b = zPos(Math.max(0, r.after));
          seg.style.left = `${a}%`;
          seg.style.width = `${b - a}%`;
          const dot = el('span', r.after >= 0 ? 'zdot pos' : 'zdot neg');
          dot.style.left = `${zPos(r.after)}%`;
          track.append(el('span', 'zband'), el('span', 'zzero'), seg, dot);
          const val = el('span', 'zval mono');
          val.append(`${r.after > 0 ? '+' : ''}${num(r.after, lang, 2)}`, el('small', '', `p${Math.round(r.percentile * 100)}`));
          row.append(name, track, val);
          box.append(row);
        }
        return [el('p', 'hint small', L.scaler), box];
      },
      fit(d) {
        const train = d.rows_train as number;
        const test = d.rows_test as number;
        const split = el('div', 'split');
        const a = el('span', 'split-train', `${train} ${L.train}`);
        const b = el('span', 'split-test', `${test} ${L.test}`);
        a.style.flexGrow = String(train);
        b.style.flexGrow = String(test);
        split.append(a, b);
        const params = d.params as { C: number };
        return [
          kpis([
            [num(d.holdout_auc as number, lang, 3), L.kAuc, 'accent'],
            [d.iterations as number, L.kIter],
            [num(d.fit_ms as number, lang, 1), L.kFitMs],
            [pct(d.probability as number, lang), L.kBaseP, 'accent2'],
          ]),
          split,
          el('p', 'hint small', `LogisticRegression(C=${params.C}, class_weight="balanced") · ${L.fitNote}`),
        ];
      },
      model(d) {
        const params = (d.params ?? {}) as { learning_rate?: number; max_depth?: number };
        const p = d.probability as number;
        const thr = typeof d.threshold === 'number' ? d.threshold : null;
        const out: Node[] = [
          kpis([
            // Quebra só entre as palavras do CamelCase (HistGradientBoosting).
            [String(d.estimator).replace('Classifier', '').replace(/([a-z])([A-Z])/g, '$1​$2'), L.kEstimator, 'long'],
            [d.trees ? String(d.trees) : '—', L.kTrees],
            [`v${d.version}`, L.kVersion],
            [pct(p, lang), L.prob, thr !== null && p >= thr ? 'warn' : 'ok'],
          ]),
        ];
        if (typeof d.log_odds === 'number') {
          const wrap = el('div', 'sig-wrap');
          wrap.append(sigmoidChart(d.log_odds, p, thr));
          const f = el('p', 'formula mono');
          f.append(`${L.logOdds} = ${num(d.log_odds, lang, 3)} → ${L.sigmoid} → `, el('strong', '', pct(p, lang)));
          if (d.trees) f.append(el('span', 'hint', ` · lr ${params.learning_rate ?? '—'}, depth ${params.max_depth ?? '—'}`));
          wrap.append(f);
          out.push(wrap);
        }
        return out;
      },
      explain(d) {
        const feats = d.features as { name: string; value: Value; reference: Value; impact: number }[];
        if (!feats.length) return [el('p', 'hint small', L.nothing)];
        return [el('p', 'hint small', L.explainNote), impactChart(feats)];
      },
    };

    function showStage(d: Dict) {
      const id = d.id as StageId;
      const node = stageNodes.get(id);
      if (!node) return;
      setState(id, 'done');
      const ms = d.ms as number;
      totalMs += ms;
      $('total-ms').textContent = `${num(totalMs, lang, 1)} ms`;
      node.state.textContent = `✓ ${num(ms, lang, 1)} ms`;
      node.body.replaceChildren(...render[id](d));
      const i = STAGES.indexOf(id);
      if (i + 1 < STAGES.length) setState(STAGES[i + 1], 'active');
    }

    function gaugeSvg(p: number, threshold: number) {
      const g = $('gauge') as unknown as SVGElement;
      const cx = 110;
      const cy = 110;
      const r = 86;
      g.replaceChildren(
        svg('path', { d: arcPath(cx, cy, r, 0, 1), class: 'g-track' }),
        svg('path', { d: arcPath(cx, cy, r, 0, threshold), class: 'g-zone ok' }),
        svg('path', { d: arcPath(cx, cy, r, threshold, 1), class: 'g-zone warn' }),
      );
      // 0% e 100% embaixo das pontas do arco; o corte fica do lado de fora, onde ele cai.
      g.append(svg('text', { x: cx - r, y: cy + 18, class: 'tick', 'text-anchor': 'middle' }, pct(0, lang, 0)));
      g.append(svg('text', { x: cx + r, y: cy + 18, class: 'tick', 'text-anchor': 'middle' }, pct(1, lang, 0)));
      const [tx, ty] = polar(cx, cy, r + 14, threshold);
      g.append(svg('line', { x1: polar(cx, cy, r - 9, threshold)[0], y1: polar(cx, cy, r - 9, threshold)[1], x2: polar(cx, cy, r + 9, threshold)[0], y2: polar(cx, cy, r + 9, threshold)[1], class: 'g-cut' }));
      g.append(svg('text', { x: tx.toFixed(1), y: (ty + 3).toFixed(1), class: 'tick', 'text-anchor': threshold < 0.4 ? 'end' : threshold > 0.6 ? 'start' : 'middle' }, `${L.cutoff} ${pct(threshold, lang, 0)}`));
      const [nx, ny] = polar(cx, cy, r - 14, p);
      g.append(svg('line', { x1: cx, y1: cy, x2: nx.toFixed(1), y2: ny.toFixed(1), class: 'needle' }), svg('circle', { cx, cy, r: 6, class: 'hub' }));
    }

    function showResult(d: Dict) {
      const p = d.default_probability as number;
      const thr = d.threshold as number;
      const approve = d.decision === 'approve';
      gaugeSvg(p, thr);
      $('prob-value').textContent = pct(p, lang);
      const dec = $('decision');
      dec.className = `badge-dec ${approve ? 'ok' : 'warn'}`;
      dec.textContent = approve ? `✓ ${L.approve}` : `⚑ ${L.review}`;
      const items: [string | number, string, string?][] = [
        [pct(thr, lang, 0), L.threshold],
        [`v${d.model_version}`, '@champion'],
      ];
      if (d.baseline_probability != null) items.push([pct(d.baseline_probability as number, lang), L.baseline, 'accent2']);
      $('result-kpis').replaceWith(Object.assign(kpis(items), { id: 'result-kpis' }));
      const feats = d.top_features as { name: string; value: Value; impact: number }[];
      const top = $('result-top');
      top.replaceChildren(feats.length ? impactChart(feats) : el('p', 'hint small', L.nothing));
      const box = $('result');
      box.classList.toggle('is-ok', approve);
      box.classList.toggle('is-warn', !approve);
      box.hidden = false;
    }

    const runBtn = $<HTMLButtonElement>('run');
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    runBtn.addEventListener('click', async () => {
      runBtn.disabled = true;
      runBtn.textContent = L.running;
      $('live-error').hidden = true;
      $('result').hidden = true;
      resetStages();
      $('pipe').hidden = false;
      setState(STAGES[0], 'active');
      $('pipe').scrollIntoView({ behavior: 'smooth', block: 'start' });
      // Os eventos chegam juntos (o servidor leva ~100 ms); a página revela um por vez.
      const queue: [string, Dict][] = [];
      let streamDone = false;
      const reveal = (async () => {
        for (;;) {
          const item = queue.shift();
          if (!item) {
            if (streamDone) return;
            await wait(40);
            continue;
          }
          const [event, data] = item;
          if (event === 'stage') {
            showStage(data);
            await wait(450);
          } else if (event === 'result') showResult(data);
          else if (event === 'error') throw { status: 502 } as ApiError;
        }
      })();
      try {
        const res = await fetch('/api/demo/score/pipeline', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'content-type': 'application/json', accept: 'text/event-stream' },
          body: JSON.stringify(pipelineBody(draft, lang)),
        });
        if (!res.ok) {
          const body = (await res.clone().json().catch(() => null)) as { detail?: { problems?: { column: string; message: string }[] } } | null;
          const problems = body?.detail?.problems;
          if (res.status === 422 && problems?.length) {
            streamDone = true;
            $('pipe').hidden = true;
            const box = $('live-error');
            box.replaceChildren(el('span', '', L.invalid));
            const ul = el('ul', 'plain');
            problems.forEach((p) => {
              const li = el('li');
              li.append(code(p.column), `: ${p.message}`);
              ul.append(li);
            });
            box.append(ul);
            box.hidden = false;
            return;
          }
          throw await errorFrom(res);
        }
        await readSse(res, (event, data) => queue.push([event, data as Dict]));
        streamDone = true;
        await reveal;
        await refreshGate();
      } catch (err) {
        streamDone = true;
        $('live-error').textContent = liveError(err, s);
        $('live-error').hidden = false;
      } finally {
        streamDone = true;
        runBtn.disabled = !canSpend;
        runBtn.textContent = L.run;
      }
    });

    // ------------------------------------------------------------ lote
    function download(text: string, name: string) {
      const url = URL.createObjectURL(new Blob([text], { type: 'text/csv;charset=utf-8' }));
      const a = el('a');
      a.href = url;
      a.download = name;
      document.body.append(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }
    root.querySelectorAll<HTMLButtonElement>('[data-sample]').forEach((b) =>
      b.addEventListener('click', () => {
        const kind = b.dataset.sample as 'valid' | 'errors';
        const name = lang === 'pt' ? `credito-exemplo-${kind === 'valid' ? 'valido' : 'com-erros'}.csv` : `credit-sample-${kind}.csv`;
        download(sampleCsv(kind), name);
      }),
    );

    const fileInput = $<HTMLInputElement>('file');
    const batchError = $('batch-error');
    const report = $('report');
    const scoreStep = $('score-step');
    const scoreBtn = $<HTMLButtonElement>('score');
    let checked: ArrayBuffer | null = null;

    function batchFail(text: string) {
      batchError.textContent = text;
      batchError.hidden = false;
    }

    async function readFile(): Promise<ArrayBuffer | null> {
      batchError.hidden = true;
      const file = fileInput.files?.[0];
      if (!file) return batchFail(L.pick), null;
      if (file.size > MAX_FILE_BYTES) return batchFail(L.tooBig), null;
      return file.arrayBuffer();
    }

    function batchMessage(err: unknown): string {
      const e = err as ApiError;
      if (e?.status === 413) return L.tooLarge;
      if (e?.status === 415) return L.notCsv;
      if (e?.status === 429 && e.reason === 'rate_limited') return L.rateLimited;
      return liveError(err, s);
    }

    async function post(path: string, body: ArrayBuffer): Promise<Response> {
      return fetch(`${path}?lang=${lang}`, {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'content-type': 'text/csv' },
        body,
      });
    }

    /** Barra empilhada: partes proporcionais ao valor. */
    function stack(parts: [number, string][]): HTMLElement {
      const bar = el('div', 'stack');
      for (const [n, cls] of parts) {
        if (!n) continue;
        const part = el('span', cls);
        part.style.flexGrow = String(n);
        bar.append(part);
      }
      return bar;
    }

    type Problem = { row: number; column: string; code: string; message: string; value: string | null; severity: string };
    type Report = {
      ok: boolean;
      rows: number;
      valid_rows: number;
      invalid_rows: number;
      file_errors: { code: string; message: string }[];
      column_warnings: { column: string; message: string }[];
      problems: Problem[];
      problems_total: number;
      truncated: boolean;
      summary: { column: string; code: string; severity: string; count: number }[];
    };

    function renderReport(r: Report) {
      report.replaceChildren();
      const okAll = r.ok && !r.file_errors.length;
      report.append(el('p', okAll ? 'notice ok' : 'notice error', okAll ? L.ok : L.notOk));
      if (!r.file_errors.length) {
        report.append(
          kpis([
            [r.rows, L.rows],
            [r.valid_rows, L.validRows, 'ok'],
            [r.invalid_rows, L.invalidRows, r.invalid_rows ? 'bad' : ''],
          ]),
          stack([
            [r.valid_rows, 'ok'],
            [r.invalid_rows, 'bad'],
          ]),
        );
      }
      if (r.file_errors.length) {
        report.append(sub(L.fileErrors));
        const ul = el('ul', 'plain');
        r.file_errors.forEach((e) => ul.append(el('li', '', e.message)));
        report.append(ul);
      }
      if (r.column_warnings.length) {
        report.append(sub(L.colWarnings));
        const ul = el('ul', 'plain small');
        r.column_warnings.forEach((w) => {
          const li = el('li');
          li.append(code(w.column), `: ${w.message}`);
          ul.append(li);
        });
        report.append(ul);
      }
      if (r.summary.length) {
        report.append(sub(L.summary));
        const max = Math.max(...r.summary.map((x) => x.count));
        const box = el('div', 'bars');
        for (const x of r.summary) {
          const row = el('div', 'bar-row');
          const name = el('span', 'bar-name');
          // "*" é problema da linha inteira (número de campos), não de uma coluna.
          name.append(x.column && x.column !== '*' ? code(x.column) : el('strong', '', L.line),el('span', 'hint small', ` ${x.severity === 'error' ? L.error : L.warning}: ${x.code}`));
          const track = el('span', 'bar-track');
          const fillEl = el('span', `bar-fill ${x.severity === 'error' ? 'bad' : 'warn'}`);
          fillEl.style.width = `${(x.count / max) * 100}%`;
          track.append(fillEl);
          row.append(name, track, el('span', 'mono bar-n', x.count));
          box.append(row);
        }
        report.append(box);
      }
      if (r.problems.length) {
        report.append(sub(`${L.line} × ${L.field}`));
        const box = el('div', 'scroll');
        box.append(
          table(
            [L.line, L.field, L.value, L.problem],
            r.problems.map((p) => [
              p.row,
              code(p.column),
              p.value === null ? '∅' : el('code', '', p.value),
              el('span', p.severity === 'error' ? '' : 'warn', p.message),
            ]),
            'problems',
          ),
        );
        report.append(box);
        if (r.truncated) report.append(el('p', 'hint small', lang === 'pt' ? `Mostrando os primeiros; são ${r.problems_total} no total.` : `Showing the first ones; there are ${r.problems_total} in total.`));
      }
      report.hidden = false;
      scoreStep.hidden = !r.valid_rows;
      scoreBtn.textContent = lang === 'pt' ? `Fazer o score das ${r.valid_rows} linhas válidas (usa 1 da cota)` : `Score the ${r.valid_rows} valid rows (uses 1 of the quota)`;
      $('scored').hidden = true;
    }

    fileInput.addEventListener('change', () => {
      checked = null;
      report.hidden = true;
      scoreStep.hidden = true;
      batchError.hidden = true;
    });

    const validateBtn = $<HTMLButtonElement>('validate');
    validateBtn.addEventListener('click', async () => {
      const body = await readFile();
      if (!body) return;
      validateBtn.disabled = true;
      validateBtn.textContent = L.validating;
      try {
        const res = await post('/api/demo/score/batch/validate', body);
        if (!res.ok) throw await errorFrom(res);
        renderReport((await res.json()) as Report);
        checked = body;
      } catch (err) {
        batchFail(batchMessage(err));
      } finally {
        validateBtn.disabled = false;
        validateBtn.textContent = L.validate;
      }
    });

    function histChart(probs: number[], threshold: number): SVGElement {
      const W = 320;
      const H = 164;
      const pad = 10;
      // Espaço em cima para o rótulo do corte não encostar na contagem da barra mais alta.
      const top = 34;
      const bottom = 22;
      const bins = histogram(probs, 10);
      const max = Math.max(...bins, 1);
      const bw = (W - 2 * pad) / bins.length;
      const g = svg('svg', { viewBox: `0 0 ${W} ${H}`, class: 'hist', role: 'img', 'aria-label': L.hist });
      g.append(svg('line', { x1: pad, x2: W - pad, y1: H - bottom, y2: H - bottom, class: 'grid' }));
      bins.forEach((n, i) => {
        const h = (n / max) * (H - top - bottom);
        const x = pad + i * bw + 2;
        const mid = (i + 0.5) / bins.length;
        g.append(svg('rect', { x: x.toFixed(1), y: (H - bottom - h).toFixed(1), width: (bw - 4).toFixed(1), height: h.toFixed(1), rx: 3, class: mid >= threshold ? 'hbar up' : 'hbar down' }));
        if (n) g.append(svg('text', { x: (x + (bw - 4) / 2).toFixed(1), y: (H - bottom - h - 4).toFixed(1), class: 'tick', 'text-anchor': 'middle' }, String(n)));
      });
      const tx = pad + threshold * (W - 2 * pad);
      g.append(svg('line', { x1: tx, x2: tx, y1: 6, y2: H - bottom, class: 'cut' }));
      g.append(svg('text', { x: tx + 4, y: 12, class: 'cut-label' }, `${L.cutoff} ${pct(threshold, lang, 0)}`));
      for (const v of [0, 0.5, 1]) g.append(svg('text', { x: pad + v * (W - 2 * pad), y: H - 6, class: 'tick', 'text-anchor': v === 0 ? 'start' : v === 1 ? 'end' : 'middle' }, pct(v, lang, 0)));
      return g;
    }

    scoreBtn.addEventListener('click', async () => {
      if (!checked) return;
      scoreBtn.disabled = true;
      const label0 = scoreBtn.textContent;
      scoreBtn.textContent = L.scoring;
      try {
        const res = await post('/api/demo/score/batch', checked);
        if (res.status === 422) {
          const body = (await res.json().catch(() => null)) as { detail?: { report?: Report } } | null;
          if (body?.detail?.report) {
            renderReport(body.detail.report);
            return;
          }
        }
        if (!res.ok) throw await errorFrom(res);
        const data = (await res.json()) as {
          model_version: string;
          threshold: number;
          results: { line: number; id: string | null; status: string; default_probability: number | null; decision: string | null }[];
          csv: string;
        };
        const box = $('scored');
        box.replaceChildren();
        const scored = data.results.filter((r) => r.status === 'scored');
        const probs = scored.map((r) => r.default_probability ?? 0);
        const mean = probs.reduce((a, b) => a + b, 0) / Math.max(1, probs.length);
        const approve = scored.filter((r) => r.decision === 'approve').length;
        const skipped = data.results.length - scored.length;
        const dl = el('button', 'btn primary', L.download);
        dl.type = 'button';
        dl.addEventListener('click', () => download(data.csv, lang === 'pt' ? 'credito-score.csv' : 'credit-score.csv'));
        const chart = el('div', 'hist-box');
        chart.append(sub(L.hist), histChart(probs, data.threshold));
        const shown = data.results.slice(0, 50);
        box.append(
          kpis([
            [scored.length, L.scored, 'accent'],
            [approve, L.approve, 'ok'],
            [scored.length - approve, L.review, 'warn'],
            [pct(mean, lang), L.avg],
          ]),
          stack([
            [approve, 'ok'],
            [scored.length - approve, 'warn'],
            [skipped, 'bad'],
          ]),
          el('p', 'hint small mono', `@champion v${data.model_version} · ${L.threshold} ${pct(data.threshold, lang, 0)}${skipped ? ` · ${skipped} ${L.skipped}` : ''}`),
          chart,
          dl,
          el('p', 'hint small', L.csvNote),
          table(
            [L.line, 'id', 'status', L.prob, ''],
            shown.map((r) => [
              r.line,
              r.id ?? '',
              r.status,
              r.default_probability === null ? '—' : pct(r.default_probability, lang),
              r.decision === null ? '' : el('span', r.decision === 'approve' ? 'ok' : 'warn', r.decision === 'approve' ? `✓ ${L.approve}` : `⚑ ${L.review}`),
            ]),
          ),
        );
        if (data.results.length > shown.length) box.append(el('p', 'hint small', lang === 'pt' ? `Primeiras ${shown.length} de ${data.results.length} linhas.` : `First ${shown.length} of ${data.results.length} rows.`));
        box.hidden = false;
        await refreshGate();
      } catch (err) {
        batchFail(batchMessage(err));
      } finally {
        scoreBtn.disabled = !canSpend;
        scoreBtn.textContent = label0;
      }
    });

    // ------------------------------------------------------------ início
    renderSummary();
    setMode('chat');
    void refreshGate();
  }
</script>

