---
import DemoShell from '../../components/DemoShell.astro';
import { route, type Lang } from '../../i18n/routes';
import { uiStrings } from '../../i18n/ui';
import { LIVE_KEYS } from '../../lib/live';
import { FIELDS, MAX_FILE_BYTES, MAX_FILE_ROWS, STAGES } from '../../lib/credit';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = uiStrings(lang, [...LIVE_KEYS]);
const pt = lang === 'pt';
const kb = Math.round(MAX_FILE_BYTES / 1024);
const L = pt
  ? {
      introTitle: 'Um modelo de crédito de verdade, etapa por etapa',
      introText:
        'É o pipeline da mlops-platform: o @champion do MLflow, treinado no German Credit e servido pelo scoring interno. No modo ao vivo, você monta um perfil e vê cada etapa rodar no servidor. No modo lote, valida e pontua um CSV inteiro.',
      kpis: [
        ['1.000', 'casos no credit-g'],
        ['18', 'variáveis de entrada'],
        ['6', 'etapas ao vivo'],
        [String(MAX_FILE_ROWS), 'linhas por CSV'],
      ],
      tabLive: 'ML em tempo real',
      tabBatch: 'Lote (CSV)',
      collectTitle: 'Monte o perfil',
      collectHint: 'Converse com o agente ou preencha o formulário. O que você não souber, o pipeline imputa.',
      chat: 'Conversa',
      form: 'Formulário',
      presets: 'Perfil pronto:',
      presetLow: 'risco baixo',
      presetHigh: 'risco alto',
      clear: 'Recomeçar',
      send: 'Enviar',
      placeholder: 'Responda com suas palavras…',
      dontKnow: 'não sei',
      intro:
