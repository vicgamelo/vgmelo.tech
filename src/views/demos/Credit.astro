      explainNote: 'Bar to the right: the variable raised the risk. To the left: lowered it. In percentage points.',
      typical: 'typical',
      nothing: 'No variable moved the probability by more than 0.01 p.p.',
      resultTitle: 'Result',
      resultHint: "Probability of default and the decision by the champion's cutoff.",
      prob: 'Probability of default',
      approve: 'approve',
      review: 'send to review',
      threshold: 'cutoff',
      baseline: 'live baseline',
      top: 'What weighed the most',
      raised: 'raises the risk',
      lowered: 'lowers the risk',
      invalid: 'The pipeline refused the profile:',
      step1: 'Generate a test file or use yours',
      step1Hint: 'Two sample CSVs, generated in your browser: a clean one and one with planted errors.',
      valid: 'Download valid CSV',
      withErrors: 'Download CSV with errors',
      schema: 'Columns and accepted values',
      schemaNote: `One column per variable (the header is required; "id" is optional and comes back in the result). Comma or semicolon. Up to ${MAX_FILE_ROWS} rows and ${kb} KB.`,
      step2: 'Upload and validate',
      batchNote: "The file is treated as untrusted data: read with Python's csv module, no eval, with size and row limits. Validating doesn't use the quota.",
      choose: 'CSV file',
      validate: 'Validate',
      validating: 'Validating…',
      tooBig: `The file is over ${kb} KB.`,
      pick: 'Pick a .csv file first.',
      ok: 'The file is correct: every row can be scored.',
