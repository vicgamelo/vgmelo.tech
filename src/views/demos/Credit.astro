      outside: 'fora do que o modelo viu no treino',
      doneChat: 'Pronto, perfil completo. Confira o resumo e rode o pipeline.',
      editing: 'Vamos corrigir',
      profile: 'Perfil',
      answered: 'respondidos',
      imputed: 'vão ser imputados',
      edit: 'corrigir',
      run: 'Rodar o pipeline',
      running: 'Rodando…',
      agentNote:
