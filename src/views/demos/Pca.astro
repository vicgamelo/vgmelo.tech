    min-width: 0;
  }
  .pca {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 16px;
    padding-bottom: 48px;
  }
  .panel {
    background: linear-gradient(180deg, var(--panel-2), var(--panel));
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 20px;
    box-shadow: var(--shadow);
    min-width: 0;
  }
  h2 {
    font-size: 17px;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .hint {
    color: var(--muted);
    font-size: 14px;
    margin: 4px 0 0;
  }
  .small {
    font-size: 13px;
  }
  .panel-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }
  .intro {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }
  .intro-data {
    display: grid;
    gap: 10px;
  }
  .sets {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .set,
  .legend :global(.leg),
  .tool,
  .seg button {
    font: inherit;
    font-size: 13.5px;
    border: 1px solid var(--line-strong);
