---
import Base from '../layouts/Base.astro';
import Brain from '../components/Brain.astro';
import Cards from '../components/Cards.astro';
import Icon from '../components/Icon.astro';
import ArticleList from '../components/ArticleList.astro';
import { APPS, DEMOS, LINKS, PROJECTS } from '../data/site';
import { ROUTES, route, type Lang } from '../i18n/routes';
import { useT } from '../i18n/ui';
import { articlesFor } from '../lib/articles';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const featured = PROJECTS.filter((p) => p.featured);
const allArticles = await articlesFor(lang);
const articles = allArticles.slice(0, 3);
const what = (['agents', 'mlops', 'obs', 'data'] as const).map((k) => ({
  key: k,
  title: t(`what.${k}.title`),
  text: t(`what.${k}.text`),
}));
const live = DEMOS.filter((d) => d.live).length;
// Números contados dos próprios dados do site, para nunca ficarem desatualizados.
const kpis = [
  { value: '5+', label: t('home.kpi.years') },
  { value: String(PROJECTS.length), label: t('home.kpi.projects') },
  { value: String(live), label: t('home.kpi.live'), sub: `+${DEMOS.length - live} ${t('home.kpi.browser')}` },
  { value: String(allArticles.length), label: t('home.kpi.articles') },
];
// Trace ilustrativo (formato real do genai-lens; números de uma execução típica).
const spans = [
  { name: 'run.coordinator', kind: 'run', depth: 0, start: 0, dur: 100, ms: '5,7 s' },
  { name: 'llm · gpt-oss-120b', kind: 'llm', depth: 1, start: 0, dur: 12, ms: '0,7 s' },
  { name: 'delegate · economist', kind: 'agent', depth: 1, start: 13, dur: 70, ms: '4,0 s' },
  { name: 'tool · indicador_economico', kind: 'tool', depth: 2, start: 22, dur: 18, ms: '1,0 s' },
  { name: 'tool · calculator', kind: 'tool', depth: 2, start: 44, dur: 4, ms: '12 ms' },
  { name: 'llm · gpt-oss-20b', kind: 'llm', depth: 2, start: 50, dur: 30, ms: '1,7 s' },
  { name: 'llm · resposta final', kind: 'llm', depth: 1, start: 85, dur: 15, ms: '0,9 s' },
];
const [mainDemo, ...otherDemos] = DEMOS;
// Palavra do título que ganha o traço de giz (o texto continua o mesmo do i18n).
const title = t('home.title');
const markWord = lang === 'pt' ? 'produção' : 'production';
const at = title.indexOf(markWord);
const titleParts = at >= 0 ? [title.slice(0, at), markWord, title.slice(at + markWord.length)] : [title, '', ''];
const kpiNum = (v: string) => ({ n: Number.parseInt(v, 10), suffix: v.replace(/^\d+/, '') });
---

<Base lang={lang} alt={ROUTES.home}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <a class="who" href={route('about', lang)}>
          <img src={LINKS.avatar} alt="" width="36" height="36" />
          <span><strong>Victor Gabriel Andrade de Melo</strong><span class="muted"> · {t('site.role')}</span></span>
        </a>
        <h1>
          {titleParts[0]}{
            titleParts[1] && (
              <span class="mark">
                {titleParts[1]}
                <svg class="chalk" viewBox="0 0 200 14" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M3 9.5c30-5 62-6.5 98-5.5 34 1 63 2.7 96 5" />
                </svg>
              </span>
            )
          }{titleParts[2]}
        </h1>
        <p class="hero-lead">{t('home.lead')}</p>
        <div class="actions">
          <a class="btn primary" href={route('demos', lang)}><Icon name="play" />{t('home.ctaDemos')}</a>
          <a class="btn" href={route('contact', lang)}>{t('home.ctaContact')}</a>
          <a class="btn icon-only" href={LINKS.linkedin} rel="me noopener" aria-label="LinkedIn"><Icon name="linkedin" /></a>
          <a class="btn icon-only" href={LINKS.github} rel="me noopener" aria-label="GitHub"><Icon name="github" /></a>
        </div>
        <dl class="kpis" data-reveal aria-label={t('home.kpi.label')}>
          {
            kpis.map((k) => (
              <div class="kpi">
                <dt class="kpi-label">{k.label}</dt>
                <dd class="kpi-value">
                  <span data-count={kpiNum(k.value).n} data-suffix={kpiNum(k.value).suffix}>{k.value}</span>
                  {k.sub && <span class="kpi-sub mono">{k.sub}</span>}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <Brain lang={lang} />
    </div>
    <div class="container">
      <ul class="stack" aria-label="Stack">
        {['MLOps', 'MLflow', 'Agentes · MCP', 'OpenTelemetry', 'Python', 'Postgres', 'Docker'].map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <div class="section-title">
        <div>
          <span class="eyebrow">01 · {t('home.whatTitle')}</span>
          <h2>{t('home.whatHeadline')}</h2>
        </div>
      </div>
      <div class="what-grid">
      <ul class="what">
        {
          what.map((w) => (
            <li class={`what-item ${w.key}`}>
              <span class="what-icon">
                <Icon name={w.key} />
              </span>
              <div>
                <h3>{w.title}</h3>
                <p>{w.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
        <figure class="console" data-trace aria-label={t('home.console.title')}>
          <div class="console-bar">
            <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="mono">genai-lens · {t('home.console.title')}</span>
            <span class="pill-ok" data-pill aria-hidden="true">200 OK</span>
            <button class="replay" type="button" data-replay aria-label={t('home.console.replay')} title={t('home.console.replay')} hidden>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7M4 4v4.5h4.5"></path></svg>
            </button>
          </div>
          <div class="console-body">
            <div class="question mono">
              <span class="prompt">›</span>
              {lang === 'pt' ? 'Qual a Selic e o IPCA em 12 meses? Qual o juro real?' : "What are Selic and 12-month IPCA? What's the real rate?"}
            </div>
            <div class="trace">
            <span class="playhead" data-playhead aria-hidden="true"></span>
            <ol class="spans">
              {
                spans.map((s) => (
                  <li class={`span ${s.kind} d${s.depth}`} data-start={s.start} data-dur={s.dur}>
                    <span class="span-name mono">{s.name}</span>
                    <svg class="span-track" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true">
                      <rect class="span-bar" x={s.start} y="0" width={s.dur} height="10" rx="1.5" />
                    </svg>
                    <span class="span-ms mono">{s.ms}</span>
                  </li>
                ))
              }
            </ol>
            </div>
            <div class="console-foot mono">
              <span><b data-tokens="7935">7.935</b> tokens</span>
              <span><b data-tools="3">3</b> tools</span>
              <span><b>$0,00</b> · free tier</span>
            </div>
          </div>
          <figcaption>{t('home.console.note')}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <div class="section-title">
        <div>
          <span class="eyebrow">02 · {t('home.demosTitle')}</span>
          <h2>{t('home.demosHeadline')}</h2>
        </div>
        <a class="see-all" href={route('demos', lang)}>{t('nav.demos')} →</a>
      </div>
      <p class="lead">{t('home.demosLead')}</p>
      <div class="bento">
        <a class="card demo-main" href={route(mainDemo.key, lang)}>
          <span class="badge live">{t('demos.live')}</span>
          <h3>{mainDemo.title[lang]}</h3>
          <p>{mainDemo.text[lang]}</p>
          <div class="mini-chat" aria-hidden="true">
            <p class="q">{lang === 'pt' ? 'Qual a Selic e o IPCA em 12 meses? Qual o juro real?' : "What are Selic and 12-month IPCA? What's the real rate?"}</p>
            <ol class="mini-trace">
              <li><span class="node">coordinator</span><span class="lane"><span class="seg s1"></span></span></li>
              <li class="d1"><span class="node alt">economist</span><span class="lane"><span class="seg s2"></span></span></li>
              <li class="d2"><span class="node tool">MCP · BCB</span><span class="lane"><span class="seg s3"></span></span></li>
              <li class="d1"><span class="node tool">MCP · IBGE</span><span class="lane"><span class="seg s4"></span></span></li>
            </ol>
            <p class="a"><span></span><span></span><span></span></p>
          </div>
          <span class="go">{t('home.tryIt')} <span class="arrow">→</span></span>
        </a>
        {otherDemos.slice(0, 4).map((d) => <Cards kind="demo" lang={lang} item={d} />)}
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <div class="section-title">
        <div>
          <span class="eyebrow">03 · {t('home.projectsTitle')}</span>
          <h2>{t('home.projectsHeadline')}</h2>
        </div>
        <a class="see-all" href={route('projects', lang)}>{t('home.projectsAll')} →</a>
      </div>
      <ul class="repos">
        {
          featured.map((p) => (
            <li class="repo">
              <div class="repo-main">
                <h3 class="mono">
                  <span class="owner">vicgamelo/</span>
                  {p.name}
                </h3>
                <p>{p.summary[lang]}</p>
              </div>
              <ul class="tags">
                {p.tags.map((tag) => (
                  <li class="tag">{tag}</li>
                ))}
              </ul>
              <div class="repo-links">
                <a href={p.repo} rel="noopener">{t('projects.repo')}</a>
                {p.demo && <a href={route(p.demo, lang)}>{t('projects.demo')} →</a>}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <div class="section-title">
        <div>
          <span class="eyebrow">04 · {t('home.appsTitle')}</span>
          <h2>{t('home.appsHeadline')}</h2>
        </div>
        <a class="see-all" href={route('apps', lang)}>{t('home.appsAll')} →</a>
      </div>
      <div class="grid two">{APPS.map((a) => <Cards kind="app" lang={lang} item={a} />)}</div>
    </div>
  </section>

  {
    articles.length > 0 && (
      <section class="section" data-reveal>
        <div class="container">
          <div class="section-title">
            <div>
              <span class="eyebrow">05 · {t('home.articlesTitle')}</span>
              <h2>{t('home.articlesHeadline')}</h2>
            </div>
            <a class="see-all" href={route('articles', lang)}>{t('home.articlesAll')} →</a>
          </div>
          <ArticleList lang={lang} articles={articles} />
        </div>
      </section>
    )
  }

  <section class="section" data-reveal>
    <div class="container">
      <div class="cta">
        <div>
          <span class="eyebrow">{t('nav.consulting')}</span>
          <h2>{t('home.consultingTitle')}</h2>
          <p>{t('home.consultingLead')}</p>
        </div>
        <div class="actions">
          <a class="btn primary" href={route('consulting', lang)}>{t('home.consultingCta')}</a>
          <a class="btn" href={route('contact', lang)}>{t('nav.contact')}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import '../scripts/trace';
</script>

<style>
  .hero {
    padding: 48px 0 40px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 32px;
    align-items: center;
  }
  .who {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 4px 14px 4px 4px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--panel);
    color: var(--text);
    text-decoration: none;
    font-size: 14px;
    margin-bottom: 24px;
    max-width: 100%;
    transition: border-color 0.2s;
  }
  .who img {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
  }
  .who:hover {
    border-color: var(--line-strong);
  }
  .hero h1 {
    font-size: clamp(36px, 4.6vw, 58px);
    margin-bottom: 20px;
  }
  /* Traço de giz sob a palavra-chave: desenha uma vez quando a página abre. */
  .mark {
    position: relative;
    white-space: nowrap;
    color: var(--accent);
  }
  .chalk {
    position: absolute;
    left: -2%;
    width: 104%;
    bottom: -0.12em;
    height: 0.32em;
    overflow: visible;
  }
  .chalk path {
    fill: none;
    stroke: var(--accent-fill);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 210;
    stroke-dashoffset: 0;
    opacity: 0.55;
    vector-effect: non-scaling-stroke;
  }
  :global(.motion) .chalk path {
    animation: draw 0.9s 0.35s var(--ease-out) both;
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 210;
    }
  }
  .hero-lead {
    color: var(--muted);
    font-size: 18px;
    max-width: 600px;
    margin: 0 0 28px;
    text-wrap: pretty;
  }
  .icon-only {
    padding: 10px 12px;
  }

  /* Números: discretos, abaixo das ações */
  .kpis {
    display: grid;
    grid-template-columns: repeat(4, auto);
    justify-content: start;
    gap: 16px 40px;
    margin: 36px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .kpi {
    display: flex;
    flex-direction: column-reverse;
    gap: 2px;
  }
  .kpi-label {
    color: var(--muted);
    font-size: 13px;
    max-width: 16ch;
  }
  .kpi-value {
    margin: 0;
    font-family: var(--display);
    font-size: 44px;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  @media (max-width: 640px) {
    .kpi-value {
      flex-wrap: wrap;
      row-gap: 2px;
    }
    .kpi-sub {
      flex-basis: 100%;
    }
  }
  .kpi-sub {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--accent);
  }

  .stack {
    list-style: none;
    padding: 0;
    margin: 48px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--muted);
  }
  .stack li {
    padding: 4px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  /* Console com o trace: as barras crescem em sequência, uma vez */
  .console {
    margin: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--panel);
    box-shadow: var(--shadow-lift);
    overflow: hidden;
    transform: rotate(0.6deg);
  }
  .console-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    background: var(--panel-2);
    font-size: 12px;
    color: var(--muted);
    min-width: 0;
  }
  .console-bar .mono {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .dots {
    display: flex;
    gap: 6px;
    flex: none;
  }
  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .pill-ok {
    margin-left: auto;
    flex: none;
    font-family: var(--mono);
    color: var(--ok);
    border: 1px solid color-mix(in srgb, var(--ok) 35%, transparent);
    border-radius: 6px;
    padding: 1px 6px;
  }
  .console-body {
    padding: 18px;
  }
  .question {
    font-size: 13px;
    padding: 10px 12px;
    border-radius: var(--radius-xs);
    background: var(--bg-soft);
    margin-bottom: 16px;
  }
  .prompt {
    color: var(--accent);
    margin-right: 6px;
  }
  /* passar o mouse num span do trace destaca só ele (como no genai-lens) */
  .spans:hover > li:not(:hover) {
    opacity: 0.4;
  }
  .spans > li {
    transition: opacity 0.15s;
  }
  .spans {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .span {
    display: grid;
    grid-template-columns: minmax(0, 46%) 1fr 52px;
    gap: 10px;
    align-items: center;
    font-size: 12px;
  }
  .d1 .span-name {
    padding-left: 14px;
  }
  .d2 .span-name {
    padding-left: 28px;
  }
  .span-name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--text);
  }
  .span-name::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    margin-right: 7px;
    background: var(--c);
  }
  .span-track {
    display: block;
    width: 100%;
    height: 10px;
    border-radius: 4px;
    background: var(--bg-soft);
  }
  .span-bar {
    fill: var(--c);
    transform-box: fill-box;
    transform-origin: left center;
  }
  .span-ms {
    text-align: right;
    color: var(--muted);
  }
  /* Trace "ao vivo" (scripts/trace.ts): agulha de tempo, span ativo aceso, ms aparecem quando o span fecha. */
  .trace {
    position: relative;
  }
  .playhead {
    position: absolute;
    top: -6px;
    bottom: -6px;
    left: var(--pl, 0);
    width: 2px;
    border-radius: 2px;
    background: var(--accent-fill);
    box-shadow: 0 0 12px color-mix(in srgb, var(--accent-fill) 70%, transparent);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .running .playhead {
    opacity: 1;
  }
  .span {
    transition: opacity 0.3s;
  }
  .running .span.wait:not(.active) {
    opacity: 0.45;
  }
  .running .span.wait:not(.active) .span-ms,
  .running .span.active .span-ms {
    opacity: 0;
  }
  .span-ms {
    transition: opacity 0.3s;
  }
  .span.active .span-name {
    color: var(--accent);
  }
  .span.active .span-name::before {
    animation: blink 0.8s ease-in-out infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.3;
    }
  }
  .pill-ok {
    transition:
      color 0.3s,
      border-color 0.3s;
    font-variant-numeric: tabular-nums;
  }
  .running .pill-ok {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .replay {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin: -4px -6px -4px 0;
    border-radius: 999px;
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    flex: none;
  }
  .replay:hover {
    color: var(--text);
    background: var(--bg-soft);
  }
  .replay svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .console-foot b {
    font-variant-numeric: tabular-nums;
  }
  .span.run {
    --c: var(--text);
  }
  .span.agent {
    --c: var(--accent2);
  }
  .span.llm {
    --c: var(--accent-fill);
  }
  .span.tool {
    --c: var(--accent3);
  }
  .console-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 18px;
    padding-top: 12px;
    border-top: 1px dashed var(--line);
    font-size: 12px;
    color: var(--muted);
  }
  .console-foot b {
    color: var(--text);
    font-weight: 600;
  }
  .console figcaption {
    padding: 12px 18px 14px;
    font-size: 13px;
    color: var(--muted);
    border-top: 1px solid var(--line);
  }

  .see-all {
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }
  .see-all:hover {
    text-decoration: underline;
  }

  /* O que eu faço: lista em duas colunas, sem cartão */
  .what-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }
  .what {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .what-item {
    display: flex;
    gap: 16px;
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }
  .what-item h3 {
    margin: 0 0 4px;
    font-size: 18px;
  }
  .what-item p {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }
  .what-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    flex: none;
    color: var(--accent);
    background: var(--accent-soft);
  }

  /* Demos em bento */
  .bento {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .demo-main {
    grid-row: span 2;
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }
  .demo-main p {
