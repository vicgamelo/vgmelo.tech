---
import { route, type Lang } from '../i18n/routes';
import { useT } from '../i18n/ui';

interface Props {
  lang: Lang;
  alt: { pt?: string; en?: string };
}
const { lang, alt } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'pt' ? 'en' : 'pt';
const otherHref = alt[other] ?? route('home', other);
const here = Astro.url.pathname;
const items = [
  { href: route('projects', lang), label: t('nav.projects') },
  { href: route('demos', lang), label: t('nav.demos') },
  { href: route('apps', lang), label: t('nav.apps') },
  { href: route('articles', lang), label: t('nav.articles') },
  { href: route('consulting', lang), label: t('nav.consulting') },
  { href: route('about', lang), label: t('nav.about') },
];
const isActive = (href: string) => here.startsWith(href);
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={route('home', lang)} aria-label={t('site.name')}>
      <span class="logo">
        <img src="/victor-112.jpg" width="36" height="36" alt="" decoding="async" />
      </span>
      <span class="who">
        <span class="name">Victor Melo</span>
        <span class="role">{t('site.role')}</span>
      </span>
    </a>
    <nav class="desktop" aria-label={t('nav.main')}>
      {items.map((i) => <a href={i.href} aria-current={isActive(i.href) ? 'page' : undefined}>{i.label}</a>)}
    </nav>
    <div class="right">
      <span class="status" data-status hidden title={t('status.title')}>
        <span class="dot" aria-hidden="true"></span>{t('status.online')}
      </span>
      <a class="lang" href={otherHref} hreflang={other === 'pt' ? 'pt-BR' : 'en'} lang={other === 'pt' ? 'pt-BR' : 'en'} aria-label={t('lang.switchLabel')}>
        {other.toUpperCase()}
      </a>
      <a class="btn primary contact" href={route('contact', lang)}>{t('nav.contact')}</a>
      <details class="mobile">
        <summary aria-label={t('nav.menu')}>
          <svg class="open" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
          <svg class="close" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
        </summary>
        <nav class="sheet" aria-label={t('nav.menu')}>
          <div class="sheet-grid">
            {
              items.map((i) => (
                <a href={i.href} aria-current={isActive(i.href) ? 'page' : undefined}>
                  {i.label}
                </a>
              ))
            }
          </div>
          <a class="btn primary" href={route('contact', lang)}>{t('nav.contact')}</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Selo "no ar": só aparece se o portal responder. Sem resposta, fica escondido.
  const el = document.querySelector<HTMLElement>('[data-status]');
  if (el) {
    fetch('/api/health', { cache: 'no-store' })
      .then((r) => {
        if (r.ok) el.hidden = false;
      })
      .catch(() => undefined);
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 64px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    text-decoration: none;
    flex: none;
  }
  .logo {
    display: grid;
    place-items: center;
    position: relative;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--bg-soft);
    transition: transform 0.35s var(--ease-out);
  }
  /* foto de 112 px desenhada a 36: nítida até 3x */
  .logo img {
    display: block;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 1px var(--line-strong);
  }
  .logo::after {
    content: '';
    position: absolute;
    right: -2px;
    bottom: -2px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent-fill);
    border: 2px solid var(--bg);
  }
  .brand:hover .logo {
    transform: rotate(-6deg);
  }
  .who {
    display: grid;
    line-height: 1.15;
  }
  .name {
    font-weight: 650;
    letter-spacing: -0.01em;
  }
  .role {
    font-size: 12px;
    color: var(--muted);
  }
  nav.desktop {
    display: flex;
    gap: 4px;
  }
  nav.desktop a {
    position: relative;
    color: var(--muted);
    text-decoration: none;
    padding: 8px 12px;
    font-size: 15px;
    font-weight: 500;
    transition: color 0.15s;
  }
  /* Sublinhado que cresce do centro; fica fixo na página atual. */
  nav.desktop a::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 2px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent-fill);
    transform: scaleX(0);
    transition: transform 0.3s var(--ease-out);
  }
  nav.desktop a:hover {
    color: var(--text);
  }
  nav.desktop a:hover::after {
    transform: scaleX(0.4);
  }
  nav.desktop a[aria-current='page'] {
    color: var(--text);
  }
  nav.desktop a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .right {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ok);
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--ok) 35%, transparent);
    background: color-mix(in srgb, var(--ok) 10%, transparent);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 0 currentColor;
    animation: pulse 2.4s 4;
  }
  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 60%, transparent);
    }
    70% {
      box-shadow: 0 0 0 7px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dot {
      animation: none;
    }
  }
  .lang {
    display: grid;
    place-items: center;
    min-width: 40px;
    min-height: 40px;
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--muted);
    text-decoration: none;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 6px 9px;
  }
  .lang:hover {
    color: var(--text);
  }
  .contact {
    min-height: 40px;
    padding: 6px 16px;
    font-size: 14.5px;
    border-radius: 999px;
  }
  .mobile {
    display: none;
  }
  .mobile summary {
    list-style: none;
    cursor: pointer;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--text);
  }
  .mobile summary::-webkit-details-marker {
    display: none;
  }
  .mobile svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .mobile .close,
  .mobile[open] .open {
    display: none;
  }
  .mobile[open] .close {
    display: block;
  }
  /* Menu do celular: folha que cobre a tela, links grandes entrando em sequência. */
  .sheet {
    position: fixed;
    left: 0;
    right: 0;
    top: 64px;
    bottom: 0;
    overflow-y: auto;
    padding: 16px 16px 32px;
    background: var(--bg);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .sheet-grid {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .sheet-grid a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--text);
    text-decoration: none;
    padding: 14px 2px;
    border-bottom: 1px solid var(--line);
    font-family: var(--display);
    font-size: 28px;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  .sheet-grid a::after {
    content: '→';
    font-family: var(--sans);
    font-size: 18px;
    color: var(--muted);
  }
  .sheet-grid a[aria-current='page'] {
    color: var(--accent);
  }
  .sheet-grid a[aria-current='page']::after {
    color: var(--accent);
  }
  .mobile[open] .sheet-grid a {
    animation: sheet-in 0.45s var(--ease-out) both;
  }
  .mobile[open] .sheet-grid a:nth-child(2) {
    animation-delay: 0.03s;
  }
  .mobile[open] .sheet-grid a:nth-child(3) {
    animation-delay: 0.06s;
  }
  .mobile[open] .sheet-grid a:nth-child(4) {
    animation-delay: 0.09s;
  }
  .mobile[open] .sheet-grid a:nth-child(5) {
    animation-delay: 0.12s;
  }
  .mobile[open] .sheet-grid a:nth-child(6) {
    animation-delay: 0.15s;
  }
  @keyframes sheet-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile[open] .sheet-grid a {
      animation: none;
    }
  }
  @media (max-width: 1060px) {
    .role {
      display: none;
    }
  }
  @media (max-width: 920px) {
    nav.desktop,
    .status {
      display: none;
    }
    .mobile {
      display: block;
    }
  }
  @media (max-width: 480px) {
    .contact {
      display: none;
    }
  }
</style>
