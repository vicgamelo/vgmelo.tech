---
// Ícones de traço simples, em SVG inline (nada de fonte de ícones nem script de fora).
export type IconName =
  | 'play'
  | 'github'
  | 'linkedin'
  | 'agents'
  | 'mlops'
  | 'obs'
  | 'data'
  | 'chat'
  | 'plug'
  | 'gauge'
  | 'scan'
  | 'id'
  | 'drift'
  | 'grid'
  | 'pca'
  | 'eye'
  | 'repo'
  | 'arrow';

interface Props {
  name: IconName;
  size?: number;
}
const { name, size = 20 } = Astro.props;

const paths: Record<IconName, string[]> = {
  play: ['M8 5.5v13l11-6.5z'],
  github: [
    'M9 19c-4 1.3-4-2-6-2.5M15 21v-3.5a3 3 0 0 0-.9-2.4c3-.3 6.2-1.5 6.2-6.7A5.2 5.2 0 0 0 19 4.8 4.8 4.8 0 0 0 18.9 1S17.7.7 15 2.5a13.4 13.4 0 0 0-7 0C5.3.7 4.1 1 4.1 1A4.8 4.8 0 0 0 4 4.8 5.2 5.2 0 0 0 2.6 8.4c0 5.2 3.2 6.4 6.2 6.7a3 3 0 0 0-.8 2.4V21',
  ],
  linkedin: ['M4 9h4v11H4zM6 4.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4z', 'M11 9h4v1.6c.6-1 1.8-1.9 3.6-1.9 3 0 3.4 2 3.4 4.6V20h-4v-5.8c0-1.4-.2-2.6-1.7-2.6s-1.8 1.1-1.8 2.5V20h-3.5z'],
  agents: ['M12 3v4M5 21v-3a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v3', 'M7 7h10a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2z', 'M9.5 10h.01M14.5 10h.01'],
  mlops: ['M4 12a8 8 0 0 1 14-5.3L20 9', 'M20 4v5h-5', 'M20 12a8 8 0 0 1-14 5.3L4 15', 'M4 20v-5h5'],
  obs: ['M3 12h4l3-8 4 16 3-8h4'],
  data: ['M12 3c4.4 0 8 1.3 8 3s-3.6 3-8 3-8-1.3-8-3 3.6-3 8-3z', 'M4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6', 'M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6'],
  chat: ['M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z', 'M8.5 12h.01M12 12h.01M15.5 12h.01'],
  plug: ['M9 2v5M15 2v5M6 7h12v4a6 6 0 0 1-12 0zM12 17v5'],
  gauge: ['M4 15a8 8 0 1 1 16 0', 'M12 15l4-5', 'M4 19h16'],
  scan: ['M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3', 'M7 12h10'],
  id: ['M3 6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z', 'M9 10.5a2 2 0 1 1 0 .01M6 16c.6-1.5 1.7-2.2 3-2.2s2.4.7 3 2.2M15 9h3M15 13h3'],
  drift: ['M3 18c3 0 3-10 6-10s3 7 6 7 3-4 6-4', 'M3 21h18'],
  grid: ['M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z'],
  pca: ['M4 20L20 4', 'M8 20L20 8', 'M6.5 9.5h.01M10 14h.01M14 10h.01M16.5 15.5h.01M9 6h.01M18 12h.01'],
  eye: ['M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z', 'M12 9a3 3 0 1 1 0 6 3 3 0 0 1 0-6z'],
  repo: ['M5 4a2 2 0 0 1 2-2h12v16H7a2 2 0 0 0-2 2z', 'M5 20a2 2 0 0 0 2 2h12v-4'],
  arrow: ['M5 12h14M13 6l6 6-6 6'],
};
const filled = name === 'play';
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {paths[name].map((d) => <path d={d} />)}
</svg>
