---
// Aviso de cookies dos anúncios. Recusa é o padrão: nada do Google carrega sem o aceite.
import type { Lang } from '../i18n/routes';
import { useT } from '../i18n/ui';

interface Props {
  lang: Lang;
  client: string;
}
const { lang, client } = Astro.props;
const t = useT(lang);
---

<div class="consent" id="consent" data-client={client} hidden role="dialog" aria-live="polite" aria-label={t('ads.label')}>
  <p>{t('consent.text')}</p>
  <div class="actions">
    <button class="btn primary" type="button" data-choice="yes">{t('consent.accept')}</button>
    <button class="btn" type="button" data-choice="no">{t('consent.reject')}</button>
  </div>
</div>

<script>
  import { loadAds, readConsent, saveConsent } from '../lib/consent';

  const box = document.getElementById('consent');
  if (box) {
    const client = box.dataset.client ?? '';
    const choice = readConsent();
    if (choice === 'yes') loadAds(client);
    else if (choice === null) box.hidden = false;
    box.addEventListener('click', (e) => {
      const value = (e.target as HTMLElement).closest<HTMLElement>('[data-choice]')?.dataset.choice;
      if (value !== 'yes' && value !== 'no') return;
      saveConsent(value);
      box.hidden = true;
      if (value === 'yes') loadAds(client);
    });
  }
</script>

<style>
  .consent {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: 16px;
    max-width: 560px;
    margin: 0 auto;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 16px;
    box-shadow: 0 10px 40px rgb(0 0 0 / 0.2);
    z-index: 20;
  }
  .consent p {
    margin: 0 0 12px;
    font-size: 15px;
  }
</style>
