---
import { articlePath, type Lang } from '../i18n/routes';
import { useT } from '../i18n/ui';
import { formatDate, readingMinutes, type Article } from '../lib/articles';

interface Props {
  lang: Lang;
  articles: Article[];
}
const { lang, articles } = Astro.props;
const t = useT(lang);
---

<ul class="list">
  {
    articles.map((a) => (
      <li>
        <a class="row" href={articlePath(lang, a.data.slug)}>
          <span class="meta muted">
            <time datetime={a.data.date.toISOString()}>{formatDate(a.data.date, lang)}</time> · {readingMinutes(a.body)}{' '}
            {t('articles.readingTime')}
            {a.data.draft && <strong class="draft"> · DRAFT</strong>}
          </span>
          <h3>{a.data.title}</h3>
          <p>{a.data.description}</p>
          <ul class="tags">
            {a.data.tags.map((tag) => (
              <li class="tag">{tag}</li>
            ))}
          </ul>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .row {
    display: grid;
    gap: 6px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
  }
  .row h3 {
    margin: 0;
    font-size: clamp(18px, 2.2vw, 22px);
    transition: color 0.2s;
  }
  .row p {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    max-width: 760px;
  }
  .row:hover h3 {
    color: var(--accent);
  }
  .row .tags {
    margin-top: 4px;
  }
  .meta {
    font-size: 13px;
    font-family: var(--mono);
  }
  .draft {
    color: var(--warn);
  }
</style>
