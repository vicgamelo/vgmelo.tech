---
// Cartões reutilizados nas páginas. `kind` escolhe o formato.
import type { App, Demo, Project } from '../data/site';
import { route, type Lang } from '../i18n/routes';
import { useT } from '../i18n/ui';
import Icon, { type IconName } from './Icon.astro';

type Props =
  | { kind: 'project'; lang: Lang; item: Project; detailed?: boolean }
  | { kind: 'app'; lang: Lang; item: App; detailed?: boolean }
  | { kind: 'demo'; lang: Lang; item: Demo };

const props = Astro.props;
const t = useT(props.lang);
const DEMO_ICON: Record<Demo['key'], IconName> = {
  demoAgents: 'chat',
  demoMcp: 'plug',
  demoCredit: 'gauge',
  demoOcr: 'scan',
  demoCnpj: 'id',
  demoDrift: 'drift',
  demoAttention: 'grid',
  demoPca: 'pca',
};
---

{
  props.kind === 'project' && (
    <article class="card project">
      <header class="repo-head">
        <span class="repo-icon">
          <Icon name="repo" size={16} />
        </span>
        <h3 class="mono">
          <span class="owner">vicgamelo/</span>
          {props.item.name}
        </h3>
      </header>
      <p class={props.detailed ? '' : 'grow'}>{props.item.summary[props.lang]}</p>
      {props.detailed && (
        <ul class="checks grow">
          {props.item.highlights[props.lang].map((h) => (
            <li>{h}</li>
          ))}
        </ul>
      )}
      <ul class="tags">
        {props.item.tags.map((tag) => (
          <li class="tag">{tag}</li>
        ))}
      </ul>
      <div class="links">
        <a href={props.item.repo} rel="noopener">
          {t('projects.repo')}
        </a>
        {props.item.detail && <a href={route(props.item.detail, props.lang)}>{t('projects.details')} →</a>}
        {props.item.demo && <a href={route(props.item.demo, props.lang)}>{t('projects.demo')} →</a>}
      </div>
    </article>
  )
}
{
  props.kind === 'app' && (
    <article class="card app">
      <div class="app-head">
        {props.item.icon ? (
          <img src={props.item.icon} alt="" width="56" height="56" loading="lazy" />
        ) : (
          <span class="glyph" aria-hidden="true">
            {props.item.glyph}
          </span>
        )}
        <div>
          <h3>{props.item.name}</h3>
          <span class="badge">{props.item.status[props.lang]}</span>
        </div>
      </div>
      <p class={props.detailed ? '' : 'grow'}>{props.item.summary[props.lang]}</p>
      {props.detailed && (
        <ul class="checks grow">
          {props.item.features[props.lang].map((f) => (
            <li>{f}</li>
          ))}
        </ul>
      )}
      <div class="links">
        <a href={props.item.url} rel="noopener">
          {t('apps.open')} →
        </a>
      </div>
    </article>
  )
}
{
  props.kind === 'demo' && (
    <a class="card" href={route(props.item.key, props.lang)}>
      <div class="demo-head">
        <span class="demo-icon">
          <Icon name={DEMO_ICON[props.item.key]} />
        </span>
        <span class={props.item.live ? 'badge live' : 'badge muted-badge'}>
          {props.item.live ? t('demos.live') : t('demos.browser')}
        </span>
      </div>
      <h3>{props.item.title[props.lang]}</h3>
      <p class="grow">{props.item.text[props.lang]}</p>
      <span class="mono muted small">{props.item.project}</span>
    </a>
  )
}

<style>
  .project {
    position: relative;
    overflow: hidden;
  }
  .project::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), var(--accent2));
    opacity: 0.8;
  }
  .repo-head {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .repo-head h3 {
    font-size: 16px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .owner {
    color: var(--muted);
    font-weight: 400;
  }
  .repo-icon,
  .demo-icon {
    display: grid;
    place-items: center;
    flex: none;
    border-radius: 9px;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
  }
  .repo-icon {
    width: 30px;
    height: 30px;
  }
  .demo-icon {
    width: 38px;
    height: 38px;
  }
  .demo-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .muted-badge {
    color: var(--muted);
    background: var(--bg-soft);
    border-color: var(--line);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-size: 15px;
    font-weight: 600;
  }
  .links a {
    text-decoration: none;
  }
  .links a:hover {
    text-decoration: underline;
  }
  .app-head {
    display: flex;
    gap: 14px;
    align-items: center;
  }
  .app-head img,
  .glyph {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    flex: none;
  }
  .glyph {
    display: grid;
    place-items: center;
    font-size: 34px;
    background: #1e1b4b;
    color: #fde68a;
  }
  .app-head h3 {
    margin-bottom: 4px;
  }
  .small {
    font-size: 13px;
  }
</style>
